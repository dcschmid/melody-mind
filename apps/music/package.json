{
  "name": "music",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/generate-social-images.mjs && astro dev",
    "dev:background": "astro dev --background",
    "dev:logs": "astro dev logs",
    "dev:status": "astro dev status",
    "dev:stop": "astro dev stop",
    "build": "node scripts/generate-social-images.mjs && astro check && astro build",
    "build:embed": "pnpm build && node scripts/prepare-embed-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "pnpm format && pnpm exec eslint --config ../../eslint.config.mjs --fix \"src/**/*.{js,ts,jsx,tsx,astro}\" \"tests/**/*.ts\" && pnpm stylelint",
    "lint:check": "pnpm exec eslint --config ../../eslint.config.mjs \"src/**/*.{js,ts,jsx,tsx,astro}\" \"tests/**/*.ts\" && pnpm stylelint:check",
    "format": "pnpm exec prettier --write \"src/**/*.{js,ts,jsx,tsx,astro,md,mdx}\" \"tests/**/*.ts\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.{js,ts,jsx,tsx,astro,md,mdx}\" \"tests/**/*.ts\"",
    "stylelint": "pnpm exec stylelint --config ../../stylelint.config.cjs --fix \"src/**/*.{astro,css}\"",
    "stylelint:check": "pnpm exec stylelint --config ../../stylelint.config.cjs \"src/**/*.{astro,css}\" --quiet",
    "test": "vitest run",
    "indexnow:submit": "node ../../scripts/submit-indexnow.mjs",
    "update:audio-metadata": "node scripts/update-audio-metadata.mjs",
    "test:browser": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/tabler": "^1.2.39",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "astro-minify-html-swc": "^0.1.12",
    "lightningcss": "^1.33.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@playwright/test": "^1.63.0",
    "js-yaml": "^5.4.2",
    "music-metadata": "^11.15.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
