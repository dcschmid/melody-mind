---
import MasterLayout from "@components/layout/MasterLayout.astro";
import GlobalPlayer from "@components/music/player/GlobalPlayer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props as Props;
---

<MasterLayout
  lang="en"
  bodyClass="visuals-layout"
  mainClass="visuals-layout__main"
  contentShellClass="visuals-layout__shell"
  mainId="visuals-main"
  showSkipLink={true}
  appTitle="MM Visuals"
  manifestPath="/site.webmanifest?v=20260721-2"
  faviconVersion="20260507"
>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <meta name="googlebot" content="noindex,follow" />
    <link rel="preconnect" href="https://eu2.contabostorage.com" crossorigin />
    <link rel="dns-prefetch" href="https://eu2.contabostorage.com" />
  </Fragment>

  <GlobalPlayer slot="body-end" />
  <slot />
</MasterLayout>

<style>
  :global(.visuals-layout) {
    min-block-size: 100svh;
    padding: 0 !important;
    overflow: hidden;
    background: var(--bg-primary);
  }

  :global(.visuals-layout__shell),
  :global(.visuals-layout__main) {
    min-block-size: 100svh;
  }

  :global(.visuals-layout .global-player) {
    display: none;
  }
</style>
