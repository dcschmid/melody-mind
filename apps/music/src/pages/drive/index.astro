---
import Icon from "@components/visual/Icon.astro";
import ImmersivePlayerLayout from "../../layouts/ImmersivePlayerLayout.astro";
---

<ImmersivePlayerLayout
  title="Drive | MelodyMind Music"
  description="A simplified MelodyMind web player for travel."
  appTitle="MM Drive"
  mainId="drive-main"
  bodyClass="drive-layout"
>
  <section
    class="drive"
    data-drive
    data-playing="false"
    data-player-state="idle"
    aria-label="MelodyMind Drive"
  >
    <header class="drive__header">
      <a class="drive__utility drive__exit" href="/" data-drive-exit>
        <Icon name="tabler:arrow-left" aria-hidden="true" />
        <span>Exit Drive</span>
      </a>

      <p class="drive__identity">
        <Icon name="tabler:steering-wheel" aria-hidden="true" />
        <span>Drive view</span>
      </p>

      <button
        class="drive__utility drive__announcements"
        type="button"
        data-drive-announcements
        aria-label="Turn voice announcements on"
        aria-pressed="false"
      >
        <Icon name="tabler:volume" aria-hidden="true" />
        <span data-drive-announcements-label>Voice off</span>
      </button>
    </header>

    <div class="drive__layout">
      <figure class="drive__artwork-frame" data-drive-artwork-frame data-empty="true">
        <img
          class="drive__artwork"
          data-drive-artwork
          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
          width="720"
          height="720"
          alt=""
          hidden
        />
        <div class="drive__artwork-placeholder" data-drive-artwork-placeholder>
          <Icon name="tabler:music" aria-hidden="true" />
        </div>
      </figure>

      <section class="drive__player" aria-labelledby="drive-track-title">
        <div class="drive__metadata" aria-live="polite" aria-atomic="true">
          <p class="drive__context" data-drive-context>Waiting for a queue</p>
          <h1 id="drive-track-title" class="drive__track" data-drive-track>
            Nothing queued
          </h1>
          <p class="drive__album" data-drive-album>
            Choose your music before setting off.
          </p>
        </div>

        <section
          class="drive__state"
          data-drive-state
          aria-labelledby="drive-state-title"
        >
          <p class="drive__state-eyebrow" data-drive-state-eyebrow>Drive</p>
          <h2 id="drive-state-title" class="drive__state-title" data-drive-state-title>
            Nothing queued
          </h2>
          <p class="drive__state-detail" data-drive-state-detail>
            Choose an album or series before setting off.
          </p>
          <button class="drive__state-action" type="button" data-drive-state-action hidden
          ></button>
          <a class="drive__state-action" href="/" data-drive-state-link>Browse music</a>
        </section>

        <div class="drive__progress">
          <div class="drive__time-row" aria-hidden="true">
            <span data-drive-current>0:00</span>
            <span data-drive-remaining>-0:00</span>
          </div>
          <label class="sr-only" for="drive-progress">Track progress</label>
          <progress
            id="drive-progress"
            class="drive__progress-bar"
            data-drive-progress
            max="1"
            value="0"
            aria-valuetext="0:00 elapsed, 0:00 remaining"></progress>
        </div>

        <div class="drive__transport" aria-label="Playback controls">
          <button
            class="drive__transport-button"
            type="button"
            data-drive-command="previous"
            aria-label="Previous track"
            disabled
          >
            <Icon name="tabler:player-skip-back-filled" aria-hidden="true" />
          </button>
          <button
            class="drive__transport-button drive__transport-button--primary"
            type="button"
            data-drive-command="toggle"
            aria-label="Play"
            aria-pressed="false"
            disabled
          >
            <Icon
              name="tabler:player-play-filled"
              class="drive__play-icon drive__play-icon--play"
              aria-hidden="true"
            />
            <Icon
              name="tabler:player-pause-filled"
              class="drive__play-icon drive__play-icon--pause"
              aria-hidden="true"
            />
          </button>
          <button
            class="drive__transport-button"
            type="button"
            data-drive-command="next"
            aria-label="Next track"
            disabled
          >
            <Icon name="tabler:player-skip-forward-filled" aria-hidden="true" />
          </button>
        </div>
      </section>
    </div>

    <p class="sr-only" data-drive-status aria-live="polite" aria-atomic="true"></p>
  </section>

  <script>
    import "../../scripts/music/drive";
  </script>
</ImmersivePlayerLayout>

<style>
  .drive {
    --drive-safe-inline: max(env(safe-area-inset-left), 1rem);
    --drive-safe-block: max(env(safe-area-inset-top), 0.75rem);

    box-sizing: border-box;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-block-size: 100svh;
    padding: var(--drive-safe-block) var(--drive-safe-inline)
      max(env(safe-area-inset-bottom), 1rem);
    color: var(--text-primary);
    background: var(--bg-primary);
  }

  .drive__header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-sm);
    align-items: center;
    min-block-size: 4rem;
  }

  .drive__utility {
    display: inline-flex;
    gap: var(--spacing-xs);
    align-items: center;
    justify-content: center;
    min-block-size: 3.5rem;
    padding: 0 var(--spacing-base);
    font: inherit;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-base);
  }

  .drive__utility:hover,
  .drive__utility:focus-visible,
  .drive__utility[aria-pressed="true"] {
    color: var(--accent-primary);
    border-color: var(--accent-muted);
  }

  .drive__utility:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .drive__exit {
    justify-self: start;
  }

  .drive__announcements {
    justify-self: end;
  }

  .drive__announcements:disabled {
    color: var(--text-muted);
    cursor: not-allowed;
    opacity: 0.72;
  }

  .drive__identity {
    display: inline-flex;
    gap: var(--spacing-xs);
    align-items: center;
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--text-secondary);
  }

  .drive__utility :global(svg),
  .drive__identity :global(svg) {
    flex: 0 0 auto;
    inline-size: 1.4rem;
    block-size: 1.4rem;
  }

  .drive__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: center;
    inline-size: min(100%, 78rem);
    min-block-size: 0;
    padding-block: clamp(0.5rem, 2vh, 1.5rem);
    margin-inline: auto;
  }

  .drive__artwork-frame {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: min(48vw, 13rem);
    aspect-ratio: 1;
    margin: 0 auto;
    overflow: hidden;
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
  }

  .drive__artwork {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .drive__artwork-placeholder {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    color: var(--text-muted);
  }

  .drive__artwork-placeholder :global(svg) {
    inline-size: 3rem;
    block-size: 3rem;
  }

  .drive__artwork-frame[data-empty="false"] .drive__artwork-placeholder {
    display: none;
  }

  .drive:not([data-player-state="playing"], [data-player-state="paused"])
    .drive__artwork-frame {
    display: none;
  }

  .drive:not([data-player-state="playing"], [data-player-state="paused"]) .drive__layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .drive__player {
    display: grid;
    gap: clamp(0.75rem, 2vh, 1.5rem);
    align-content: center;
    min-inline-size: 0;
  }

  .drive__metadata,
  .drive__state {
    text-align: center;
  }

  .drive:not([data-player-state="playing"], [data-player-state="paused"]) .drive__player {
    inline-size: min(100%, 44rem);
    margin-inline: auto;
  }

  .drive:not([data-player-state="playing"], [data-player-state="paused"])
    .drive__metadata {
    display: none;
  }

  .drive__context,
  .drive__track,
  .drive__album,
  .drive__state-eyebrow,
  .drive__state-title,
  .drive__state-detail {
    margin: 0;
  }

  .drive__context,
  .drive__state-eyebrow {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--accent-primary);
  }

  .drive__track {
    margin-block-start: var(--spacing-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 2.25rem;
    line-height: 1.05;
    white-space: nowrap;
  }

  .drive__album {
    margin-block-start: var(--spacing-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .drive__state {
    display: grid;
    gap: var(--spacing-xs);
    justify-items: center;
    padding: var(--spacing-base);
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-base);
  }

  .drive__state[hidden] {
    display: none;
  }

  .drive__state-title {
    font-size: var(--font-size-xl);
    line-height: 1.15;
  }

  .drive__state-detail {
    max-inline-size: 44ch;
    color: var(--text-secondary);
  }

  .drive__state-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 4rem;
    padding-inline: var(--spacing-lg);
    margin-block-start: var(--spacing-sm);
    font: inherit;
    font-weight: var(--font-weight-bold);
    color: var(--button-text-accent);
    text-decoration: none;
    cursor: pointer;
    background: var(--accent-primary);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
  }

  .drive__state-action:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .drive__state-action[hidden] {
    display: none;
  }

  .drive__state-action:hover,
  .drive__state-action:focus-visible {
    background: var(--accent-strong);
  }

  .drive__progress {
    display: grid;
    gap: var(--spacing-xs);
  }

  .drive__time-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }

  .drive__progress-bar {
    inline-size: 100%;
    block-size: 1.1rem;
    overflow: hidden;
    accent-color: var(--accent-primary);
    background: var(--surface-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
  }

  .drive__progress-bar::-webkit-progress-bar {
    background: var(--surface-2);
    border-radius: var(--radius-full);
  }

  .drive__progress-bar::-webkit-progress-value {
    background: var(--accent-primary);
    border-radius: var(--radius-full);
  }

  .drive__progress-bar::-moz-progress-bar {
    background: var(--accent-primary);
    border-radius: var(--radius-full);
  }

  .drive__transport {
    display: grid;
    grid-template-columns: 4.75rem 6rem 4.75rem;
    gap: clamp(1rem, 5vw, 2.25rem);
    align-items: center;
    justify-content: center;
  }

  .drive__transport-button {
    display: grid;
    place-items: center;
    inline-size: 4.75rem;
    block-size: 4.75rem;
    padding: 0;
    color: var(--text-primary);
    cursor: pointer;
    background: var(--surface-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-control);
  }

  .drive__transport-button:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .drive__transport-button--primary {
    inline-size: 6rem;
    block-size: 6rem;
    color: var(--button-text-accent);
    background: var(--accent-primary);
    border-color: transparent;
  }

  .drive__transport-button:hover,
  .drive__transport-button:focus-visible {
    color: var(--accent-primary);
    border-color: var(--accent-muted);
  }

  .drive__transport-button--primary:hover,
  .drive__transport-button--primary:focus-visible {
    color: var(--button-text-accent);
    background: var(--accent-strong);
  }

  .drive__transport-button:active {
    transform: scale(0.96);
  }

  .drive__transport-button:disabled {
    color: var(--text-muted);
    cursor: not-allowed;
    box-shadow: none;
    opacity: 0.54;
  }

  .drive__transport-button :global(svg) {
    inline-size: 2rem;
    block-size: 2rem;
  }

  .drive__transport-button--primary :global(svg) {
    inline-size: 2.5rem;
    block-size: 2.5rem;
  }

  .drive__play-icon--pause,
  .drive[data-playing="true"] .drive__play-icon--play {
    display: none;
  }

  .drive[data-playing="true"] .drive__play-icon--pause {
    display: block;
  }

  @media (width >= 640px) and (orientation: landscape) {
    .drive__layout {
      grid-template-columns: minmax(12rem, 0.75fr) minmax(22rem, 1.25fr);
    }

    .drive__artwork-frame {
      inline-size: min(36vw, 24rem, 64vh);
    }

    .drive__metadata,
    .drive__state {
      text-align: start;
    }

    .drive__track {
      font-size: 2.5rem;
    }

    .drive__state {
      justify-items: start;
    }
  }

  @media (width <= 560px) {
    .drive__header {
      grid-template-columns: 1fr 1fr;
    }

    .drive__identity {
      display: none;
    }

    .drive__utility span {
      font-size: var(--font-size-xs);
    }

    .drive__track {
      font-size: 1.75rem;
    }

    .drive__album {
      font-size: 1rem;
    }

    .drive__transport {
      grid-template-columns: 4rem 5.5rem 4rem;
      gap: 0.75rem;
    }

    .drive__transport-button {
      inline-size: 4rem;
      block-size: 4rem;
    }

    .drive__transport-button--primary {
      inline-size: 5.5rem;
      block-size: 5.5rem;
    }
  }

  @media (height <= 500px) and (orientation: landscape) {
    .drive__header {
      min-block-size: 3.5rem;
    }

    .drive__utility {
      min-block-size: 3.25rem;
    }

    .drive__layout {
      gap: 1.25rem;
      padding-block: 0.25rem;
    }

    .drive__player {
      gap: 0.25rem;
    }

    .drive__state {
      padding: 0.75rem;
    }

    .drive__state-detail {
      display: none;
    }

    .drive__track {
      font-size: 1.75rem;
    }

    .drive__transport-button {
      inline-size: 4rem;
      block-size: 4rem;
    }

    .drive__transport-button--primary {
      inline-size: 5rem;
      block-size: 5rem;
    }

    .drive__transport {
      grid-template-columns: 4rem 5rem 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drive__transport-button:active {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .drive__progress-bar,
    .drive__state,
    .drive__utility,
    .drive__transport-button {
      border-color: CanvasText;
    }
  }
</style>
