---
import Layout from "@layouts/Layout.astro";
import { resolvePageUrl } from "@utils/siteUrls";

const canonical = resolvePageUrl(Astro.site, "/favorites/");
const title = "Favorites";
const description =
  "Your saved MelodyMind concept albums. Favorites are stored locally in your browser — no account needed.";
const breadcrumbs = [
  { name: "Home", url: resolvePageUrl(Astro.site, "/") },
  { name: title, url: canonical },
];
---

<Layout
  title={`${title} | MelodyMind Music`}
  {description}
  keywords={["favorite albums", "saved albums", "concept albums", "melodymind"]}
  type="website"
  {canonical}
  {breadcrumbs}
  contentShellClass="music-layout__container--favorites"
>
  <div class="favorites-page">
    <header class="favorites-page__hero">
      <p class="favorites-page__eyebrow">Your collection</p>
      <h1 class="favorites-page__title">Favorites</h1>
      <p class="favorites-page__description">
        Albums you saved with the heart button. Favorites stay in this browser — no
        account, no tracking.
      </p>
      <p class="favorites-page__status" role="status" data-favorites-status hidden></p>
    </header>

    <div data-favorites-root>
      <noscript>
        <p class="favorites-page__noscript">
          Favorites are stored locally in your browser, so this page needs JavaScript to
          show them.
        </p>
      </noscript>

      <p class="favorites-page__loading" data-favorites-loading hidden>
        Loading favorites…
      </p>

      <ul class="favorites-page__list" data-favorites-list></ul>

      <div class="favorites-page__empty" data-favorites-empty hidden>
        <p class="favorites-page__empty-title">No favorites yet</p>
        <p class="favorites-page__empty-copy">
          Open any album and press the heart to save it here. Favorites are stored locally
          in your browser.
        </p>
        <a class="favorites-page__empty-link" href="/genre/">Browse albums by genre</a>
      </div>

      <p class="favorites-page__error" data-favorites-error hidden>
        Favorites could not be loaded. Try reloading the page.
      </p>
    </div>
  </div>
</Layout>

<script>
  import "../scripts/music/favorites-page";
</script>

<style>
  :global(.music-layout__container.music-layout__container--favorites) {
    inline-size: 100%;
    max-inline-size: none;
    padding: 0;
    margin: 0;
    overflow-x: clip;
  }

  .favorites-page {
    box-sizing: border-box;
    display: grid;
    gap: var(--spacing-2xl);
    inline-size: min(100%, 90rem);
    min-block-size: 100svh;
    padding: max(clamp(var(--spacing-xl), 5vw, var(--spacing-4xl)), 6rem)
      clamp(1rem, 4vw, 4rem) clamp(var(--spacing-3xl), 7vw, 6rem);
    margin-inline: auto;
  }

  .favorites-page__hero {
    display: grid;
    gap: var(--spacing-base);
    max-inline-size: 72ch;
    padding-block-end: var(--spacing-xl);
    border-block-end: 1px solid var(--border-default);
  }

  .favorites-page__eyebrow,
  .favorites-page__title,
  .favorites-page__description,
  .favorites-page__status,
  .favorites-page__loading,
  .favorites-page__error,
  .favorites-page__noscript {
    margin: 0;
  }

  .favorites-page__eyebrow {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
  }

  .favorites-page__title {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--text-primary);
  }

  .favorites-page__description {
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .favorites-page__status,
  .favorites-page__loading,
  .favorites-page__error,
  .favorites-page__noscript {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--text-tertiary);
  }

  .favorites-page__error {
    color: var(--text-secondary);
  }

  .favorites-page__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--spacing-lg), 2vw, var(--spacing-xl));
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .favorites-page__list:empty {
    display: none;
  }

  .favorites-page :global(.favorites-page__item),
  .favorites-page :global(.favorites-page__album),
  .favorites-page :global(.favorites-page__copy) {
    min-inline-size: 0;
  }

  .favorites-page :global(.favorites-page__album) {
    display: grid;
    gap: var(--spacing-md);
  }

  .favorites-page :global(.favorites-page__cover-link) {
    display: block;
    overflow: hidden;
    background: var(--surface-1);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-base);
  }

  .favorites-page :global(.favorites-page__cover) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .favorites-page :global(.favorites-page__copy) {
    display: grid;
    gap: var(--spacing-sm);
  }

  .favorites-page :global(.favorites-page__card-title) {
    display: -webkit-box;
    min-block-size: 2.3em;
    margin: 0;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: var(--font-size-base);
    line-height: 1.2;
    text-wrap: pretty;
  }

  .favorites-page :global(.favorites-page__card-title a) {
    color: var(--text-primary);
    text-decoration: none;
  }

  .favorites-page :global(.favorites-page__footer) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--spacing-md);
    align-items: center;
  }

  .favorites-page :global(.favorites-page__meta) {
    display: grid;
    gap: var(--spacing-xs);
    min-inline-size: 0;
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    line-height: 1.35;
    color: var(--text-tertiary);
  }

  .favorites-page :global(.favorites-page__meta span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .favorites-page :global(.favorites-page__play),
  .favorites-page :global(.favorites-page__favorite) {
    display: grid;
    place-items: center;
    inline-size: var(--control-min-block-size);
    block-size: var(--control-min-block-size);
    padding: 0;
    cursor: pointer;
    border-radius: var(--radius-full);
  }

  .favorites-page :global(.favorites-page__play) {
    color: var(--button-text-accent);
    background: var(--accent-primary);
    border: 1px solid transparent;
  }

  .favorites-page :global(.favorites-page__play:hover),
  .favorites-page :global(.favorites-page__play:focus-visible) {
    background: var(--accent-strong);
  }

  .favorites-page :global(.favorites-page__play[aria-busy="true"]) {
    cursor: wait;
    opacity: 0.68;
  }

  .favorites-page :global(.favorites-page__play-icon) {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .favorites-page :global(.favorites-page__favorite) {
    color: var(--accent-primary);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--accent-primary) 45%, transparent);
  }

  .favorites-page :global(.favorites-page__favorite:hover),
  .favorites-page :global(.favorites-page__favorite:focus-visible) {
    color: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .favorites-page :global(.favorites-page__favorite-icon) {
    inline-size: 1.05rem;
    block-size: 1.05rem;
  }

  .favorites-page :global(.favorites-page__cover-link:hover),
  .favorites-page :global(.favorites-page__cover-link:focus-visible) {
    border-color: var(--accent-primary);
  }

  .favorites-page :global(.favorites-page__card-title a:hover),
  .favorites-page :global(.favorites-page__card-title a:focus-visible) {
    color: var(--accent-primary);
  }

  .favorites-page__empty {
    display: grid;
    gap: var(--spacing-sm);
    justify-items: start;
    max-inline-size: 34rem;
    padding: var(--spacing-xl);
    border: 1px dashed var(--border-default);
    border-radius: var(--radius-md);
  }

  .favorites-page__empty[hidden] {
    display: none;
  }

  .favorites-page__empty-title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .favorites-page__empty-copy {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .favorites-page__empty-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-min-block-size);
    padding-inline: var(--spacing-sm);
    margin-inline-start: calc(-1 * var(--spacing-sm));
    font-weight: var(--font-weight-bold);
    color: var(--accent-primary);
    border-radius: var(--radius-base);
  }

  .favorites-page__empty-link:hover,
  .favorites-page__empty-link:focus-visible {
    color: var(--accent-strong);
  }

  .favorites-page__empty-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .favorites-page :global(.favorites-page__cover-link),
    .favorites-page :global(.favorites-page__cover),
    .favorites-page :global(.favorites-page__play),
    .favorites-page :global(.favorites-page__favorite),
    .favorites-page :global(.favorites-page__card-title a) {
      transition:
        color var(--motion-duration-fast) var(--motion-ease-standard),
        background-color var(--motion-duration-fast) var(--motion-ease-standard),
        border-color var(--motion-duration-fast) var(--motion-ease-standard),
        transform var(--motion-duration-fast) var(--motion-ease-standard);
    }

    .favorites-page :global(.favorites-page__cover-link:hover .favorites-page__cover),
    .favorites-page
      :global(.favorites-page__cover-link:focus-visible .favorites-page__cover) {
      transform: scale(1.02);
    }
  }

  @media (width >= 641px) {
    .favorites-page__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (width >= 1024px) {
    .favorites-page__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (width <= 420px) {
    .favorites-page {
      gap: var(--spacing-xl);
      padding: 5.35rem 1rem clamp(var(--spacing-2xl), 6vw, var(--spacing-4xl));
    }

    .favorites-page__list {
      gap: var(--spacing-base) var(--spacing-sm);
    }

    .favorites-page :global(.favorites-page__meta) {
      font-size: 1rem;
    }
  }
</style>
