---
import AlbumArchive from "@components/music/discovery/AlbumArchive.astro";
import {
  ALBUM_ARCHIVE_PAGE_SIZE,
  getAlbumArchiveItems,
  getAlbumArchivePageHref,
} from "../../utils/albumArchive";

const allItems = await getAlbumArchiveItems();
const items = allItems.slice(0, ALBUM_ARCHIVE_PAGE_SIZE);
const total = allItems.length;
const lastPage = Math.max(1, Math.ceil(total / ALBUM_ARCHIVE_PAGE_SIZE));
const paginationUrls = lastPage > 1 ? { nextUrl: getAlbumArchivePageHref(2) } : {};
---

<AlbumArchive
  {items}
  currentPage={1}
  {lastPage}
  start={items.length > 0 ? 1 : 0}
  end={items.length}
  {total}
  {...paginationUrls}
/>
