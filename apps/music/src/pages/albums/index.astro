---
import ContentCard from "@components/cards/ContentCard.astro";
import AlbumGridFilter from "@components/music/discovery/AlbumGridFilter.astro";
import Icon from "@components/visual/Icon.astro";
import { buildCollectionPageSchema } from "@utils/seo/seoSchema";
import { resolvePageUrl } from "@utils/siteUrls";

import Layout from "../../layouts/Layout.astro";
import { getDiscoveryDirectoryData } from "../../utils/discoveryDirectories";
import {
  getAlbumCoverImageUrl,
  musicDefaultSocialImageUrl,
} from "../../utils/musicImages";
import { buildMusicAlbumListSchema } from "../../utils/musicSeo";

const { albums, albumEntries, seriesDirectories } = await getDiscoveryDirectoryData();
const albumDataById = new Map(albums.map((album) => [album.id, album]));
const seriesTitlesByAlbumId = new Map<string, string[]>();

seriesDirectories.forEach((series) => {
  series.albumIds.forEach((albumId) => {
    const titles = seriesTitlesByAlbumId.get(albumId) || [];
    titles.push(series.title);
    seriesTitlesByAlbumId.set(albumId, titles);
  });
});

const titleCollator = new Intl.Collator("en", { numeric: true, sensitivity: "base" });
const albumCards = [...albumEntries]
  .sort((a, b) => titleCollator.compare(a.title, b.title))
  .map((album) => {
    const data = albumDataById.get(album.id);
    const seriesTitles = seriesTitlesByAlbumId.get(album.id) || [];
    return {
      ...album,
      seriesTitles,
      searchText: [
        album.title,
        album.genre || "",
        album.mainGenre || "",
        ...(data?.moods || []),
        ...(data?.tags || []),
        ...seriesTitles,
      ]
        .filter(Boolean)
        .join(" "),
    };
  });

const canonical = resolvePageUrl(Astro.site, "/albums/");
const description =
  "Browse every MelodyMind concept album in one alphabetical archive, with instant filtering by title, genre, mood, or album series.";
const pageImage = albumCards[0]
  ? `/og/${albumCards[0].id}.jpg`
  : musicDefaultSocialImageUrl;
const breadcrumbs = [
  { name: "Home", url: resolvePageUrl(Astro.site, "/") },
  { name: "Albums", url: canonical },
];
const structuredData = [
  buildCollectionPageSchema({
    url: canonical,
    name: "All Albums",
    description,
    lang: "en",
    image: pageImage,
    mainEntityId: `${canonical}#album-list`,
  }),
  buildMusicAlbumListSchema({
    albums,
    canonical,
    description,
    name: "All MelodyMind albums",
    site: Astro.site,
    getCoverImageUrl: getAlbumCoverImageUrl,
  }),
];
const GRID_COVER_IMAGE_SIZES =
  "(max-width: 520px) calc(100vw - 2rem), (max-width: 760px) 44vw, (max-width: 1180px) 28vw, min(18rem, calc((100vw - 10rem) / 4))";
---

<Layout
  title="All Albums | MelodyMind Music"
  {description}
  keywords={["MelodyMind albums", "AI-assisted music", "concept albums", "album archive"]}
  type="website"
  image={pageImage}
  imageWidth={1200}
  imageHeight={630}
  imageType="image/jpeg"
  language="en"
  locale="en-US"
  canonical={canonical}
  {breadcrumbs}
  {structuredData}
>
  <main class="album-archive" aria-labelledby="album-archive-title">
    <header class="album-archive__header">
      <a class="album-archive__back" href="/">
        <Icon name="arrow-left" aria-hidden="true" />
        <span>Home</span>
      </a>
      <h1 id="album-archive-title" class="album-archive__title">All albums</h1>
      <p class="album-archive__intro">{description}</p>
      <p class="album-archive__count">
        <Icon name="disc" aria-hidden="true" />
        {`${albumCards.length} ${albumCards.length === 1 ? "album" : "albums"}, A–Z`}
      </p>
    </header>

    <AlbumGridFilter
      albumCount={albumCards.length}
      label="Filter all albums"
      inputId="all-albums-filter"
      placeholder="Title, genre, mood, or series"
      threshold={1}
    >
      <ul class="album-archive__grid" id="album-list" aria-label="All MelodyMind albums">
        {
          albumCards.map((album) => (
            <li
              class="album-archive__item"
              data-album-filter-item
              data-album-filter-text={album.searchText}
            >
              <ContentCard
                id={`album-archive-card-${album.id}`}
                class="album-archive__card"
                href={`/${album.id}/`}
                dataTestId="album-archive-card"
                variant="default"
                size="compact"
                mediaAspectRatio="1 / 1"
                mediaObjectFit="cover"
                imageSrc={album.imageSrc}
                imageAlt={`Cover art for the album ${album.title}`}
                imageWidth={640}
                imageHeight={640}
                imageSizes={GRID_COVER_IMAGE_SIZES}
                imageWidths={[240, 360, 480, 640]}
                imageFormats={["avif"]}
                title={album.title}
                description={album.description}
                metaItems={[
                  ...(album.genre
                    ? [{ iconName: "disc" as const, label: album.genre }]
                    : []),
                  { iconName: "music" as const, label: `${album.trackCount} tracks` },
                  ...(album.seriesTitles[0]
                    ? [{ iconName: "book-open" as const, label: album.seriesTitles[0] }]
                    : []),
                ]}
                ctaSrText={`Open album ${album.title}`}
              />
            </li>
          ))
        }
      </ul>
    </AlbumGridFilter>
  </main>
</Layout>

<style>
  .album-archive {
    --album-archive-ink: var(--text-primary);
    --album-archive-muted: var(--text-secondary);
    --album-archive-line: var(--border-default);

    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    inline-size: 100%;
    padding-block: clamp(2rem, 5vw, 5rem);
  }

  .album-archive__header {
    display: grid;
    gap: clamp(0.8rem, 1.5vw, 1.25rem);
    max-inline-size: 72ch;
    padding-block-end: clamp(1.5rem, 3vw, 2.5rem);
    border-block-end: 1px solid var(--album-archive-line);
  }

  .album-archive__back {
    display: inline-flex;
    gap: var(--spacing-xs);
    align-items: center;
    inline-size: fit-content;
    min-block-size: var(--control-min-block-size);
    padding-inline: var(--spacing-xs);
    margin-inline-start: calc(-1 * var(--spacing-xs));
    font-weight: var(--font-weight-bold);
    color: var(--album-archive-muted);
    text-decoration: none;
    border-radius: var(--radius-base);
  }

  .album-archive__back:hover,
  .album-archive__back:focus-visible {
    color: var(--accent-primary);
  }

  .album-archive__back:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .album-archive__back :global(svg),
  .album-archive__count :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .album-archive__title {
    max-inline-size: 16ch;
    margin: 0;
    font-size: clamp(2.4rem, 1.9rem + 2.4vw, 4.25rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .album-archive__intro {
    max-inline-size: 66ch;
    margin: 0;
    font-size: var(--font-size-md);
    line-height: 1.62;
    color: var(--album-archive-muted);
    text-wrap: pretty;
  }

  .album-archive__count {
    display: inline-flex;
    gap: var(--spacing-xs);
    align-items: center;
    inline-size: fit-content;
    margin: 0;
    font-weight: var(--font-weight-bold);
    color: var(--album-archive-ink);
  }

  .album-archive__count :global(svg) {
    color: var(--accent-primary);
  }

  .album-archive__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.4rem);
    align-items: stretch;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .album-archive__item {
    display: grid;
    min-inline-size: 0;
    contain-intrinsic-size: auto 26rem;
    content-visibility: auto;
  }

  .album-archive__card {
    block-size: 100%;
  }

  @media (width <= 760px) {
    .album-archive {
      padding-inline: 0;
    }

    .album-archive__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width <= 520px) {
    .album-archive__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
