---
interface Props {
  compact?: boolean;
  detailsHref: string;
  detail?: string;
  label: string;
  variant: "generated" | "assisted";
}

const { compact = false, detailsHref, detail, label, variant } = Astro.props;
const iconSrc = variant === "generated" ? "/ai-generated-eu.svg" : "/ai-eu.svg";
---

<a
  class:list={["ai-disclosure", compact && "ai-disclosure--compact"]}
  data-ai-disclosure={variant}
  href={detailsHref}
  aria-label={`${label}. Read AI transparency details.`}
>
  <img src={iconSrc} width="34" height="34" alt="" aria-hidden="true" />
  <span class="ai-disclosure__copy">
    <strong>{label}</strong>
    {detail && <span>{detail}</span>}
  </span>
</a>

<style>
  .ai-disclosure {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    inline-size: fit-content;
    max-inline-size: 100%;
    min-block-size: 2.75rem;
    padding: 0.42rem 0.7rem 0.42rem 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
    background: color-mix(in oklch, var(--surface-2) 82%, transparent);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
  }

  .ai-disclosure:hover,
  .ai-disclosure:focus-visible {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .ai-disclosure img {
    flex: 0 0 auto;
    inline-size: 2rem;
    block-size: 2rem;
  }

  .ai-disclosure__copy {
    display: grid;
    gap: 0.05rem;
    min-inline-size: 0;
    font-size: var(--font-size-xs);
    line-height: 1.35;
  }

  .ai-disclosure__copy strong {
    font-size: inherit;
    font-weight: var(--font-weight-bold);
  }

  .ai-disclosure__copy span {
    color: var(--text-secondary);
  }

  .ai-disclosure--compact {
    gap: 0.45rem;
    min-block-size: 2rem;
    padding: 0.28rem 0.55rem 0.28rem 0.4rem;
    border-radius: var(--radius-base);
  }

  .ai-disclosure--compact img {
    inline-size: 1.2rem;
    block-size: 1.2rem;
  }

  .ai-disclosure--compact .ai-disclosure__copy {
    font-size: 0.72rem;
  }

  @media (forced-colors: active) {
    .ai-disclosure {
      border-color: ButtonText;
    }
  }
</style>
