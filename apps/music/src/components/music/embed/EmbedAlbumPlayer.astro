---
import Icon from "@components/visual/Icon.astro";
import type { Song } from "../../../types/album";

interface AlbumProps {
  albumId: string;
  albumTitle: string;
  albumUrl: string;
  artworkUrl: string;
  songs: Song[];
  series?: never;
}

interface SeriesTrack {
  album: {
    id: string;
    title: string;
    url: string;
    artworkUrl: string;
  };
  audioUrl: string;
  durationSeconds?: number;
  partNumber: number;
  title: string;
  trackNumber: number;
}

interface EmbedTrack {
  album?: SeriesTrack["album"];
  artworkUrl: string;
  audioUrl: string;
  durationSeconds?: number;
  partNumber?: number;
  title: string;
  trackNumber: number;
}

interface SeriesProps {
  albumId?: never;
  albumTitle?: never;
  albumUrl?: never;
  artworkUrl?: never;
  series: {
    id: string;
    title: string;
    url: string;
    tracks: SeriesTrack[];
  };
  songs?: never;
}

type Props = AlbumProps | SeriesProps;

const props = Astro.props as Props;
const isSeries = Boolean(props.series);
const entityKind = isSeries ? "series" : "album";
const entityId = props.series?.id || props.albumId;
const entityTitle = props.series?.title || props.albumTitle;
const entityUrl = props.series?.url || props.albumUrl;
const tracks: EmbedTrack[] = props.series
  ? props.series.tracks.map((track) => ({
      album: track.album,
      artworkUrl: track.album.artworkUrl,
      audioUrl: track.audioUrl,
      ...(track.durationSeconds ? { durationSeconds: track.durationSeconds } : {}),
      partNumber: track.partNumber,
      title: track.title,
      trackNumber: track.trackNumber,
    }))
  : props.songs.map((song) => ({
      artworkUrl: props.artworkUrl,
      audioUrl: song.audioUrl,
      ...(song.durationSeconds ? { durationSeconds: song.durationSeconds } : {}),
      title: song.title,
      trackNumber: song.trackNumber,
    }));
const firstTrack = tracks[0];
const playerId = `embed-${entityKind}-player-${entityId}`;
const titleId = `${playerId}-title`;
const statusId = `${playerId}-status`;
const errorId = `${playerId}-error`;
const playerData = {
  kind: entityKind,
  entity: {
    id: entityId,
    title: entityTitle,
    url: entityUrl,
  },
  tracks,
};
---

<article
  id={playerId}
  class="embed-album-player"
  data-embed-player
  data-embed-kind={entityKind}
  data-cover-visible="true"
  aria-labelledby={titleId}
>
  <img
    class="embed-album-player__artwork"
    width="160"
    height="160"
    alt={`Cover art for ${firstTrack?.album?.title || entityTitle}`}
    decoding="async"
    data-embed-artwork
    data-artwork-src={firstTrack?.artworkUrl}
  />

  <div class="embed-album-player__body">
    <header class="embed-album-player__header">
      <p class="embed-album-player__eyebrow">MelodyMind {entityKind}</p>
      <h1 class="embed-album-player__title" id={titleId}>
        <a
          class="embed-album-player__title-link"
          href={entityUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {entityTitle}
        </a>
      </h1>
    </header>

    {
      isSeries && firstTrack?.album && (
        <p class="embed-album-player__album-context" data-embed-album-context>
          Part {firstTrack.partNumber || 1} · {firstTrack.album.title}
        </p>
      )
    }

    <p class="embed-album-player__track">
      <span class="embed-album-player__track-number" data-embed-track-number>
        {firstTrack?.trackNumber || 1}.
      </span>
      <strong class="embed-album-player__track-title" data-embed-track-title>
        {firstTrack?.title || "No playable tracks"}
      </strong>
    </p>

    <div class="embed-album-player__controls" aria-label="Playback controls">
      <button
        class="embed-album-player__button embed-album-player__button--secondary"
        type="button"
        data-embed-action="previous"
        aria-label="Previous track"
      >
        <Icon name="tabler:player-skip-back-filled" aria-hidden="true" />
      </button>
      <button
        class="embed-album-player__button embed-album-player__button--primary"
        type="button"
        data-embed-action="toggle"
        aria-label={`Play ${firstTrack?.title || entityTitle}`}
        aria-pressed="false"
      >
        <Icon
          name="tabler:player-play-filled"
          class="embed-album-player__icon embed-album-player__icon--play"
          aria-hidden="true"
        />
        <Icon
          name="tabler:player-pause-filled"
          class="embed-album-player__icon embed-album-player__icon--pause"
          aria-hidden="true"
        />
      </button>
      <button
        class="embed-album-player__button embed-album-player__button--secondary"
        type="button"
        data-embed-action="next"
        aria-label="Next track"
      >
        <Icon name="tabler:player-skip-forward-filled" aria-hidden="true" />
      </button>

      <div class="embed-album-player__timeline">
        <span class="embed-album-player__time" data-embed-current-time>0:00</span>
        <label class="embed-album-player__sr-only" for={`${playerId}-progress`}>
          Playback progress
        </label>
        <input
          id={`${playerId}-progress`}
          class="embed-album-player__progress"
          type="range"
          min="0"
          max={firstTrack?.durationSeconds || 0}
          step="1"
          value="0"
          disabled
          aria-valuetext="0:00 elapsed"
          data-embed-progress
        />
        <span class="embed-album-player__time" data-embed-duration>
          {
            firstTrack?.durationSeconds
              ? `${Math.floor(firstTrack.durationSeconds / 60)}:${String(
                  firstTrack.durationSeconds % 60
                ).padStart(2, "0")}`
              : "0:00"
          }
        </span>
      </div>

      <button
        class="embed-album-player__button embed-album-player__button--secondary embed-album-player__button--mute"
        type="button"
        data-embed-action="mute"
        aria-label="Mute"
        aria-pressed="false"
      >
        <Icon
          name="tabler:volume"
          class="embed-album-player__icon embed-album-player__icon--volume-on"
          aria-hidden="true"
        />
        <Icon
          name="tabler:volume-off"
          class="embed-album-player__icon embed-album-player__icon--volume-off"
          aria-hidden="true"
        />
      </button>
    </div>

    <footer class="embed-album-player__footer">
      <p class="embed-album-player__message" id={errorId} data-embed-visible-status>
        Ready to play
      </p>
      <a
        class="embed-album-player__album-link"
        href={entityUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>Full {entityKind}</span>
        <Icon name="external-link" aria-hidden="true" />
      </a>
    </footer>
  </div>

  <p
    class="embed-album-player__sr-only"
    id={statusId}
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-embed-status
  >
    Ready to play
  </p>

  {
    /*
      eslint-disable astro/jsx-a11y/media-has-caption --
      Album content requires lyrics, an instrumental marker, or an explicit
      transcript-unavailable reason for every playable track. The hidden audio
      element contains music rather than spoken video content, and the custom
      controls expose the active track and playback state.
    */
  }
  <audio
    class="embed-album-player__audio"
    preload="none"
    data-embed-audio
    aria-describedby={statusId}></audio>
  {/* eslint-enable astro/jsx-a11y/media-has-caption */}

  <script
    is:inline
    type="application/json"
    data-embed-player-data
    set:html={JSON.stringify(playerData)}
  />
</article>

<script>
  import "../../../scripts/music/embed-album-player";
</script>

<style>
  .embed-album-player {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.85rem;
    inline-size: 100%;
    min-inline-size: 0;
    block-size: 100%;
    min-block-size: 12.5rem;
    padding: 0.75rem;
    overflow: hidden;
    color: var(--text-primary);
    background: var(--bg-primary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
  }

  .embed-album-player[data-cover-visible="false"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .embed-album-player__artwork {
    display: block;
    align-self: center;
    inline-size: 100%;
    max-inline-size: 8.5rem;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-base);
    box-shadow: var(--shadow-lg);
  }

  .embed-album-player[data-cover-visible="false"] .embed-album-player__artwork {
    display: none;
  }

  .embed-album-player__body {
    display: grid;
    grid-template-rows: auto auto auto auto;
    gap: 0.3rem;
    align-content: center;
    min-inline-size: 0;
    min-block-size: 0;
  }

  .embed-album-player__header {
    display: grid;
    gap: 0.05rem;
    min-inline-size: 0;
  }

  .embed-album-player__eyebrow,
  .embed-album-player__title,
  .embed-album-player__album-context,
  .embed-album-player__track,
  .embed-album-player__message {
    margin: 0;
  }

  .embed-album-player__eyebrow {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    white-space: nowrap;
  }

  .embed-album-player__title {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .embed-album-player__title-link {
    color: inherit;
    text-decoration: none;
  }

  .embed-album-player__title-link:hover,
  .embed-album-player__title-link:focus {
    color: var(--accent-primary);
  }

  .embed-album-player__album-context {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .embed-album-player[data-embed-kind="series"] .embed-album-player__body {
    gap: 0.16rem;
  }

  .embed-album-player__track {
    display: flex;
    gap: 0.35rem;
    min-inline-size: 0;
    overflow: hidden;
    font-size: var(--font-size-meta);
    line-height: 1.25;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .embed-album-player__track-number {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
  }

  .embed-album-player__track-title {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  .embed-album-player__controls {
    display: grid;
    grid-template-columns: 2.75rem 2.75rem 2.75rem minmax(5.5rem, 1fr) 2.75rem;
    gap: 0.3rem;
    align-items: center;
    min-inline-size: 0;
  }

  .embed-album-player__button {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    color: var(--text-primary);
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-full);
  }

  .embed-album-player__button:hover,
  .embed-album-player__button:focus {
    color: var(--accent-primary);
    background: color-mix(in srgb, var(--accent-primary) 10%, transparent);
    border-color: var(--accent-muted);
  }

  .embed-album-player__button--primary {
    color: var(--button-text-accent);
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .embed-album-player__button--primary:hover,
  .embed-album-player__button--primary:focus {
    color: var(--button-text-accent);
    background: var(--accent-primary-hover);
    border-color: var(--accent-primary-hover);
  }

  .embed-album-player__icon {
    inline-size: 1.1rem;
    block-size: 1.1rem;
  }

  .embed-album-player__icon--pause,
  .embed-album-player__icon--volume-off {
    display: none;
  }

  .embed-album-player[data-playing="true"] .embed-album-player__icon--play,
  .embed-album-player[data-muted="true"] .embed-album-player__icon--volume-on {
    display: none;
  }

  .embed-album-player[data-playing="true"] .embed-album-player__icon--pause,
  .embed-album-player[data-muted="true"] .embed-album-player__icon--volume-off {
    display: block;
  }

  .embed-album-player__timeline {
    display: grid;
    grid-template-columns: 2.5rem minmax(2rem, 1fr) 2.5rem;
    gap: 0.3rem;
    align-items: center;
    min-inline-size: 0;
  }

  .embed-album-player__time {
    font-size: var(--font-size-caption);
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
    text-align: center;
  }

  .embed-album-player__progress {
    inline-size: 100%;
    min-inline-size: 0;
    accent-color: var(--accent-primary);
    cursor: pointer;
  }

  .embed-album-player__progress:disabled {
    cursor: not-allowed;
    opacity: 0.56;
  }

  .embed-album-player__footer {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    min-inline-size: 0;
  }

  .embed-album-player__message {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--font-size-caption);
    line-height: 1.2;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .embed-album-player[data-error="true"] .embed-album-player__message {
    color: var(--color-error);
  }

  .embed-album-player__album-link {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.25rem;
    align-items: center;
    min-block-size: 1.5rem;
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    color: var(--accent-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .embed-album-player__button:focus-visible,
  .embed-album-player__title-link:focus-visible,
  .embed-album-player__album-link:focus-visible,
  .embed-album-player__progress:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: 1px;
  }

  .embed-album-player__album-link :global(svg) {
    inline-size: 0.8rem;
    block-size: 0.8rem;
  }

  .embed-album-player__audio {
    display: none;
  }

  .embed-album-player__sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  @media (width <= 440px) {
    .embed-album-player {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      gap: 0.6rem;
      padding: 0.6rem;
      border-radius: var(--radius-base);
    }

    .embed-album-player__artwork {
      max-inline-size: 4.75rem;
      box-shadow: var(--shadow-sm);
    }

    .embed-album-player__controls {
      grid-template-columns: 2.75rem 2.75rem 2.75rem minmax(0, 1fr);
    }

    .embed-album-player__button--mute {
      display: none;
    }

    .embed-album-player__timeline {
      grid-template-columns: minmax(2rem, 1fr);
    }

    .embed-album-player__time {
      display: none;
    }
  }

  @media (width <= 330px) {
    .embed-album-player {
      grid-template-columns: minmax(0, 1fr);
    }

    .embed-album-player__artwork {
      display: none;
    }

    .embed-album-player__eyebrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .embed-album-player *,
    .embed-album-player *::before,
    .embed-album-player *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }

  @media (forced-colors: active) {
    .embed-album-player,
    .embed-album-player__button,
    .embed-album-player__artwork {
      border-color: CanvasText;
    }

    .embed-album-player__button--primary {
      color: ButtonText;
      background: ButtonFace;
    }
  }
</style>
