---
import Icon from "@components/visual/Icon.astro";

interface Props {
  itemCount: number;
  itemSingular: string;
  itemPlural: string;
  label?: string;
  inputId?: string;
  placeholder?: string;
  threshold?: number;
}

const {
  itemCount,
  itemSingular,
  itemPlural,
  label = `Filter ${itemPlural}`,
  inputId = "collection-filter",
  placeholder = "Name, genre, or style",
  threshold = 12,
} = Astro.props as Props;
const showFilter = itemCount >= threshold;
---

<div
  class="collection-grid-filter"
  data-collection-filter={showFilter ? "true" : undefined}
  data-collection-filter-count={itemCount}
  data-collection-filter-singular={itemSingular}
  data-collection-filter-plural={itemPlural}
>
  {
    showFilter && (
      <div class="collection-grid-filter__controls">
        <label class="collection-grid-filter__label" for={inputId}>
          {label}
        </label>
        <div class="collection-grid-filter__field">
          <Icon name="search" class="collection-grid-filter__icon" aria-hidden="true" />
          <input
            id={inputId}
            class="collection-grid-filter__input"
            type="search"
            placeholder={placeholder}
            autocomplete="off"
            data-collection-filter-input
          />
          <button
            class="collection-grid-filter__clear"
            type="button"
            data-collection-filter-clear
            hidden
          >
            Clear
          </button>
        </div>
        <p
          class="collection-grid-filter__status"
          aria-live="polite"
          aria-atomic="true"
          data-collection-filter-status
          hidden
        >
          {itemCount} {itemPlural} shown
        </p>
      </div>
    )
  }

  <slot />

  {
    showFilter && (
      <div
        class="collection-grid-filter__empty"
        data-collection-filter-empty
        hidden
        role="status"
      >
        <p>No {itemPlural} match this filter.</p>
        <button type="button" data-collection-filter-clear>
          Show all {itemPlural}
        </button>
      </div>
    )
  }
</div>

<script>
  import "../../../scripts/music/collection-grid-filter";
</script>

<style>
  .collection-grid-filter {
    display: grid;
    gap: clamp(var(--spacing-base), 2vw, var(--spacing-lg));
  }

  .collection-grid-filter :global([data-collection-filter-item][hidden]) {
    display: none;
  }

  .collection-grid-filter__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--spacing-xs) var(--spacing-base);
    align-items: center;
    inline-size: min(100%, 32rem);
  }

  .collection-grid-filter__label {
    grid-row: 1;
    grid-column: 1;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    color: var(--text-secondary);
  }

  .collection-grid-filter__field {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-row: 2;
    grid-column: 1 / -1;
    gap: var(--spacing-xs);
    align-items: center;
    inline-size: min(100%, 32rem);
    min-block-size: var(--control-min-block-size);
    padding-inline: var(--spacing-sm);
    background: var(--surface-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-base);
  }

  .collection-grid-filter__field:focus-within {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
    border-color: var(--accent-primary);
  }

  .collection-grid-filter__icon {
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--text-tertiary);
  }

  .collection-grid-filter__input {
    min-inline-size: 0;
    min-block-size: calc(var(--control-min-block-size) - 2px);
    padding: 0;
    font: inherit;
    color: var(--text-primary);
    outline: 0;
    background: transparent;
    border: 0;
  }

  .collection-grid-filter__input::placeholder {
    color: var(--text-tertiary);
  }

  .collection-grid-filter__clear,
  .collection-grid-filter__empty button {
    min-block-size: var(--control-min-block-size);
    padding-inline: var(--spacing-sm);
    font: inherit;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--accent-primary);
    cursor: pointer;
    background: transparent;
    border: 0;
    border-radius: var(--radius-base);
  }

  .collection-grid-filter__empty button {
    padding-inline: 0;
  }

  .collection-grid-filter__clear:hover,
  .collection-grid-filter__clear:focus-visible,
  .collection-grid-filter__empty button:hover,
  .collection-grid-filter__empty button:focus-visible {
    color: var(--accent-strong);
  }

  .collection-grid-filter__clear:focus-visible,
  .collection-grid-filter__empty button:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .collection-grid-filter__status {
    grid-row: 1;
    grid-column: 2;
    justify-self: end;
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    color: var(--text-tertiary);
  }

  .collection-grid-filter__status[hidden] {
    display: none;
  }

  .collection-grid-filter__empty {
    display: grid;
    gap: var(--spacing-sm);
    justify-items: start;
    padding: var(--spacing-xl);
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-base);
  }

  .collection-grid-filter__empty[hidden] {
    display: none;
  }

  .collection-grid-filter__empty p {
    margin: 0;
  }

  @media (width <= 640px) {
    .collection-grid-filter__controls {
      grid-template-columns: minmax(0, 1fr);
    }

    .collection-grid-filter__label,
    .collection-grid-filter__field,
    .collection-grid-filter__status {
      grid-row: auto;
      grid-column: auto;
    }

    .collection-grid-filter__status {
      justify-self: start;
    }
  }
</style>
