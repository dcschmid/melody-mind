---
import Icon from "@components/visual/Icon.astro";

interface Props {
  quizTitle: string;
  copy: string;
  href: string;
}

const { quizTitle, copy, href } = Astro.props as Props;
const titleId = "album-quiz-teaser-title";
---

<section class="quiz-teaser" aria-labelledby={titleId}>
  <div class="quiz-teaser__copy">
    <h2 class="quiz-teaser__title" id={titleId}>{quizTitle}</h2>
    <p class="quiz-teaser__text">{copy}</p>
  </div>
  <div class="quiz-teaser__action">
    <a class="quiz-teaser__button" href={href}>
      <span>Test your knowledge</span>
      <Icon name="external-link" class="quiz-teaser__external-icon" aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .quiz-teaser {
    display: grid;
    gap: clamp(var(--spacing-base), 2vw, var(--spacing-lg));
    align-items: center;
    padding: clamp(var(--spacing-base), 2vw, var(--spacing-xl)) 0 0;
    color: var(--music-album-ink);
    background: transparent;
    border-block-start: 1px solid var(--music-album-line);
  }

  .quiz-teaser__copy {
    display: grid;
    gap: var(--spacing-xs);
    min-inline-size: 0;
  }

  .quiz-teaser__title {
    margin: 0;
    font-size: clamp(var(--font-size-md), 1.5vw, var(--font-size-lg));
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--music-album-ink);
    letter-spacing: var(--letter-spacing-normal);
    text-wrap: balance;
  }

  .quiz-teaser__text {
    max-inline-size: 62ch;
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--music-album-muted);
    text-wrap: pretty;
  }

  .quiz-teaser__button {
    box-sizing: border-box;
    display: inline-flex;
    gap: var(--spacing-xs);
    align-items: center;
    justify-content: center;
    max-inline-size: 100%;
    min-block-size: var(--control-min-block-size);
    padding: var(--spacing-sm) var(--spacing-base);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--music-album-ink);
    text-decoration: none;
    background: color-mix(in srgb, var(--music-album-paper) 78%, transparent);
    border: 1px solid color-mix(in srgb, var(--music-album-accent) 34%, transparent);
    border-radius: var(--radius-base);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .quiz-teaser__button:hover,
  .quiz-teaser__button:focus-visible {
    color: var(--button-text-accent);
    background: var(--music-album-accent);
    border-color: var(--music-album-accent);
    transform: translateY(-1px);
  }

  .quiz-teaser__button:focus-visible {
    outline: var(--focus-ring-width) solid var(--music-album-accent);
    outline-offset: var(--focus-ring-offset);
  }

  .quiz-teaser__external-icon {
    flex: 0 0 auto;
    inline-size: var(--icon-size-sm);
    block-size: var(--icon-size-sm);
    opacity: 0.72;
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .quiz-teaser__button {
      transition: none;
    }

    .quiz-teaser__button:hover,
    .quiz-teaser__button:focus-visible {
      transform: none;
    }
  }

  @media (width >= 760px) {
    .quiz-teaser {
      grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1fr);
      gap: clamp(var(--spacing-lg), 3vw, var(--spacing-2xl));
    }

    .quiz-teaser__action {
      display: flex;
      justify-content: flex-end;
    }
  }

  @media (width <= 520px) {
    .quiz-teaser__button {
      inline-size: 100%;
    }
  }
</style>
