---
import HomeArchive from "@components/HomeArchive.astro";
import { getPublishedStories } from "@utils/archive";
import { getArchivePageSlice } from "@utils/archivePagination";

const stories = await getPublishedStories();
const page = getArchivePageSlice(stories, 1);
---

<HomeArchive stories={page.data} {...page} />
