---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Layout from "@layouts/Layout.astro";

const stories = (await getCollection("stories", ({ data }) => !data.draft)).toSorted(
  (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf()
);
const featured = stories[0];
if (!featured)
  throw new Error("The Stories homepage requires at least one published story.");
const archiveStories = stories.slice(1);
const formatLabel = (format: string) =>
  format
    .split("-")
    .map((word) => word[0]?.toUpperCase() + word.slice(1))
    .join(" ");
const canonical = new URL("/", Astro.site).toString();
const image = new URL(featured.data.hero.image.src, Astro.site).toString();
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "MelodyMind Stories",
  description:
    "Sourced long-form music journalism about artists, scenes, recordings, and design.",
  url: canonical,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: stories.map((story, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/${story.id}/`, Astro.site).toString(),
      name: story.data.title,
    })),
  },
};
---

<Layout
  title="MelodyMind Stories | Long-form music journalism"
  description="Sixteen sourced long-form stories about performers, scenes, recording technology, and the images through which music history travels."
  {canonical}
  {image}
  imageAlt={featured.data.hero.alt}
  imageWidth={featured.data.hero.image.width}
  imageHeight={featured.data.hero.image.height}
  imageType={featured.data.hero.image.format === "jpg"
    ? "image/jpeg"
    : `image/${featured.data.hero.image.format}`}
  structuredData={[collectionSchema]}
>
  <section class="home-hero">
    <div class="home-hero__image reveal">
      <Image
        src={featured.data.hero.image}
        alt={featured.data.hero.alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 64rem) 58vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="home-hero__copy reveal reveal--second">
      <p class="eyebrow">
        Latest · {formatLabel(featured.data.format)} ·{" "}
        <time datetime={featured.data.publishedAt.toISOString()}>
          {
            featured.data.publishedAt.toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
            })
          }
        </time>
      </p>
      <h1>{featured.data.title}</h1>
      <p>{featured.data.dek}</p>
      <a class="text-link" href={`/${featured.id}/`}>Read the story <span>→</span></a>
    </div>
    <p class="home-hero__credit reveal reveal--third">
      {featured.data.hero.caption}
      {featured.data.hero.creator}.
      <a href={featured.data.hero.sourceUrl}>{featured.data.hero.sourceName}</a>,
      <a href={featured.data.hero.licenseUrl}>{featured.data.hero.license}</a>.
    </p>
  </section>

  <section class="archive page-shell" aria-labelledby="archive-title">
    <header class="archive__header">
      <p class="eyebrow">Reading room · {archiveStories.length} more stories</p>
      <h2 id="archive-title">Continue through the archive.</h2>
      <p>
        Each story runs 1,800–2,500 words and includes numbered endnotes, local images,
        and a visible rights ledger.
      </p>
    </header>

    <ol class="archive__list">
      {
        archiveStories.map((story, index) => (
          <li class="archive__item">
            <a class="archive__card" href={`/${story.id}/`}>
              <span class="archive__image">
                <Image
                  src={story.data.hero.image}
                  alt=""
                  widths={[400, 640, 900]}
                  sizes="(min-width: 72rem) 29rem, (min-width: 48rem) 44vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="archive__body">
                <span class="archive__meta">
                  <span class="eyebrow">
                    {formatLabel(story.data.format)} ·{" "}
                    <time datetime={story.data.publishedAt.toISOString()}>
                      {story.data.publishedAt.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </time>
                  </span>
                  <span class="archive__number" aria-hidden="true">
                    {String(index + 2).padStart(2, "0")}
                  </span>
                </span>
                <h3>{story.data.title}</h3>
                <span class="archive__dek">{story.data.dek}</span>
                <span class="archive__action" aria-hidden="true">
                  Read story <span>→</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <aside class="home-note reading-shell">
    <p class="eyebrow">How we work</p>
    <p>
      MelodyMind Stories publishes in English, documents every image, and names the
      sources behind each article. Research and drafting use AI assistance; editorial
      claims and rights notes remain visible for readers to inspect.
    </p>
    <a class="text-link" href="/about/">Read the editorial method <span>→</span></a>
  </aside>
</Layout>

<style>
  .home-hero {
    display: grid;
    min-block-size: auto;
    background: var(--desk-night);
  }

  .home-hero__image {
    block-size: clamp(13.5rem, 26svh, 15.5rem);
    min-block-size: 0;
    overflow: hidden;
  }

  .home-hero__image :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: contrast(1.04);
  }

  .home-hero__copy {
    display: grid;
    gap: var(--space-md);
    align-content: center;
    padding: clamp(1.5rem, 5vw, 3.5rem) max(1rem, calc((100vw - var(--wide-width)) / 2));
  }

  .home-hero__copy h1 {
    max-inline-size: 11ch;
    font-size: clamp(2.55rem, 11.5vw, 7.8rem);
    letter-spacing: -0.05em;
  }

  .home-hero__copy > p:not(.eyebrow) {
    max-inline-size: 54ch;
    font-size: clamp(1.12rem, 2vw, 1.4rem);
    color: var(--quiet-ink);
  }

  .home-hero__credit {
    align-self: end;
    padding: 0 1rem var(--space-md);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--quiet-ink);
  }

  .archive {
    display: grid;
    gap: var(--space-3xl);
    padding-block: var(--space-4xl);
    border-block-start: 1px solid var(--line);
  }

  .archive__header {
    display: grid;
    gap: var(--space-lg);
  }

  .archive__header h2 {
    max-inline-size: 15ch;
    font-size: clamp(2.6rem, 6vw, 5.8rem);
  }

  .archive__header > p:last-child {
    max-inline-size: 58ch;
    font-size: 1.1rem;
    color: var(--quiet-ink);
  }

  .archive__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .archive__item {
    min-inline-size: 0;
  }

  .archive__card {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    overflow: hidden;
    color: var(--paper-ink);
    text-decoration: none;
    background: var(--desk-night);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition:
      background-color 300ms var(--ease-out),
      border-color 300ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .archive__card:hover,
  .archive__card:focus-visible {
    color: var(--paper-ink);
    background: var(--lifted-night);
    border-color: var(--archive-teal);
    transform: translateY(-0.3rem);
  }

  .archive__card:focus-visible {
    outline-offset: 0.25rem;
  }

  .archive__image {
    display: block;
    flex: 0 0 auto;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--archive-night);
  }

  .archive__image :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.86) contrast(1.04);
    transition:
      filter 300ms var(--ease-out),
      transform 600ms var(--ease-out);
  }

  .archive__card:hover .archive__image :global(img),
  .archive__card:focus-visible .archive__image :global(img) {
    filter: saturate(1) contrast(1);
    transform: scale(1.025);
  }

  .archive__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl);
  }

  .archive__meta {
    display: flex;
    gap: var(--space-md);
    align-items: start;
    justify-content: space-between;
  }

  .archive__number {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.2;
    color: var(--archive-teal-strong);
  }

  .archive__body h3 {
    max-inline-size: 16ch;
    font-size: clamp(1.75rem, 3vw, 2.45rem);
    transition: color 300ms var(--ease-out);
  }

  .archive__card:hover h3,
  .archive__card:focus-visible h3 {
    color: var(--archive-teal-strong);
  }

  .archive__dek {
    flex: 1;
    line-height: 1.65;
    color: var(--quiet-ink);
  }

  .archive__action {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    align-self: start;
    min-block-size: var(--control-size);
    padding-block-start: var(--space-xs);
    font-weight: 700;
    color: var(--archive-teal-strong);
  }

  .home-note {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-3xl);
  }

  .home-note > p:not(.eyebrow) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .archive__card {
      transition: none;
    }

    .archive__image :global(img) {
      transition: none;
    }

    .archive__body h3 {
      transition: none;
    }
  }

  @media (width >= 48rem) {
    .archive__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .home-hero {
      grid-template-rows: 1fr auto;
      grid-template-columns: minmax(0, 1.3fr) minmax(30rem, 0.75fr);
      min-block-size: calc(100svh - 4.75rem);
    }

    .home-hero__image {
      grid-row: 1 / 3;
      block-size: auto;
      min-block-size: calc(100svh - 4.75rem);
    }

    .home-hero__copy {
      padding-inline: clamp(3rem, 6vw, 7rem);
    }

    .home-hero__copy h1 {
      font-size: clamp(4.75rem, 6.4vw, 5.8rem);
    }

    .home-hero__credit {
      padding-inline: clamp(3rem, 6vw, 7rem);
    }
  }

  @media (width >= 72rem) {
    .archive__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
