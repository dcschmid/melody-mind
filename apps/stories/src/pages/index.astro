---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import Layout from "@layouts/Layout.astro";
import AiDisclosure from "@components/AiDisclosure.astro";

const stories = (await getCollection("stories", ({ data }) => !data.draft)).toSorted(
  (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf()
);
const featured = stories[0];
if (!featured)
  throw new Error("The Stories homepage requires at least one published story.");
const archiveStories = stories.slice(1);
const dispatches = archiveStories.slice(0, 4);
const catalogStories = archiveStories.slice(4);
const formatLabel = (format: string) =>
  format
    .split("-")
    .map((word) => word[0]?.toUpperCase() + word.slice(1))
    .join(" ");
const canonical = new URL("/", Astro.site).toString();
const image = new URL(featured.data.hero.image.src, Astro.site).toString();
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "MelodyMind Stories",
  description:
    "Sourced long-form music journalism about artists, scenes, recordings, and design.",
  url: canonical,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: stories.map((story, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/${story.id}/`, Astro.site).toString(),
      name: story.data.title,
    })),
  },
};
---

<Layout
  title="MelodyMind Stories | Long-form music journalism"
  description="Sixteen sourced long-form stories about performers, scenes, recording technology, and the images through which music history travels."
  {canonical}
  {image}
  imageAlt={featured.data.hero.alt}
  imageWidth={featured.data.hero.image.width}
  imageHeight={featured.data.hero.image.height}
  imageType={featured.data.hero.image.format === "jpg"
    ? "image/jpeg"
    : `image/${featured.data.hero.image.format}`}
  structuredData={[collectionSchema]}
>
  <section class="home-hero">
    <div class="home-hero__image reveal">
      <Image
        src={featured.data.hero.image}
        alt={featured.data.hero.alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 64rem) 58vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="home-hero__copy reveal reveal--second">
      <p class="eyebrow">
        Latest · {formatLabel(featured.data.format)} ·{" "}
        <time datetime={featured.data.publishedAt.toISOString()}>
          {
            featured.data.publishedAt.toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
            })
          }
        </time>
      </p>
      <AiDisclosure
        variant="assisted"
        label="AI-assisted, human-reviewed"
        detailsHref="/about/#ai-transparency"
      />
      <h1>{featured.data.title}</h1>
      <p>{featured.data.dek}</p>
      <a class="text-link" href={`/${featured.id}/`}>Read the story <span>→</span></a>
    </div>
    <p class="home-hero__credit reveal reveal--third">
      {featured.data.hero.caption}
      {featured.data.hero.creator}.
      <a href={featured.data.hero.sourceUrl}>{featured.data.hero.sourceName}</a>,
      <a href={featured.data.hero.licenseUrl}>{featured.data.hero.license}</a>.
    </p>
  </section>

  <section class="archive page-shell" aria-labelledby="archive-title">
    <header class="archive__header">
      <p class="eyebrow">Reading room · {stories.length} documented stories</p>
      <h2 id="archive-title">Four ways into the archive.</h2>
      <p>
        Begin with a scene, a person, a machine, or a room. Every route leads to numbered
        endnotes and a visible image-rights ledger.
      </p>
    </header>

    <ol class="archive__dispatches">
      {
        dispatches.map((story, index) => (
          <li
            class:list={[
              "archive__dispatch",
              index % 2 !== 0 && "archive__dispatch--reverse",
            ]}
          >
            <a class="archive__dispatch-link" href={`/${story.id}/`}>
              <span class="archive__dispatch-image">
                <Image
                  src={story.data.hero.image}
                  alt=""
                  widths={[480, 768, 1024, 1280]}
                  sizes="(min-width: 64rem) 55vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="archive__dispatch-body">
                <span class="archive__number" aria-hidden="true">
                  {String(index + 2).padStart(2, "0")}
                </span>
                <span class="eyebrow">
                  {formatLabel(story.data.format)} ·{" "}
                  <time datetime={story.data.publishedAt.toISOString()}>
                    {story.data.publishedAt.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>
                </span>
                <h3>{story.data.title}</h3>
                <span class="archive__dispatch-dek">{story.data.dek}</span>
                <span class="archive__action">
                  Read story <span>→</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <section class="catalog" aria-labelledby="catalog-title">
      <header class="catalog__header">
        <p class="eyebrow">The catalog</p>
        <h2 id="catalog-title">{catalogStories.length} further records</h2>
      </header>
      <ol class="catalog__list" start="6">
        {
          catalogStories.map((story, index) => (
            <li class="catalog__item">
              <a href={`/${story.id}/`}>
                <span class="catalog__number" aria-hidden="true">
                  {String(index + 6).padStart(2, "0")}
                </span>
                <span class="catalog__image">
                  <Image
                    src={story.data.hero.image}
                    alt=""
                    widths={[160, 240, 360]}
                    sizes="(min-width: 48rem) 10rem, 5rem"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="catalog__title">{story.data.title}</span>
                <span class="catalog__format">{formatLabel(story.data.format)}</span>
                <span class="catalog__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </section>

  <aside class="home-note reading-shell">
    <p class="eyebrow">How we work</p>
    <p>
      MelodyMind Stories publishes in English, documents every image, and names the
      sources behind each article. Research and drafting use AI assistance; editorial
      claims and rights notes remain visible for readers to inspect.
    </p>
    <a class="text-link" href="/about/">Read the editorial method <span>→</span></a>
  </aside>
</Layout>

<style>
  .home-hero {
    display: grid;
    min-block-size: auto;
    background: var(--desk-night);
  }

  .home-hero__image {
    block-size: clamp(13.5rem, 26svh, 15.5rem);
    min-block-size: 0;
    overflow: hidden;
  }

  .home-hero__image :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: contrast(1.04);
  }

  .home-hero__copy {
    display: grid;
    gap: var(--space-md);
    align-content: center;
    padding: clamp(1.5rem, 5vw, 3.5rem) max(1rem, calc((100vw - var(--wide-width)) / 2));
  }

  .home-hero__copy h1 {
    max-inline-size: 11ch;
    font-size: clamp(2.55rem, 11.5vw, 7.8rem);
    letter-spacing: -0.05em;
  }

  .home-hero__copy > p:not(.eyebrow) {
    max-inline-size: 54ch;
    font-size: clamp(1.12rem, 2vw, 1.4rem);
    color: var(--quiet-ink);
  }

  .home-hero__credit {
    align-self: end;
    padding: 0 1rem var(--space-md);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--quiet-ink);
  }

  .archive {
    display: grid;
    gap: var(--space-4xl);
    padding-block: var(--space-4xl);
    border-block-start: 1px solid var(--line);
  }

  .archive__header {
    display: grid;
    gap: var(--space-lg);
  }

  .archive__header h2 {
    max-inline-size: 13ch;
    font-size: clamp(2.6rem, 6vw, 5.4rem);
  }

  .archive__header > p:last-child {
    max-inline-size: 58ch;
    font-size: 1.1rem;
    color: var(--quiet-ink);
  }

  .archive__dispatches {
    display: grid;
    gap: var(--space-4xl);
    padding: 0;
    list-style: none;
  }

  .archive__dispatch {
    min-inline-size: 0;
  }

  .archive__dispatch-link {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    color: var(--paper-ink);
    text-decoration: none;
  }

  .archive__dispatch-image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--archive-night);
  }

  .archive__dispatch-image :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.86) contrast(1.04);
    transition:
      filter 300ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .archive__dispatch-link:hover .archive__dispatch-image :global(img),
  .archive__dispatch-link:focus-visible .archive__dispatch-image :global(img) {
    filter: saturate(1) contrast(1);
    transform: scale(1.018);
  }

  .archive__dispatch-body {
    display: grid;
    gap: var(--space-md);
    align-items: start;
    padding-block: var(--space-lg);
    border-block: 1px solid var(--line-soft);
  }

  .archive__number {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    line-height: 0.8;
    color: var(--oxide);
  }

  .archive__dispatch-body h3 {
    max-inline-size: 15ch;
    font-size: clamp(2.2rem, 5vw, 4.7rem);
    letter-spacing: -0.035em;
    transition: color 300ms var(--ease-out);
  }

  .archive__dispatch-link:hover h3,
  .archive__dispatch-link:focus-visible h3 {
    color: var(--archive-teal-strong);
  }

  .archive__dispatch-dek {
    max-inline-size: 52ch;
    line-height: 1.65;
    color: var(--quiet-ink);
  }

  .archive__action {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    align-self: start;
    min-block-size: var(--control-size);
    padding-block-start: var(--space-xs);
    font-weight: 700;
    color: var(--archive-teal-strong);
  }

  .catalog {
    display: grid;
    gap: var(--space-2xl);
    padding-block-start: var(--space-3xl);
    border-block-start: 1px solid var(--line);
  }

  .catalog__header {
    display: grid;
    gap: var(--space-sm);
  }

  .catalog__header h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .catalog__list {
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }

  .catalog__item a {
    display: grid;
    grid-template-columns: 2.5rem 5rem minmax(0, 1fr) auto;
    gap: var(--space-md);
    align-items: center;
    min-block-size: 7rem;
    padding-block: var(--space-md);
    color: var(--paper-ink);
    text-decoration: none;
    border-block-end: 1px solid var(--line-soft);
    transition:
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  .catalog__item a:hover,
  .catalog__item a:focus-visible {
    color: var(--archive-teal-strong);
    background: var(--desk-night);
  }

  .catalog__number {
    font-family: var(--font-display);
    color: var(--oxide);
  }

  .catalog__image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .catalog__image :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.75);
  }

  .catalog__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 650;
    line-height: 1.12;
  }

  .catalog__format {
    display: none;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--quiet-ink);
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .catalog__arrow {
    color: var(--archive-teal-strong);
  }

  .home-note {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-3xl);
  }

  .home-note > p:not(.eyebrow) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .archive__dispatch-image :global(img) {
      transition: none;
    }

    .archive__dispatch-body h3 {
      transition: none;
    }

    .catalog__item a {
      transition: none;
    }
  }

  @media (width >= 48rem) {
    .catalog__item a {
      grid-template-columns: 3rem 8rem minmax(0, 1fr) 11rem 2rem;
      min-block-size: 9rem;
    }

    .catalog__format {
      display: block;
    }
  }

  @media (width >= 64rem) {
    .home-hero {
      grid-template-rows: 1fr auto;
      grid-template-columns: minmax(0, 1.3fr) minmax(30rem, 0.75fr);
      min-block-size: calc(100svh - 4.75rem);
    }

    .home-hero__image {
      grid-row: 1 / 3;
      block-size: auto;
      min-block-size: calc(100svh - 4.75rem);
    }

    .home-hero__copy {
      padding-inline: clamp(3rem, 6vw, 7rem);
    }

    .home-hero__copy h1 {
      font-size: clamp(4.4rem, 5.8vw, 5.35rem);
    }

    .home-hero__credit {
      padding-inline: clamp(3rem, 6vw, 7rem);
    }

    .archive__dispatch-link {
      grid-template-columns: minmax(0, 1.18fr) minmax(24rem, 0.82fr);
      gap: clamp(3rem, 7vw, 8rem);
    }

    .archive__dispatch-body {
      padding-block: var(--space-2xl);
    }

    .archive__dispatch--reverse .archive__dispatch-image {
      grid-column: 2;
    }

    .archive__dispatch--reverse .archive__dispatch-body {
      grid-row: 1;
      grid-column: 1;
    }

    .archive__dispatch:nth-child(3n) .archive__dispatch-image {
      aspect-ratio: 16 / 10;
    }
  }
</style>
