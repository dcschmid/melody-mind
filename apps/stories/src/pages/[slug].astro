---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";

import AnnotatedArtifact from "@components/AnnotatedArtifact.astro";
import AiDisclosure from "@components/AiDisclosure.astro";
import EditorialFigure from "@components/EditorialFigure.astro";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const stories = await getCollection("stories", ({ data }) => !data.draft);
  const sorted = stories.toSorted(
    (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf()
  );

  return sorted.map((story, index) => ({
    params: { slug: story.id },
    props: {
      story,
      related: sorted[(index + 1) % sorted.length],
    },
  }));
}

interface Props {
  story: CollectionEntry<"stories">;
  related: CollectionEntry<"stories">;
}

const { story, related } = Astro.props;
const { Content } = await render(story);
const canonical = new URL(`/${story.id}/`, Astro.site).toString();
const image = new URL(story.data.hero.image.src, Astro.site).toString();
const allImages = [story.data.hero, ...story.data.figures];
const artifactImage = story.data.artifact
  ? allImages.find((entry) => entry.id === story.data.artifact?.imageId)
  : undefined;
const formatLabel = story.data.format
  .split("-")
  .map((word) => word[0]?.toUpperCase() + word.slice(1))
  .join(" ");
const hasLongTitleWord = story.data.title
  .split(/\s+/)
  .some((word) => word.replace(/[^\p{L}\p{N}]/gu, "").length >= 10);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: story.data.title,
  description: story.data.seoDescription,
  datePublished: story.data.publishedAt.toISOString(),
  mainEntityOfPage: canonical,
  image,
  author: {
    "@type": "Organization",
    name: story.data.byline,
    url: "https://stories.melody-mind.de/about/",
  },
  publisher: {
    "@type": "Organization",
    name: "MelodyMind",
    url: "https://melody-mind.de/",
  },
  citation: story.data.sources.map((source) => source.url),
  keywords: story.data.topics.join(", "),
};
---

<Layout
  title={story.data.title}
  description={story.data.seoDescription}
  {canonical}
  {image}
  imageAlt={story.data.hero.alt}
  imageWidth={story.data.hero.image.width}
  imageHeight={story.data.hero.image.height}
  imageType={story.data.hero.image.format === "jpg"
    ? "image/jpeg"
    : `image/${story.data.hero.image.format}`}
  type="article"
  publishedAt={story.data.publishedAt}
  structuredData={[articleSchema]}
>
  <article class="story">
    <header class="story__hero page-shell">
      <div class="story__hero-copy">
        <p class="story__format eyebrow reveal">{formatLabel}</p>
        <AiDisclosure
          variant="assisted"
          label="AI-assisted, human-reviewed"
          detailsHref="#editorial-disclosure"
        />
        <h1
          class:list={[
            "story__title reveal reveal--second",
            hasLongTitleWord && "story__title--long-word",
          ]}
        >
          {story.data.title}
        </h1>
        <p class="story__dek reveal reveal--third">{story.data.dek}</p>
        <dl class="story__meta reveal reveal--third">
          <div>
            <dt>By</dt>
            <dd>{story.data.byline}</dd>
          </div>
          <div>
            <dt>Published</dt>
            <dd>
              <time datetime={story.data.publishedAt.toISOString()}>
                {
                  story.data.publishedAt.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                  })
                }
              </time>
            </dd>
          </div>
        </dl>
      </div>

      <div class="story__hero-image reveal reveal--second">
        <EditorialFigure
          {...story.data.hero}
          eager
          sizes="(min-width: 64rem) 58vw, 100vw"
        />
      </div>
    </header>

    <div class="story__body reading-shell" id="article-body">
      <Content />
    </div>

    {
      artifactImage && story.data.artifact && (
        <AnnotatedArtifact
          image={artifactImage.image}
          alt={artifactImage.alt}
          caption={artifactImage.caption}
          label={story.data.artifact.label}
          markers={story.data.artifact.markers}
        />
      )
    }

    <section class="story__figures page-shell" aria-labelledby="figures-title">
      <div class="story__section-heading">
        <p class="eyebrow">From the archive</p>
        <h2 id="figures-title">Objects and places</h2>
      </div>
      <div class="story__figure-list">
        {story.data.figures.map((figure) => <EditorialFigure {...figure} />)}
      </div>
    </section>

    <script is:inline>
      (() => {
        const article = document.currentScript?.closest("article");
        const body = article?.querySelector(".story__body");
        const archive = article?.querySelector(".story__figures");
        const figures = [...(archive?.querySelectorAll(".editorial-figure") ?? [])];
        const headings = [...(body?.querySelectorAll("h2") ?? [])];

        if (!body || !archive || figures.length === 0 || headings.length === 0) {
          return;
        }

        figures.forEach((figure, index) => {
          const headingIndex = Math.min(
            headings.length - 1,
            Math.max(
              0,
              Math.round(((index + 1) * headings.length) / (figures.length + 1)) - 1
            )
          );
          const heading = headings[headingIndex];
          let insertionPoint = heading.nextElementSibling;

          for (let paragraphCount = 0; insertionPoint && paragraphCount < 2;) {
            if (insertionPoint.tagName === "P") {
              paragraphCount += 1;
            }
            if (paragraphCount < 2) {
              insertionPoint = insertionPoint.nextElementSibling;
            }
          }

          body.insertBefore(figure, insertionPoint?.nextElementSibling ?? null);
          figure.classList.add("editorial-figure--inline");
        });

        archive.remove();
      })();
    </script>

    <aside
      class="story__disclosure reading-shell"
      id="editorial-disclosure"
      aria-labelledby="disclosure-title"
    >
      <h2 id="disclosure-title">Editorial disclosure</h2>
      <p>
        Research and drafting were assisted by AI. MelodyMind Editorial reviewed the
        published text and accepts responsibility for its wording, sources, and claims.
        Sources and image rights are documented below.
      </p>
    </aside>

    <section class="story__notes reading-shell" aria-labelledby="sources-title">
      <p class="eyebrow">Documentation</p>
      <h2 id="sources-title">Sources and endnotes</h2>
      <ol class="story__source-list">
        {
          story.data.sources.map((source) => (
            <li id={`source-${source.id}`}>
              <span>
                <a href={source.url}>{source.title}</a>, {source.publisher}. Accessed{" "}
                {source.accessedAt.toLocaleDateString("en-US", {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                })}
                .
              </span>
              <a class="story__backlink" href="#article-body">
                Back to article
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="story__rights reading-shell" aria-labelledby="rights-title">
      <h2 id="rights-title">Image rights</h2>
      <dl>
        {
          allImages.map((entry) => (
            <div>
              <dt>{entry.caption}</dt>
              <dd>
                {entry.creator}. <a href={entry.sourceUrl}>{entry.sourceName}</a>.{" "}
                <a href={entry.licenseUrl}>{entry.license}</a>. {entry.alterations}.
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <footer class="story__footer reading-shell">
      <div class="story__author">
        <p class="eyebrow">Byline</p>
        <h2>{story.data.byline}</h2>
        <p>
          MelodyMind Editorial produces sourced music histories with transparent research
          notes and documented image rights.
        </p>
      </div>
      <a class="story__related" href={`/${related.id}/`}>
        <span class="story__related-image" aria-hidden="true">
          <Image
            src={related.data.hero.image}
            alt=""
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 14rem, 36vw"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="story__related-copy">
          <span class="eyebrow">Read next</span>
          <strong>{related.data.title}</strong>
          <span>{related.data.dek}</span>
        </span>
      </a>
    </footer>
  </article>
</Layout>

<style>
  .story {
    display: grid;
    gap: clamp(4.5rem, 9vw, 8rem);
  }

  .story__hero {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem) 0;
  }

  .story__hero-copy {
    display: grid;
    gap: var(--space-lg);
    align-content: end;
    container-type: inline-size;
  }

  .story__title {
    max-inline-size: 14ch;
    font-size: clamp(2.75rem, 7vw, 6.4rem);
    letter-spacing: -0.04em;
  }

  .story__dek {
    max-inline-size: 58ch;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    color: var(--quiet-ink);
  }

  .story__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-2xl);
    padding-block-start: var(--space-lg);
    border-block-start: 3px double var(--line);
  }

  .story__meta div {
    display: grid;
    gap: var(--space-2xs);
  }

  .story__meta dt {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--quiet-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .story__hero-image {
    min-inline-size: 0;
  }

  .story__body {
    inline-size: min(100% - 2rem, 76ch);
    padding: clamp(1.5rem, 5vw, 4.5rem);
    font-size: clamp(1.08rem, 1.8vw, 1.2rem);
    color: var(--reading-ink);
    background: var(--reading-surface);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--archive-teal) 12%, transparent),
      0 1.5rem 4rem oklch(4% 0.02 250deg / 16%);
  }

  .story__body :global(a) {
    color: var(--reading-link);
  }

  .story__body :global(a:hover),
  .story__body :global(a:focus-visible) {
    color: var(--reading-ink);
  }

  .story__body :global(p) {
    margin-block: 0 1.45em;
  }

  .story__body :global(p:first-child) {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    line-height: 1.5;
    color: var(--reading-ink);
  }

  .story__body :global(p:first-child)::first-letter {
    float: left;
    margin-inline-end: 0.09em;
    font-family: var(--font-display);
    font-size: 3.05em;
    font-weight: 700;
    line-height: 0.82;
    color: var(--oxide);
  }

  .story__body :global(h2) {
    margin-block: 2.2em 0.8em;
    font-size: clamp(2rem, 4vw, 3.2rem);
    scroll-margin-block-start: var(--space-lg);
  }

  .story__body :global(h2)::before {
    display: block;
    inline-size: 2.5rem;
    block-size: 2px;
    margin-block-end: var(--space-sm);
    content: "";
    background: var(--oxide);
  }

  .story__body :global(h3) {
    margin-block: 1.8em 0.7em;
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .story__body :global(blockquote) {
    padding-inline-start: var(--space-lg);
    margin-block: var(--space-2xl);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    line-height: 1.4;
    color: var(--reading-ink);
    border-inline-start: 2px solid color-mix(in oklch, var(--oxide) 72%, transparent);
  }

  .story__body :global(.editorial-figure--inline) {
    justify-items: center;
    inline-size: calc(100% + clamp(0rem, 8vw, 10rem));
    max-inline-size: none;
    margin-block: clamp(2.5rem, 7vw, 4.5rem);
    margin-inline: clamp(-5rem, -4vw, 0rem);
  }

  .story__body :global(.editorial-figure--inline img) {
    inline-size: auto;
    max-inline-size: 100%;
    block-size: auto;
    max-block-size: min(80vh, 48rem);
    margin-inline: auto;
    object-fit: contain;
  }

  .story__figures {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-3xl);
    border-block: 1px solid var(--line-soft);
  }

  .story__section-heading {
    display: grid;
    gap: var(--space-md);
  }

  .story__section-heading h2 {
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .story__figure-list {
    display: grid;
    gap: var(--space-3xl);
  }

  .story__disclosure {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--desk-night);
    border: 1px solid var(--line);
  }

  .story__disclosure h2,
  .story__rights h2 {
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .story__disclosure p,
  .story__rights dd {
    color: var(--quiet-ink);
  }

  .story__notes {
    display: grid;
    gap: var(--space-lg);
  }

  .story__notes h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .story__source-list {
    display: grid;
    gap: var(--space-lg);
    padding-inline-start: 1.4rem;
  }

  .story__source-list li {
    padding-block-start: var(--space-md);
    padding-inline-start: var(--space-sm);
    line-height: 1.55;
    border-block-start: 1px solid var(--line-soft);
  }

  .story__source-list li::marker {
    font-weight: 700;
    color: var(--oxide);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .story__backlink {
      display: block;
      inline-size: fit-content;
      min-block-size: var(--control-size);
      padding-block: var(--space-sm);
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--quiet-ink);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-decoration: none;
      transition: none;
    }
  }

  .story__backlink {
    display: block;
    inline-size: fit-content;
    min-block-size: var(--control-size);
    padding-block: var(--space-sm);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--quiet-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 300ms var(--ease-out);
  }

  .story__backlink:hover,
  .story__backlink:focus-visible {
    color: var(--archive-teal-strong);
  }

  .story__rights {
    display: grid;
    gap: var(--space-md);
  }

  .story__rights dl {
    display: grid;
    gap: var(--space-lg);
  }

  .story__rights dl div {
    display: grid;
    gap: var(--space-xs);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--line-soft);
  }

  .story__rights dt {
    font-weight: 700;
  }

  .story__footer {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-3xl);
    border-block-start: 1px solid var(--line);
  }

  .story__author {
    display: grid;
    gap: var(--space-sm);
  }

  .story__author h2 {
    font-size: clamp(1.8rem, 4vw, 2.7rem);
  }

  .story__author p:last-child {
    color: var(--quiet-ink);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .story__related {
      display: grid;
      grid-template-columns: clamp(6.5rem, 18vw, 12rem) minmax(0, 1fr);
      gap: var(--space-md) clamp(var(--space-md), 3vw, var(--space-xl));
      align-items: center;
      padding-block: var(--space-xl);
      color: var(--paper-ink);
      text-decoration: none;
      border-block: 1px solid var(--line);
      transition: none;
    }
  }

  .story__related {
    display: grid;
    grid-template-columns: clamp(6.5rem, 18vw, 12rem) minmax(0, 1fr);
    gap: var(--space-md) clamp(var(--space-md), 3vw, var(--space-xl));
    align-items: center;
    padding-block: var(--space-xl);
    color: var(--paper-ink);
    text-decoration: none;
    border-block: 1px solid var(--line);
    transition: border-color 300ms var(--ease-out);
  }

  .story__related-image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--desk-night);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .story__related-image :global(img) {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      filter: saturate(0.86) contrast(1.04);
      transition: none;
    }
  }

  .story__related-image :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.86) contrast(1.04);
    transition:
      filter 300ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .story__related-copy {
    display: grid;
    gap: var(--space-xs);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .story__related strong {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 4vw, 2.4rem);
      transition: none;
    }
  }

  .story__related strong {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    transition: color 300ms var(--ease-out);
  }

  .story__related-copy span:last-child {
    color: var(--quiet-ink);
  }

  .story__related:hover,
  .story__related:focus-visible {
    border-block-color: color-mix(in oklch, var(--archive-teal) 55%, var(--line));
  }

  .story__related:hover .story__related-image :global(img),
  .story__related:focus-visible .story__related-image :global(img) {
    filter: saturate(1) contrast(1);
    transform: scale(1.02);
  }

  .story__related:hover strong,
  .story__related:focus-visible strong {
    color: var(--archive-teal-strong);
  }

  @media (width >= 64rem) {
    .story__hero {
      grid-template-columns: minmax(25rem, 0.78fr) minmax(0, 1.22fr);
    }

    .story__hero-image {
      transform: translateY(var(--space-xl));
    }

    .story__title--long-word {
      font-size: clamp(3.6rem, 15cqi, 6.4rem);
    }

    .story__figures {
      grid-template-columns: minmax(18rem, 0.4fr) minmax(0, 1fr);
    }

    .story__figure-list > :global(:nth-child(even)) {
      inline-size: 78%;
      margin-inline-start: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story__backlink,
    .story__related,
    .story__related-image :global(img),
    .story__related strong {
      transition: none;
    }
  }
</style>
