---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  image: ImageMetadata;
  alt: string;
  caption: string;
  creator: string;
  sourceName: string;
  sourceUrl: string;
  license: string;
  licenseUrl: string;
  alterations: string;
  eager?: boolean;
  sizes?: string;
  widths?: number[];
}

const {
  id,
  image,
  alt,
  caption,
  creator,
  sourceName,
  sourceUrl,
  license,
  licenseUrl,
  alterations,
  eager = false,
  sizes = "(min-width: 64rem) 58rem, 100vw",
  widths = [480, 768, 1024, 1440],
} = Astro.props;
---

<figure class="editorial-figure" id={id}>
  <Image
    class="editorial-figure__image"
    src={image}
    {alt}
    {widths}
    {sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
  <figcaption class="editorial-figure__caption">
    <span>{caption}</span>
    <span class="editorial-figure__rights">
      {creator}. Source: <a href={sourceUrl}>{sourceName}</a>. License:
      <a href={licenseUrl}>{license}</a>. {alterations}.
    </span>
  </figcaption>
</figure>

<style>
  .editorial-figure {
    display: grid;
    gap: var(--space-sm);
  }

  .editorial-figure__image {
    inline-size: 100%;
    block-size: auto;
    background: var(--desk-night);
  }

  .editorial-figure__caption {
    display: grid;
    gap: var(--space-xs) var(--space-xl);
    max-inline-size: 72ch;
    padding-block-start: var(--space-sm);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--quiet-ink);
    border-block-start: 1px solid var(--line-soft);
  }

  .editorial-figure__rights {
    font-size: 0.82rem;
  }

  @media (width >= 48rem) {
    .editorial-figure__caption {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
