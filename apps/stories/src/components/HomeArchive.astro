---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import AiDisclosure from "@components/AiDisclosure.astro";
import Pagination from "@components/Pagination.astro";
import StoryDirectory from "@components/StoryDirectory.astro";
import Layout from "@layouts/Layout.astro";
import { formatStoryLabel } from "@utils/storySearch";

interface Props {
  stories: CollectionEntry<"stories">[];
  currentPage: number;
  lastPage: number;
  start: number;
  end: number;
  total: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { stories, currentPage, lastPage, start, end, total, prevUrl, nextUrl } =
  Astro.props;
const isFirstPage = currentPage === 1;
const featured = isFirstPage ? stories[0] : undefined;
if (isFirstPage && !featured) {
  throw new Error("The Stories homepage requires at least one published story.");
}
const cards = featured ? stories.slice(1) : stories;
const cardStart = start + (featured ? 1 : 0);
const title = isFirstPage
  ? "MelodyMind Stories | Long-form music journalism"
  : `Stories archive — Page ${currentPage}`;
const description = isFirstPage
  ? "Sourced long-form music journalism about performers, scenes, recording technology, and the images through which music history travels."
  : `Page ${currentPage} of the MelodyMind Stories reading room.`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const image = featured
  ? new URL(featured.data.hero.image.src, Astro.site).toString()
  : undefined;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: isFirstPage ? "MelodyMind Stories" : `MelodyMind Stories — Page ${currentPage}`,
  description,
  url: canonical,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: stories.map((story, index) => ({
      "@type": "ListItem",
      position: start + index,
      url: new URL(`/${story.id}/`, Astro.site).toString(),
      name: story.data.title,
    })),
  },
};
---

<Layout
  {title}
  {description}
  {canonical}
  {image}
  imageAlt={featured?.data.hero.alt}
  imageWidth={featured?.data.hero.image.width}
  imageHeight={featured?.data.hero.image.height}
  imageType={featured
    ? featured.data.hero.image.format === "jpg"
      ? "image/jpeg"
      : `image/${featured.data.hero.image.format}`
    : undefined}
  structuredData={[collectionSchema]}
  {prevUrl}
  {nextUrl}
>
  {
    featured && (
      <section class="home-hero">
        <div class="home-hero__image reveal">
          <Image
            src={featured.data.hero.image}
            alt={featured.data.hero.alt}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 64rem) 58vw, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="home-hero__copy reveal reveal--second">
          <p class="eyebrow">
            Latest · {formatStoryLabel(featured.data.format)} ·{" "}
            <time datetime={featured.data.publishedAt.toISOString()}>
              {featured.data.publishedAt.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}
            </time>
          </p>
          <AiDisclosure
            label="AI-assisted, human-reviewed"
            detailsHref="/about/#ai-transparency"
          />
          <h1>{featured.data.title}</h1>
          <p>{featured.data.dek}</p>
          <a class="home-hero__cta" href={`/${featured.id}/`}>
            Read the story <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="home-hero__credit reveal reveal--third">
          {featured.data.hero.caption}
          {featured.data.hero.creator}.{" "}
          <a href={featured.data.hero.sourceUrl}>{featured.data.hero.sourceName}</a>,{" "}
          <a href={featured.data.hero.licenseUrl}>{featured.data.hero.license}</a>.
        </p>
      </section>
    )
  }

  <section class="archive page-shell" aria-labelledby="archive-title">
    <header class="archive__header">
      <p class="eyebrow">
        {isFirstPage ? "Reading room" : `Archive page ${currentPage} of ${lastPage}`}
      </p>
      {
        isFirstPage ? (
          <h2 id="archive-title">Stories arranged for discovery.</h2>
        ) : (
          <h1 id="archive-title">Stories archive</h1>
        )
      }
      <p>
        Search the archive, narrow it by story type, or read straight through: every story
        keeps its place in the chronological 30-per-page listing.
      </p>
    </header>

    <StoryDirectory stories={cards} totalStories={total} cardStart={cardStart} />

    <Pagination {currentPage} {lastPage} {start} {end} {total} />
  </section>

  {
    isFirstPage && (
      <aside class="home-note reading-shell">
        <p class="eyebrow">How we work</p>
        <p>
          MelodyMind Stories publishes in English, documents every image, and names the
          sources behind each article. Research and drafting use AI assistance; editorial
          claims and rights notes remain visible for readers to inspect.
        </p>
        <a class="text-link" href="/about/">
          Read the editorial method <span aria-hidden="true">→</span>
        </a>
      </aside>
    )
  }
</Layout>

<style>
  .home-hero {
    display: grid;
    min-block-size: auto;
    background: var(--desk-night);
  }

  .home-hero__image {
    block-size: clamp(13.5rem, 26svh, 15.5rem);
    min-block-size: 0;
    overflow: hidden;
  }

  .home-hero__image :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: contrast(1.04);
  }

  .home-hero__copy {
    display: grid;
    gap: var(--space-md);
    align-content: center;
    padding: clamp(1.5rem, 5vw, 3.5rem) max(1rem, calc((100vw - var(--wide-width)) / 2));
  }

  .home-hero__copy h1 {
    max-inline-size: 11ch;
    font-size: clamp(2.55rem, 11.5vw, 7.8rem);
    letter-spacing: -0.05em;
  }

  .home-hero__copy > p:not(.eyebrow) {
    max-inline-size: 54ch;
    font-size: clamp(1.12rem, 2vw, 1.4rem);
    color: var(--quiet-ink);
  }

  .home-hero__credit {
    align-self: end;
    padding: 0 1rem var(--space-md);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--quiet-ink);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .home-hero__cta {
      display: inline-flex;
      gap: var(--space-sm);
      align-items: center;
      justify-self: start;
      inline-size: fit-content;
      min-block-size: var(--control-size);
      padding: 0.65rem 1.4rem;
      font-weight: 700;
      color: var(--paper-ink);
      text-decoration: none;
      border: 1px solid color-mix(in oklch, var(--archive-teal) 40%, var(--line));
      border-radius: 999px;
      transition: none;
    }
  }

  .home-hero__cta {
    display: inline-flex;
    gap: var(--space-sm);
    align-items: center;
    justify-self: start;
    inline-size: fit-content;
    min-block-size: var(--control-size);
    padding: 0.65rem 1.4rem;
    font-weight: 700;
    color: var(--paper-ink);
    text-decoration: none;
    border: 1px solid color-mix(in oklch, var(--archive-teal) 40%, var(--line));
    border-radius: 999px;
    transition:
      color 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .home-hero__cta span {
      transition: none;
    }
  }

  .home-hero__cta span {
    transition: transform 300ms var(--ease-out);
  }

  .home-hero__cta:hover,
  .home-hero__cta:focus-visible {
    color: var(--archive-teal-strong);
    border-color: color-mix(in oklch, var(--archive-teal) 60%, var(--line));
  }

  .home-hero__cta:hover span,
  .home-hero__cta:focus-visible span {
    transform: translateX(0.3rem);
  }

  .archive {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-4xl);
    border-block-start: 1px solid var(--line);
  }

  .archive__header {
    display: grid;
    gap: var(--space-lg);
    max-inline-size: 58rem;
  }

  .archive__header h1,
  .archive__header h2 {
    max-inline-size: 13ch;
    font-size: clamp(2.6rem, 6vw, 5.4rem);
  }

  .archive__header > p:last-child {
    max-inline-size: 58ch;
    font-size: 1.1rem;
    color: var(--quiet-ink);
  }

  .home-note {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-3xl);
  }

  .home-note > p:not(.eyebrow) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.45;
  }

  @media (width >= 64rem) {
    .home-hero {
      grid-template-rows: 1fr auto;
      grid-template-columns: minmax(0, 1.3fr) minmax(30rem, 0.75fr);
      min-block-size: calc(100svh - 4.75rem);
    }

    .home-hero__image {
      grid-row: 1 / 3;
      block-size: auto;
      min-block-size: calc(100svh - 4.75rem);
    }

    .home-hero__copy,
    .home-hero__credit {
      padding-inline: clamp(3rem, 6vw, 7rem);
    }

    .home-hero__copy h1 {
      font-size: clamp(4.4rem, 5.8vw, 5.35rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__cta,
    .home-hero__cta span {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .home-hero__cta {
      border-color: ButtonText;
    }
  }
</style>
