---
type Kind = "dub-routing" | "depth-cues" | "stereo-timing" | "riff-grid";
interface Props {
  kind: Kind;
}
const { kind } = Astro.props;
const diagrams = {
  "dub-routing": {
    title: "A performable dub send-and-return path",
    items: [
      "Multitrack families",
      "Console channels",
      "Aux send",
      "Echo or reverb",
      "Return channel",
      "Stereo or mono master",
    ],
    note: "The return comes back to a controllable channel, so the mixer can mute, filter, or resend it.",
  },
  "depth-cues": {
    title: "Evidence that moves a source backward",
    items: [
      "Lower direct level",
      "Softer transient",
      "Less high-frequency detail",
      "More early reflection energy",
      "Longer room tail",
    ],
    note: "No single cue proves distance. Stable depth usually comes from several cues agreeing.",
  },
  "stereo-timing": {
    title: "Two takes remain separate performances",
    items: [
      "Take one attack",
      "Small timing difference",
      "Take two attack",
      "Opposite pan positions",
      "Mono sum check",
    ],
    note: "The offset changes from note to note. A fixed copied delay produces a different relationship.",
  },
  "riff-grid": {
    title: "The grid beneath a syncopated riff",
    items: [
      "Count sixteenths",
      "Mark attacks",
      "Mark rests",
      "Follow kick support",
      "Locate the repeat boundary",
    ],
    note: "Accents can cross the beat while the underlying subdivision remains steady.",
  },
} satisfies Record<Kind, { title: string; items: string[]; note: string }>;
const diagram = diagrams[kind];
---

<figure class="technical-diagram">
  <figcaption>{diagram.title}</figcaption>
  <ol>
    {
      diagram.items.map((item, index) => (
        <li>
          <span>{index + 1}</span>
          {item}
        </li>
      ))
    }
  </ol>
  <p>{diagram.note}</p>
</figure>

<style>
  .technical-diagram {
    padding: clamp(1rem, 4vw, 2rem);
    margin-block: 2.5rem;
    font-family: "Atkinson Hyperlegible", system-ui, sans-serif;
    background: linear-gradient(135deg, var(--night-raised), var(--night-soft));
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  figcaption {
    margin-bottom: 1rem;
    font-family: Literata, Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-height: 7rem;
    padding: 1rem;
    background: var(--night);
    border: 1px solid var(--line);
  }

  li:not(:last-child)::after {
    position: absolute;
    top: 50%;
    right: -0.62rem;
    z-index: 1;
    color: var(--oxide);
    content: "→";
    transform: translateY(-50%);
  }

  span {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    font-weight: 800;
    color: var(--night);
    background: var(--teal);
    border-radius: 50%;
  }

  p {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (width <= 35rem) {
    li:not(:last-child)::after {
      display: none;
    }
  }
</style>
