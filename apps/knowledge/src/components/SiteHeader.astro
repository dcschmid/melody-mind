---
import melodyMindLogo from "@assets/melody-mind-logo.webp";

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? current === "/"
    : !href.startsWith("https://") && current.startsWith(href);
const navigation = [
  { href: "/#issue-title", label: "Articles" },
  { href: "/editorial-standards/", label: "Standards" },
  { href: "/about/", label: "About" },
  { href: "https://melody-mind.de/", label: "Music" },
  { href: "https://quiz.melody-mind.de/", label: "Quiz" },
  { href: "https://stories.melody-mind.de/", label: "Stories" },
  { href: "https://reviews.melody-mind.de/", label: "Reviews" },
];
---

<header class="header" data-header>
  <div class="header__inner page-shell">
    <a class="header__brand" href="/" aria-label="Go to MelodyMind Knowledge">
      <img src={melodyMindLogo.src} width="150" height="50" alt="MelodyMind" />
      <span>Knowledge</span>
    </a>
    <nav class="header__desktop" aria-label="Knowledge navigation">
      {
        navigation.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <button
      class="header__button"
      type="button"
      aria-expanded="false"
      aria-controls="knowledge-menu"
      aria-label="Open navigation"
      data-menu-button><span></span><span></span></button
    >
  </div>
  <button
    class="header__backdrop"
    type="button"
    aria-label="Close navigation"
    tabindex="-1"
    hidden
    data-menu-backdrop></button>
  <nav
    class="header__mobile"
    id="knowledge-menu"
    aria-label="Mobile knowledge navigation"
    aria-hidden="true"
    data-menu
  >
    {
      navigation.map(({ href, label }) => (
        <a href={href} aria-current={isActive(href) ? "page" : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const init = () => {
    document.querySelectorAll<HTMLElement>("[data-header]").forEach((header) => {
      if (header.dataset.bound === "true") {
        return;
      }
      header.dataset.bound = "true";
      const button = header.querySelector<HTMLButtonElement>("[data-menu-button]");
      const menu = header.querySelector<HTMLElement>("[data-menu]");
      const backdrop = header.querySelector<HTMLButtonElement>("[data-menu-backdrop]");
      if (!button || !menu || !backdrop) {
        return;
      }
      const controller = new AbortController();
      const { signal } = controller;
      const regions = Array.from(document.querySelectorAll<HTMLElement>("main, footer"));
      const setOpen = (open: boolean, restoreFocus = true) => {
        header.dataset.open = String(open);
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
        menu.setAttribute("aria-hidden", String(!open));
        backdrop.hidden = !open;
        document.body.classList.toggle("menu-open", open);
        regions.forEach((region) => {
          region.inert = open;
        });
        if (open) {
          requestAnimationFrame(() => menu.querySelector<HTMLElement>("a")?.focus());
        } else if (restoreFocus) {
          button.focus();
        }
      };
      button.addEventListener(
        "click",
        () => setOpen(button.getAttribute("aria-expanded") !== "true"),
        { signal }
      );
      backdrop.addEventListener("click", () => setOpen(false), { signal });
      menu
        .querySelectorAll("a")
        .forEach((link) =>
          link.addEventListener("click", () => setOpen(false, false), { signal })
        );
      document.addEventListener(
        "keydown",
        (event) => {
          if (button.getAttribute("aria-expanded") !== "true") {
            return;
          }
          if (event.key === "Escape") {
            return setOpen(false);
          }
          if (event.key !== "Tab") {
            return;
          }
          const focusable = [button, ...menu.querySelectorAll<HTMLElement>("a[href]")];
          if (event.shiftKey && document.activeElement === focusable[0]) {
            event.preventDefault();
            focusable.at(-1)?.focus();
          } else if (!event.shiftKey && document.activeElement === focusable.at(-1)) {
            event.preventDefault();
            focusable[0]?.focus();
          }
        },
        { signal }
      );
      window
        .matchMedia("(width >= 56rem)")
        .addEventListener("change", (event) => event.matches && setOpen(false, false), {
          signal,
        });
      document.addEventListener(
        "astro:before-swap",
        () => {
          setOpen(false, false);
          controller.abort();
        },
        { once: true, signal }
      );
    });
  };
  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--night) 95%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(1rem);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
  }

  .header__brand {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    min-height: var(--control);
    color: var(--ink);
    text-decoration: none;
  }

  .header__brand img {
    width: clamp(8.75rem, 10.5vw, 10.75rem);
    height: auto;
  }

  .header__brand span {
    padding-left: 0.8rem;
    color: var(--muted);
    border-left: 1px solid var(--line);
  }

  .header__desktop {
    display: flex;
    align-self: stretch;
  }

  .header__desktop a {
    display: flex;
    align-items: center;
    min-height: var(--control);
    padding-inline: 0.72rem;
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--muted);
    text-decoration: none;
  }

  .header__desktop a[aria-current="page"] {
    color: var(--teal);
  }

  .header__button {
    display: none;
    width: var(--control);
    height: var(--control);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .header__button span {
      display: block;
      width: 1.25rem;
      height: 2px;
      margin: 0.3rem auto;
      background: currentcolor;
      transition: none;
    }
  }

  .header__button span {
    display: block;
    width: 1.25rem;
    height: 2px;
    margin: 0.3rem auto;
    background: currentcolor;
    transition: transform 160ms ease;
  }

  .header[data-open="true"] .header__button span:first-child {
    transform: translateY(0.25rem) rotate(45deg);
  }

  .header[data-open="true"] .header__button span:last-child {
    transform: translateY(-0.25rem) rotate(-45deg);
  }

  .header__backdrop {
    position: fixed;
    inset: 4.75rem 0 0;
    z-index: -1;
    width: 100%;
    height: calc(100dvh - 4.75rem);
    padding: 0;
    background: rgb(2 5 10 / 72%);
    border: 0;
  }

  .header__backdrop[hidden] {
    display: none;
  }

  .header__mobile {
    position: absolute;
    inset: calc(100% + 1px) 0 auto;
    display: grid;
    visibility: hidden;
    padding: 1rem;
    background: var(--night-raised);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(-0.5rem);
  }

  .header__mobile a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: 0.75rem;
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .header[data-open="true"] .header__mobile {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  @media (width < 56rem) {
    .header__desktop {
      display: none;
    }

    .header__button {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__button span,
    .header__mobile {
      transition: none;
    }
  }
</style>
