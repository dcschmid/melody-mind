<section class="pilot" data-rhythm-pilot>
  <header>
    <p class="eyebrow">Interactive score</p><h3>Build the rhythm section</h3><p>
      Switch the original drum, bass, and guitar parts on or off. Playback begins only
      when you press Play.
    </p>
  </header>
  <fieldset>
    <legend>Parts</legend><label
      ><input type="checkbox" name="drums" checked /> Drums</label
    ><label><input type="checkbox" name="bass" checked /> Bass</label><label
      ><input type="checkbox" name="guitar" checked /> Guitar</label
    >
  </fieldset>
  <button type="button" data-play disabled>Play selected parts</button><button
    type="button"
    data-stop
    disabled>Stop</button
  >
  <p data-status role="status">Loading the optional player…</p><div
    data-score
    aria-label="Notation for the selected rhythm-section parts"
  >
  </div>
  <noscript
    ><p>
      JavaScript is off. The static LilyPond score below contains the same three-part
      example and the article explains how to compare each line.
    </p></noscript
  >
</section>
<script>
  import ABCJS from "abcjs";
  const tune = {
    drums:
      "V:D clef=perc name=Drums\n[D,,A,,]2 z2 [D,,A,,]2 A,,2 | [D,,A,,]2 A,,2 [D,,A,,]2 z2 |",
    bass: "V:B clef=bass name=Bass\nE,2 E,2 G,2 A,2 | E,2 z2 B,,2 D,2 |",
    guitar:
      "V:G clef=treble-8 name=Guitar\n[E,B,E]2 z2 [G,DG]2 [A,EA]2 | [E,B,E]2 [G,DG]2 [B,F,B]2 z2 |",
  };
  for (const root of document.querySelectorAll<HTMLElement>("[data-rhythm-pilot]")) {
    const score = root.querySelector<HTMLElement>("[data-score]");
    const play = root.querySelector<HTMLButtonElement>("[data-play]");
    const stop = root.querySelector<HTMLButtonElement>("[data-stop]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    if (!score || !play || !stop || !status) {
      continue;
    }
    let synth: InstanceType<typeof ABCJS.synth.CreateSynth> | undefined;
    let visual: ReturnType<typeof ABCJS.renderAbc>[number] | undefined;
    const selectedParts = () =>
      [...root.querySelectorAll<HTMLInputElement>("input:checked")].map(
        (input) => input.name as keyof typeof tune
      );
    const notation = () =>
      `X:1\nT:Original rock motion study\nM:4/4\nL:1/8\nQ:1/4=104\nK:Em\n%%score ${selectedParts()
        .map((name) => name[0].toUpperCase())
        .join(" ")}\n${selectedParts()
        .map((name) => tune[name])
        .join("\n")}`;
    const render = () => {
      synth?.stop();
      const selected = root.querySelectorAll("input:checked").length;
      if (!selected) {
        score.innerHTML = "<p>Select at least one part.</p>";
        play.disabled = true;
        return;
      }
      visual = ABCJS.renderAbc(score, notation(), {
        responsive: "resize",
        add_classes: true,
      })[0];
      play.disabled = false;
      stop.disabled = false;
      status.textContent = "Ready. Audio has not started.";
    };
    root.addEventListener("change", render);
    play.addEventListener("click", async () => {
      if (!visual) {
        return;
      }
      play.disabled = true;
      status.textContent = "Preparing audio…";
      synth?.stop();
      synth = new ABCJS.synth.CreateSynth();
      try {
        await synth.init({ visualObj: visual });
        await synth.prime();
        synth.start();
        status.textContent = "Playing selected parts.";
      } catch {
        status.textContent =
          "Audio could not start on this device. The notation remains available.";
      } finally {
        play.disabled = false;
      }
    });
    stop.addEventListener("click", () => {
      synth?.stop();
      status.textContent = "Stopped.";
    });
    render();
  }
</script>
<style>
  .pilot {
    padding: 1.5rem;
    margin-block: 2.5rem;
    background: var(--night-raised);
    border: 1px solid var(--line);
  }

  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0;
    margin-block: 1rem;
    border: 0;
  }

  legend {
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  label {
    display: flex;
    gap: 0.45rem;
    align-items: center;
  }

  button {
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    margin: 0 0.5rem 0.75rem 0;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--teal);
    border-radius: 0.2rem;
  }

  button:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 3px;
  }

  button:disabled {
    opacity: 0.5;
  }

  [data-status] {
    font-size: 0.85rem;
    color: var(--muted);
  }

  [data-score] {
    overflow-x: auto;
    color: #111;
    background: #fff;
  }
</style>
