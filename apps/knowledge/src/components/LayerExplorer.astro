---
interface Props {
  preset?: "full" | "reverb" | "delay" | "feedback" | "bass" | "version" | "guitar";
  compact?: boolean;
  set?: "dub-space" | "guitar-width";
}
const {
  preset = "full",
  compact = false,
  set = preset === "guitar" ? "guitar-width" : "dub-space",
} = Astro.props;
const layers =
  set === "guitar-width"
    ? ["drums", "bass", "guitar-left", "guitar-right", "room"]
    : ["rhythm", "bass", "harmony", "melody", "effects"];
---

<section
  class:list={["explorer", compact && "explorer--compact"]}
  data-layer-explorer
  data-preset={preset}
  data-audio-set={set}
  data-layers={layers.join(",")}
  aria-labelledby={`explorer-${preset}`}
>
  <header>
    <p class="eyebrow">Original audio example</p><h2 id={`explorer-${preset}`}>
      Hear what each layer contributes
    </h2><p>
      The five stems share one clock. Switching a layer off changes the arrangement
      without restarting the loop.
    </p>
  </header>
  <div class="explorer__transport">
    <button class="button" type="button" data-play>Play loop</button><button
      class="button button--secondary"
      type="button"
      data-reset>Reset</button
    ><span data-time aria-live="off">00:00 / 00:08</span>
  </div>
  <div class="explorer__wave" aria-hidden="true">
    {
      Array.from({ length: 24 }, (_, index) => (
        <i style={`--level:${20 + ((index * 17) % 65)}%`} />
      ))
    }
  </div>
  <div class="explorer__layers">
    {
      layers.map((layer) => (
        <button type="button" aria-pressed="true" data-layer={layer}>
          <>
            <span aria-hidden="true" />
            <strong>{layer[0].toUpperCase() + layer.slice(1)}</strong>
          </>
        </button>
      ))
    }
  </div>
  <p class="explorer__status" data-status role="status">
    Audio loads only after you press play.
  </p>
  <noscript
    ><audio controls preload="none" src="/audio/dub-space/full-mix.wav"
      ><track
        kind="captions"
        src="/audio/no-speech.vtt"
        srclang="en"
        label="English"
      />Your browser cannot play the original audio example.</audio
    ><p>
      The interactive layer switches require JavaScript. The full mix remains available.
    </p></noscript
  >
</section>
<script>
  const initializeExplorers = () => {
    document.querySelectorAll<HTMLElement>("[data-layer-explorer]").forEach((root) => {
      if (root.dataset.bound) {
        return;
      }
      root.dataset.bound = "true";
      const play = root.querySelector<HTMLButtonElement>("[data-play]");
      const reset = root.querySelector<HTMLButtonElement>("[data-reset]");
      const status = root.querySelector<HTMLElement>("[data-status]");
      const time = root.querySelector<HTMLElement>("[data-time]");
      if (!play || !reset || !status || !time) {
        return;
      }
      let context: AudioContext | undefined;
      let buffers: AudioBuffer[] = [];
      let sources: AudioBufferSourceNode[] = [];
      let gains: GainNode[] = [];
      let startedAt = 0;
      let offset = 0;
      let playing = false;
      let frame = 0;
      const layerNames = root.dataset.layers!.split(",");
      const audioSet = root.dataset.audioSet;
      const format = (seconds: number) =>
        `00:${String(Math.floor(seconds) % 8).padStart(2, "0")} / 00:08`;
      const updateTime = () => {
        if (!playing || !context) {
          return;
        }
        time.textContent = format(offset + context.currentTime - startedAt);
        frame = requestAnimationFrame(updateTime);
      };
      const load = async () => {
        if (buffers.length) {
          return;
        }
        status.textContent = "Loading five original audio layers…";
        context = new AudioContext();
        const responses = await Promise.all(
          layerNames.map((name) => fetch(`/audio/${audioSet}/${name}.wav`))
        );
        if (responses.some((response) => !response.ok)) {
          throw new Error("One or more layers could not be loaded.");
        }
        buffers = await Promise.all(
          responses.map(async (response) =>
            context!.decodeAudioData(await response.arrayBuffer())
          )
        );
      };
      const stopSources = () => {
        sources.forEach((source) => {
          try {
            source.stop();
          } catch {
            // A source may already have reached its stop state.
          }
        });
        sources = [];
      };
      const start = async () => {
        try {
          await load();
          await context!.resume();
          stopSources();
          gains = [];
          startedAt = context!.currentTime;
          sources = buffers.map((buffer, index) => {
            const source = context!.createBufferSource();
            const gain = context!.createGain();
            source.buffer = buffer;
            source.loop = true;
            gain.gain.value =
              root.querySelector<HTMLButtonElement>(`[data-layer="${layerNames[index]}"]`)
                ?.ariaPressed === "false"
                ? 0
                : 1;
            source.connect(gain).connect(context!.destination);
            source.start(0, offset % buffer.duration);
            gains.push(gain);
            return source;
          });
          playing = true;
          play.textContent = "Pause loop";
          status.textContent =
            "Loop playing. Use the layer switches to change the arrangement.";
          updateTime();
        } catch (error) {
          status.textContent =
            error instanceof Error ? error.message : "The audio example could not start.";
        }
      };
      const pause = () => {
        if (!context) {
          return;
        }
        offset = (offset + context.currentTime - startedAt) % 8;
        playing = false;
        cancelAnimationFrame(frame);
        stopSources();
        play.textContent = "Resume loop";
        status.textContent = "Loop paused.";
      };
      play.addEventListener("click", () => (playing ? pause() : start()));
      reset.addEventListener("click", () => {
        offset = 0;
        if (playing) {
          stopSources();
          playing = false;
          start();
        }
        time.textContent = format(0);
        root
          .querySelectorAll<HTMLButtonElement>("[data-layer]")
          .forEach((button, index) => {
            button.ariaPressed = "true";
            gains[index]?.gain.setValueAtTime(1, context?.currentTime ?? 0);
          });
        status.textContent = "All layers restored.";
      });
      root.querySelectorAll<HTMLButtonElement>("[data-layer]").forEach((button, index) =>
        button.addEventListener("click", () => {
          const active = button.ariaPressed !== "true";
          button.ariaPressed = String(active);
          gains[index]?.gain.setTargetAtTime(
            active ? 1 : 0,
            context?.currentTime ?? 0,
            0.015
          );
          status.textContent = `${button.dataset.layer} ${active ? "on" : "off"}.`;
        })
      );
    });
  };
  initializeExplorers();
  document.addEventListener("astro:page-load", initializeExplorers);
</script>
<style>
  .explorer {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--night-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .explorer header h2 {
    margin: 0.4rem 0;
  }

  .explorer header p:last-child,
  .explorer__status,
  .explorer__transport span {
    color: var(--muted);
  }

  .explorer__transport {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .explorer__wave {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    height: 5rem;
  }

  .explorer__wave i {
    flex: 1;
    height: var(--level);
    background: var(--teal);
    opacity: 0.78;
  }

  .explorer__layers {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.6rem;
  }

  .explorer__layers button {
    display: grid;
    gap: 0.5rem;
    min-height: 4.5rem;
    padding: 0.75rem;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    background: var(--night);
    border: 1px solid var(--line);
    border-radius: 0.45rem;
  }

  .explorer__layers button span {
    width: 2rem;
    height: 1.1rem;
    padding: 0.15rem;
    background: var(--teal);
    border-radius: 999px;
  }

  .explorer__layers button span::after {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
    margin-left: 0.9rem;
    content: "";
    background: var(--night);
    border-radius: 50%;
  }

  .explorer__layers button[aria-pressed="false"] {
    color: var(--muted);
    opacity: 0.75;
  }

  .explorer__layers button[aria-pressed="false"] span {
    background: var(--line);
  }

  .explorer__layers button[aria-pressed="false"] span::after {
    margin-left: 0;
  }

  .explorer__status {
    min-height: 1.6rem;
    margin: 0;
    font-size: 0.85rem;
  }

  @media (width<42rem) {
    .explorer__layers {
      grid-template-columns: 1fr 1fr;
    }

    .explorer__wave {
      height: 3.5rem;
    }
  }
</style>
