---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
const { headings } = Astro.props as { headings: Heading[] };
const chapters = headings.filter(({ depth, text }) => depth === 2 && text !== "Endnotes");
---

{
  chapters.length > 1 && (
    <nav class="toc" aria-labelledby="toc-title">
      <>
        <h2 id="toc-title">In this article</h2>
        <ol>
          {chapters.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </>
    </nav>
  )
}
<style>
  .toc {
    padding: 1.25rem 0;
    border-block: 1px solid var(--line);
  }

  .toc h2 {
    font-size: 1rem;
  }

  .toc ol {
    columns: 2;
    padding-inline-start: 1.25rem;
  }

  .toc li {
    margin-block: 0.35rem;
    break-inside: avoid;
  }

  @media (width < 40rem) {
    .toc ol {
      columns: 1;
    }
  }
</style>
