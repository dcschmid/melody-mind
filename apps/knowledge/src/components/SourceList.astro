---
interface Source {
  id: string;
  title: string;
  type: "book" | "journal" | "interview" | "archive" | "website";
  author?: string;
  publisher: string;
  publishedAt?: string;
  url?: string;
  accessedAt?: Date;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

<section class="sources reading-shell" aria-labelledby="sources-title">
  <p class="eyebrow">Documentation</p><h2 id="sources-title">
    Sources and further reading
  </h2><ol>
    {
      sources.map((source) => (
        <li id={`source-${source.id}`}>
          {source.url ? (
            <a href={source.url}>{source.title}</a>
          ) : (
            <cite>{source.title}</cite>
          )}
          {source.author && `, ${source.author}`}, {source.publisher}
          {source.publishedAt && `, ${source.publishedAt}`}
          {source.accessedAt && (
            <Fragment>
              . Accessed{" "}
              <time datetime={source.accessedAt.toISOString()}>
                {source.accessedAt.toLocaleDateString("en-US", {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                })}
              </time>
            </Fragment>
          )}
          .
        </li>
      ))
    }
  </ol>
</section>
<style>
  .sources {
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  .sources ol {
    padding-left: 1.25rem;
  }

  .sources li {
    margin-bottom: 1rem;
    color: var(--muted);
  }
</style>
