---
type Preset =
  | "bass-versions"
  | "gothic-metal"
  | "metal-riff"
  | "punk-attack"
  | "double-tracking"
  | "rock-section"
  | "piano-registers"
  | "orchestral-layers";

interface Props {
  preset: Preset;
}

const { preset } = Astro.props;
const copy = {
  "bass-versions": {
    title: "Bass, kick, and harmony",
    description:
      "Switch the foundation parts independently and compare what survives subtraction.",
    parts: ["Bass", "Kick", "Harmony"],
  },
  "gothic-metal": {
    title: "Bass-led and riff-led arrangements",
    description:
      "Compare a melodic gothic-rock bass ostinato with a denser metal guitar frame.",
    parts: ["Goth bass", "Metal guitars", "Drums"],
  },
  "metal-riff": {
    title: "Open, muted, and displaced attacks",
    description:
      "Isolate three articulation layers built from the same eighth-note grid.",
    parts: ["Open", "Palm-muted", "Displaced accents"],
  },
  "punk-attack": {
    title: "Downstrokes, accents, and the stop",
    description:
      "Hear continuous motion, a changed accent pattern, and the silence that closes the phrase.",
    parts: ["Downstrokes", "Accents", "Drums"],
  },
  "double-tracking": {
    title: "Two performances, one part",
    description:
      "Switch two independently written takes on and off. The second enters with small timing differences.",
    parts: ["Take one", "Take two"],
  },
  "rock-section": {
    title: "Build the rhythm section",
    description:
      "Switch the drum, bass, and guitar parts on or off without changing the tempo.",
    parts: ["Drums", "Bass", "Guitar"],
  },
  "piano-registers": {
    title: "One harmony across three piano registers",
    description:
      "Switch the bass foundation, middle-register harmony, and upper melody independently.",
    parts: ["Bass register", "Middle harmony", "Upper melody"],
  },
  "orchestral-layers": {
    title: "Four schematic orchestral layers",
    description:
      "Isolate strings, woodwinds, brass, and percussion in one short original phrase.",
    parts: ["Strings", "Woodwinds", "Brass", "Percussion"],
  },
} satisfies Record<Preset, { title: string; description: string; parts: string[] }>;
const selected = copy[preset];
---

<section class="arrangement" data-arrangement-explorer data-preset={preset}>
  <header>
    <p class="eyebrow">Interactive score</p>
    <h3>{selected.title}</h3>
    <p>{selected.description} Playback begins only when you press Play.</p>
  </header>
  <fieldset>
    <legend>Parts</legend>
    {
      selected.parts.map((part, index) => (
        <label>
          <input type="checkbox" name={`part-${index}`} checked /> {part}
        </label>
      ))
    }
  </fieldset>
  <div class="arrangement__actions">
    <button type="button" data-play disabled>Play selected parts</button>
    <button type="button" data-stop disabled>Stop</button>
  </div>
  <p data-status role="status">Loading the optional player…</p>
  <div data-score aria-label={`Notation for ${selected.title.toLowerCase()}`}></div>
  <noscript>
    <p>
      JavaScript is off. The static LilyPond score next to this explorer contains the same
      parts, and the surrounding text explains the comparison.
    </p>
  </noscript>
</section>

<script>
  import ABCJS from "abcjs";
  import { ABCJS_SOUNDFONT_URL } from "../utils/audio";

  const presets = {
    "bass-versions": {
      title: "Bass, kick, and harmony",
      tempo: 76,
      key: "Em",
      voices: [
        "V:A clef=bass name=Bass\n%%MIDI program 33\nE,2 z E, G,2 A,2 | E,2 z2 B,,2 D,2 |",
        "V:B clef=perc name=Kick\n%%MIDI channel 10\nC2 z2 C2 z2 | C2 z C z2 C2 |",
        "V:C clef=treble name=Harmony\n%%MIDI program 18\n[EGB]4 z4 | [DFA]2 z2 [EGB]4 |",
      ],
    },
    "gothic-metal": {
      title: "Bass-led and riff-led arrangements",
      tempo: 108,
      key: "Dm",
      voices: [
        "V:A clef=bass name=GothBass\n%%MIDI program 33\nD, A, D, A, F, C F, C | D, A, D, A, G, D G, D |",
        "V:B clef=treble-8 name=MetalGuitars\n%%MIDI program 30\n[D,A,D]2 z [D,A,D] [F,C,F]2 [G,D,G]2 | [D,A,D] [D,A,D] z2 [A,E,A]4 |",
        "V:C clef=perc name=Drums\n%%MIDI channel 10\n[CF]2 F2 [DF]2 F2 | [CF]2 F2 [DF]2 z2 |",
      ],
    },
    "metal-riff": {
      title: "Open, muted, and displaced attacks",
      tempo: 132,
      key: "Em",
      voices: [
        "V:A clef=treble-8 name=Open\n%%MIDI program 30\n[E,B,E]2 z2 [G,D,G]2 [E,B,E]2 | [E,B,E]2 [B,F,B]2 z2 [D,A,D]2 |",
        "V:B clef=treble-8 name=Muted\n%%MIDI program 28\nE, E, z E, E, E, z E, | E, E, E, z E, z E, E, |",
        "V:C clef=perc name=Accents\n%%MIDI channel 10\nC2 z F C2 F2 | z C2 F z D2 F |",
      ],
    },
    "punk-attack": {
      title: "Downstrokes, accents, and the stop",
      tempo: 176,
      key: "E",
      voices: [
        "V:A clef=treble-8 name=Downstrokes\n%%MIDI program 29\n[E,B,E] [E,B,E] [E,B,E] [E,B,E] [G,D,G] [G,D,G] [A,E,A] [A,E,A] | [E,B,E] [E,B,E] [G,D,G] [G,D,G] [B,F,B]2 z2 |",
        "V:B clef=treble-8 name=Accents\n%%MIDI program 30\n[E,B,E]2 [E,B,E] [E,B,E] [G,D,G]2 [A,E,A]2 | [E,B,E] [E,B,E] [G,D,G]2 [B,F,B]2 z2 |",
        "V:C clef=perc name=Drums\n%%MIDI channel 10\n[CF]2 F2 [DF]2 F2 | [CF]2 F2 [DF]2 z2 |",
      ],
    },
    "double-tracking": {
      title: "Two performances, one part",
      tempo: 112,
      key: "Em",
      voices: [
        "V:A clef=treble-8 name=TakeOne\n%%MIDI program 29\n[E,B,E]2 z [G,D,G] [A,E,A]2 [E,B,E]2 | [E,B,E]2 [G,D,G]2 [B,F,B]2 z2 |",
        "V:B clef=treble-8 name=TakeTwo\n%%MIDI program 29\nz/2 [E,B,E]3/2 z [G,D,G] [A,E,A]2 [E,B,E]2 | [E,B,E]3/2 z/2 [G,D,G]2 [B,F,B]2 z2 |",
      ],
    },
    "rock-section": {
      title: "Build the rhythm section",
      tempo: 104,
      key: "Em",
      voices: [
        "V:A clef=perc name=Drums\n%%MIDI channel 10\n[CF]2 F2 [DF]2 F2 | [CF]2 F2 [DF]2 z2 |",
        "V:B clef=bass name=Bass\n%%MIDI program 33\nE,2 E,2 G,2 A,2 | E,2 z2 B,,2 D,2 |",
        "V:C clef=treble-8 name=Guitar\n%%MIDI program 29\n[E,B,E]2 z2 [G,D,G]2 [A,E,A]2 | [E,B,E]2 [G,D,G]2 [B,F,B]2 z2 |",
      ],
    },
    "piano-registers": {
      title: "One harmony across three piano registers",
      tempo: 72,
      key: "C",
      voices: [
        "V:A clef=bass name=Bass\n%%MIDI program 0\nC,,4 G,,4 | A,,4 F,,4 |",
        "V:B clef=treble name=Middle\n%%MIDI program 0\n[CEG]4 [DGB]4 | [CEA]4 [CFA]4 |",
        "V:C clef=treble name=Melody\n%%MIDI program 0\nG2 A B2 G2 | E2 G A4 |",
      ],
    },
    "orchestral-layers": {
      title: "Four schematic orchestral layers",
      tempo: 84,
      key: "Dm",
      voices: [
        "V:A clef=treble name=Strings\n%%MIDI program 48\n[DFA]4 [CEG]4 | [B,DF]4 [A,CE]4 |",
        "V:B clef=treble name=Woodwinds\n%%MIDI program 68\nA2 G F2 A2 | D2 E F4 |",
        "V:C clef=treble name=Brass\n%%MIDI program 60\nD4 z4 | [A,CE]4 [DFA]4 |",
        "V:D clef=perc name=Percussion\n%%MIDI channel 10\nC4 z4 | C2 z2 D4 |",
      ],
    },
  } as const;

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-arrangement-explorer]"
  )) {
    if (root.dataset.ready === "true") {
      continue;
    }
    root.dataset.ready = "true";
    const preset = presets[root.dataset.preset as keyof typeof presets];
    const score = root.querySelector<HTMLElement>("[data-score]");
    const play = root.querySelector<HTMLButtonElement>("[data-play]");
    const stop = root.querySelector<HTMLButtonElement>("[data-stop]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    if (!preset || !score || !play || !stop || !status) {
      continue;
    }
    let synth: InstanceType<typeof ABCJS.synth.CreateSynth> | undefined;
    let visual: ReturnType<typeof ABCJS.renderAbc>[number] | undefined;
    const selectedIndexes = () =>
      [...root.querySelectorAll<HTMLInputElement>("input:checked")].map((input) =>
        Number(input.name.replace("part-", ""))
      );
    const notation = () => {
      const indexes = selectedIndexes();
      const scoreOrder = indexes
        .map((index) => String.fromCharCode(65 + index))
        .join(" ");
      return `X:1\nT:${preset.title}\nM:4/4\nL:1/8\nQ:1/4=${preset.tempo}\nK:${preset.key}\n%%percmap C 36 normal\n%%percmap D 38 normal\n%%percmap F 42 x\n%%score ${scoreOrder}\n${indexes
        .map((index) => preset.voices[index])
        .join("\n")}`;
    };
    const render = () => {
      synth?.stop();
      if (!selectedIndexes().length) {
        score.innerHTML = "<p>Select at least one part.</p>";
        play.disabled = true;
        stop.disabled = true;
        return;
      }
      visual = ABCJS.renderAbc(score, notation(), {
        responsive: "resize",
        add_classes: true,
      })[0];
      play.disabled = false;
      stop.disabled = false;
      status.textContent = "Ready. Audio has not started.";
    };
    root.addEventListener("change", render);
    play.addEventListener("click", async () => {
      if (!visual) {
        return;
      }
      play.disabled = true;
      status.textContent = "Preparing audio…";
      synth?.stop();
      synth = new ABCJS.synth.CreateSynth();
      try {
        await synth.init({
          visualObj: visual,
          options: { soundFontUrl: ABCJS_SOUNDFONT_URL },
        });
        await synth.prime();
        synth.start();
        status.textContent = "Playing selected parts.";
      } catch {
        status.textContent =
          "Audio samples could not load. Check your connection and audio permissions; the notation remains available.";
      } finally {
        play.disabled = false;
      }
    });
    stop.addEventListener("click", () => {
      synth?.stop();
      status.textContent = "Stopped.";
    });
    render();
  }
</script>

<style>
  .arrangement {
    padding: 1.5rem;
    margin-block: 2.5rem;
    font-family: "Atkinson Hyperlegible", system-ui, sans-serif;
    background: var(--night-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .arrangement h3 {
    margin-block: 0.4rem 0;
  }

  fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding: 0;
    margin-block: 1rem;
    border: 0;
  }

  legend {
    width: 100%;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  label {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    min-height: 2.75rem;
  }

  .arrangement__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  button {
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    color: var(--ink);
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--teal);
    border-radius: 999px;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  [data-status] {
    font-size: 0.85rem;
    color: var(--muted);
  }

  [data-score] {
    overflow-x: auto;
    color: #111;
    background: #fff;
  }
</style>
