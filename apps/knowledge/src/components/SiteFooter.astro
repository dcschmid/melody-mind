---
import melodyMindLogo from "@assets/melody-mind-logo.webp";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner page-shell">
    <div class="footer__brand">
      <a href="/" aria-label="Go to MelodyMind Knowledge"
        ><img
          src={melodyMindLogo.src}
          width="166"
          height="55"
          alt="MelodyMind"
          loading="lazy"
        /></a
      ><p>
        Research-led guides that connect musical history and production to attentive
        listening.
      </p>
    </div>
    <div class="footer__groups">
      <section>
        <h2>Knowledge</h2><nav aria-label="Explore Knowledge">
          <a href="/">Articles</a><a href="/editorial-standards/">Editorial standards</a
          ><a href="/about/">About</a><a href="/rss.xml">RSS</a>
        </nav>
      </section>
      <section>
        <h2>MelodyMind</h2><nav aria-label="MelodyMind apps">
          <a href="https://melody-mind.de/">Music</a><a
            href="https://quiz.melody-mind.de/">Quiz</a
          ><a href="https://stories.melody-mind.de/">Stories</a><a
            href="https://reviews.melody-mind.de/">Reviews</a
          >
        </nav>
      </section>
      <section>
        <h2>Editorial & legal</h2><nav aria-label="Editorial and legal information">
          <a href="/about/#ai-transparency">AI transparency</a><a
            href="https://melody-mind.de/imprint/">Legal Notice</a
          ><a href="https://melody-mind.de/privacy/">Privacy Policy</a><a
            href="https://melody-mind.de/cookies/">Storage Policy</a
          >
        </nav>
      </section>
    </div>
    <p class="footer__bottom">
      © {year} MelodyMind. Central legal notices cover the Knowledge domain.
    </p>
  </div>
</footer>
<style>
  .footer {
    padding-block: 2.5rem 1rem;
    margin-top: 5rem;
    background: var(--night-raised);
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) minmax(0, 1.7fr);
    gap: 2rem;
  }

  .footer__brand {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .footer__brand a {
    width: fit-content;
  }

  .footer__brand img {
    width: clamp(8.2rem, 14vw, 10.4rem);
    height: auto;
  }

  .footer p {
    max-width: 45ch;
    margin: 0;
    color: var(--muted);
  }

  .footer__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .footer section,
  .footer nav {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .footer h2 {
    margin: 0;
    font:
      800 0.75rem/1.2 system-ui,
      sans-serif;
    color: var(--teal);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer a {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 2.5rem;
    color: var(--muted);
    text-decoration: none;
  }

  .footer a:hover,
  .footer a:focus-visible {
    color: var(--teal);
  }

  .footer__bottom {
    grid-column: 1 / -1;
    max-width: none !important;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  @media (width < 48rem) {
    .footer__inner {
      grid-template-columns: 1fr;
    }

    .footer__groups {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      grid-column: auto;
    }
  }
</style>
