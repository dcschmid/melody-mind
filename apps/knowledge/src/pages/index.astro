---
import HomeArchive from "@components/HomeArchive.astro";
import { getPublishedArticles } from "@utils/archive";
import { getArchivePageSlice } from "@utils/archivePagination";

const articles = await getPublishedArticles();
const page = getArchivePageSlice(articles, 1);
---

<HomeArchive articles={page.data} {...page} />
