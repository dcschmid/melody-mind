{
  "name": "reviews",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sourced album criticism from MelodyMind",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-content.mjs && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "pnpm format && pnpm exec eslint --config ../../eslint.config.mjs --fix \"src/**/*.{js,ts,astro}\" && pnpm stylelint",
    "lint:check": "pnpm exec eslint --config ../../eslint.config.mjs \"src/**/*.{js,ts,astro}\" && pnpm stylelint:check",
    "format": "pnpm exec prettier --write \"src/**/*.{js,ts,astro,md,mdx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.{js,ts,astro,md,mdx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "stylelint": "pnpm exec stylelint --config ../../stylelint.config.cjs --fix \"src/**/*.{astro,css}\"",
    "stylelint:check": "pnpm exec stylelint --config ../../stylelint.config.cjs \"src/**/*.{astro,css}\" --quiet",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "astro-minify-html-swc": "^0.1.12",
    "lightningcss": "^1.33.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "js-yaml": "^5.2.3",
    "vitest": "^4.1.10"
  }
}
