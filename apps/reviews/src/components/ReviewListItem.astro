---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import { getReviewCoverImage } from "@utils/reviewImages";

interface Props {
  review: CollectionEntry<"reviews">;
}

const { review } = Astro.props;
const coverAsset =
  review.data.cover.mode === "original"
    ? getReviewCoverImage(review.data.cover.src)
    : undefined;
const publishedAt = review.data.publishedAt.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<li class="review-list-item">
  <a href={`/reviews/${review.id}/`}>
    <span class="review-list-item__cover">
      {
        coverAsset ? (
          <Image
            src={coverAsset}
            alt=""
            width={640}
            height={640}
            loading="lazy"
            sizes="(max-width: 47.99rem) 5.25rem, 6.5rem"
          />
        ) : (
          <span class="review-list-item__typographic" aria-hidden="true">
            <span>{review.data.album.title}</span>
            <small>{review.data.album.artist}</small>
          </span>
        )
      }
    </span>
    <span class="review-list-item__identity">
      <span class="review-list-item__genre">{review.data.album.genres[0]}</span>
      <time
        class="review-list-item__date"
        datetime={review.data.publishedAt.toISOString()}
      >
        {publishedAt}
      </time>
      <h3>{review.data.album.title}</h3>
      <strong>{review.data.album.artist}</strong>
    </span>
    <span class="review-list-item__thesis">{review.data.thesis}</span>
    <span class="review-list-item__arrow" aria-hidden="true">→</span>
  </a>
</li>
