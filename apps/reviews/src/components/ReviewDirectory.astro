---
import type { CollectionEntry } from "astro:content";

import ReviewListItem from "@components/ReviewListItem.astro";

interface Props {
  reviews: CollectionEntry<"reviews">[];
  searchable?: boolean;
  mainGenres?: string[];
  totalReviews?: number;
}

const {
  reviews,
  searchable = false,
  mainGenres = [],
  totalReviews = reviews.length,
} = Astro.props;
---

<section
  class="review-directory"
  data-review-directory
  data-searchable={searchable ? "true" : "false"}
  data-index-url="/review-search-index.json"
>
  {
    searchable && (
      <div class="review-directory__controls" data-review-controls hidden>
        <form class="review-directory__search" role="search" data-review-search-form>
          <label for="review-archive-search">Search the review archive</label>
          <div class="review-directory__search-row">
            <input
              id="review-archive-search"
              type="search"
              name="q"
              autocomplete="off"
              placeholder="Album, artist, genre, or argument"
              data-review-search-input
            />
            <button
              type="button"
              class="review-directory__clear"
              data-review-search-clear
              hidden
            >
              Clear
            </button>
          </div>
        </form>

        <div class="review-directory__filters">
          <p id="review-main-genre-filter-label">Filter by genre</p>
          <div role="group" aria-labelledby="review-main-genre-filter-label">
            <button type="button" data-review-genre="" aria-pressed="true">
              All
            </button>
            {mainGenres.map((mainGenre) => (
              <button type="button" data-review-genre={mainGenre} aria-pressed="false">
                {mainGenre}
              </button>
            ))}
          </div>
        </div>

        <p
          class="review-directory__status"
          role="status"
          aria-live="polite"
          data-review-search-status
        >
          Search or choose a genre across all {totalReviews} reviews.
        </p>
      </div>
    )
  }

  <ol class="review-directory__list" data-review-static-list>
    {reviews.map((review) => <ReviewListItem {review} />)}
  </ol>

  {
    searchable && (
      <>
        <ol class="review-directory__list" data-review-search-list hidden />
        <nav
          class="review-directory__result-pages"
          aria-label="Filtered review result pages"
          data-review-result-pages
          hidden
        >
          <button type="button" data-review-result-previous>
            Previous results
          </button>
          <span data-review-result-page>Page 1 of 1</span>
          <button type="button" data-review-result-next>
            Next results
          </button>
        </nav>
        <template data-review-entry-template>
          <li class="review-list-item">
            <a href="/">
              <span class="review-list-item__cover">
                <img
                  src=""
                  alt=""
                  width="640"
                  height="640"
                  loading="lazy"
                  decoding="async"
                  hidden
                />
                <span class="review-list-item__typographic" aria-hidden="true">
                  <span data-review-entry-title-mark />
                  <small data-review-entry-artist-mark />
                </span>
              </span>
              <span class="review-list-item__identity">
                <span class="review-list-item__genre" data-review-entry-genre />
                <time class="review-list-item__date" data-review-entry-date datetime="" />
                <h3 data-review-entry-title>Review title</h3>
                <strong data-review-entry-artist />
              </span>
              <span class="review-list-item__thesis" data-review-entry-thesis />
              <span class="review-list-item__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        </template>
      </>
    )
  }
</section>

<script>
  import {
    filterReviewSearchRecords,
    paginateReviewSearchRecords,
    type ReviewSearchRecord,
  } from "@utils/reviewSearch";

  const initializeReviewSearch = () => {
    document
      .querySelectorAll<HTMLElement>('[data-review-directory][data-searchable="true"]')
      .forEach((root) => {
        if (root.dataset.ready === "true") {
          return;
        }
        root.dataset.ready = "true";

        const form = root.querySelector<HTMLFormElement>("[data-review-search-form]");
        const input = root.querySelector<HTMLInputElement>("[data-review-search-input]");
        const clear = root.querySelector<HTMLButtonElement>("[data-review-search-clear]");
        const genreButtons =
          root.querySelectorAll<HTMLButtonElement>("[data-review-genre]");
        const status = root.querySelector<HTMLElement>("[data-review-search-status]");
        const staticList = root.querySelector<HTMLOListElement>(
          "[data-review-static-list]"
        );
        const searchList = root.querySelector<HTMLOListElement>(
          "[data-review-search-list]"
        );
        const template = root.querySelector<HTMLTemplateElement>(
          "[data-review-entry-template]"
        );
        const controls = root.querySelector<HTMLElement>("[data-review-controls]");
        const resultPages = root.querySelector<HTMLElement>("[data-review-result-pages]");
        const resultPage = root.querySelector<HTMLElement>("[data-review-result-page]");
        const previous = root.querySelector<HTMLButtonElement>(
          "[data-review-result-previous]"
        );
        const next = root.querySelector<HTMLButtonElement>("[data-review-result-next]");
        const defaultPagination = document.querySelector<HTMLElement>(
          "[data-review-default-pagination]"
        );

        if (
          !form ||
          !input ||
          !clear ||
          !status ||
          !staticList ||
          !searchList ||
          !template ||
          !resultPages ||
          !resultPage ||
          !previous ||
          !next ||
          !controls
        ) {
          return;
        }

        let records: ReviewSearchRecord[] | undefined;
        let requestedResultPage = 1;
        let debounceTimer = 0;

        const readState = () => {
          const params = new URL(window.location.href).searchParams;
          input.value = params.get("q") ?? "";
          const genre = params.get("genre") ?? "";
          requestedResultPage =
            Number.parseInt(params.get("resultsPage") ?? "1", 10) || 1;
          genreButtons.forEach((button) =>
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.reviewGenre === genre)
            )
          );
        };

        const selectedGenre = () =>
          Array.from(genreButtons).find(
            (button) => button.getAttribute("aria-pressed") === "true"
          )?.dataset.reviewGenre ?? "";

        const writeState = (currentPage: number) => {
          const url = new URL(window.location.href);
          const query = input.value.trim();
          const genre = selectedGenre();
          query ? url.searchParams.set("q", query) : url.searchParams.delete("q");
          genre ? url.searchParams.set("genre", genre) : url.searchParams.delete("genre");
          currentPage > 1
            ? url.searchParams.set("resultsPage", String(currentPage))
            : url.searchParams.delete("resultsPage");
          window.history.replaceState({}, "", url);
        };

        const loadRecords = async () => {
          if (records) {
            return records;
          }
          root.setAttribute("aria-busy", "true");
          const response = await fetch(
            root.dataset.indexUrl ?? "/review-search-index.json"
          );
          if (!response.ok) {
            throw new Error(`Search index returned ${response.status}.`);
          }
          records = (await response.json()) as ReviewSearchRecord[];
          root.removeAttribute("aria-busy");
          return records;
        };

        const createEntry = (record: ReviewSearchRecord) => {
          const entry = template.content.firstElementChild?.cloneNode(true);
          if (!(entry instanceof HTMLElement)) {
            return undefined;
          }
          const link = entry.querySelector<HTMLAnchorElement>("a");
          const image = entry.querySelector<HTMLImageElement>("img");
          const mark = entry.querySelector<HTMLElement>(".review-list-item__typographic");
          if (link) {
            link.href = record.url;
          }
          if (image && mark) {
            image.hidden = record.cover.mode !== "original";
            mark.hidden = record.cover.mode === "original";
            if (record.cover.mode === "original") {
              image.src = record.cover.src;
            }
          }
          entry.querySelector<HTMLElement>(
            "[data-review-entry-title-mark]"
          )!.textContent = record.title;
          entry.querySelector<HTMLElement>(
            "[data-review-entry-artist-mark]"
          )!.textContent = record.artist;
          entry.querySelector<HTMLElement>("[data-review-entry-genre]")!.textContent =
            record.genres[0] ?? "Review";
          entry.querySelector<HTMLElement>("[data-review-entry-title]")!.textContent =
            record.title;
          entry.querySelector<HTMLElement>("[data-review-entry-artist]")!.textContent =
            record.artist;
          entry.querySelector<HTMLElement>("[data-review-entry-thesis]")!.textContent =
            record.thesis;
          const date = entry.querySelector<HTMLElement>("[data-review-entry-date]")!;
          date.textContent = new Date(record.publishedAt).toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          });
          date.setAttribute("datetime", record.publishedAt);
          return entry;
        };

        const restoreArchive = () => {
          staticList.hidden = false;
          searchList.hidden = true;
          searchList.replaceChildren();
          if (defaultPagination) {
            defaultPagination.hidden = false;
          }
          clear.hidden = true;
          status.textContent = `Search or choose a genre across the full review archive.`;
          writeState(1);
        };

        const render = async (updateUrl = true) => {
          const query = input.value.trim();
          const genre = selectedGenre();
          const active = Boolean(query || genre);
          if (!active) {
            restoreArchive();
            return;
          }

          clear.hidden = false;
          status.textContent = "Searching the review archive…";
          try {
            const allRecords = await loadRecords();
            const matches = filterReviewSearchRecords(allRecords, query, genre);
            const page = paginateReviewSearchRecords(matches, requestedResultPage);
            requestedResultPage = page.currentPage;
            searchList.replaceChildren(
              ...page.data
                .map(createEntry)
                .filter((entry): entry is HTMLElement => Boolean(entry))
            );
            staticList.hidden = true;
            searchList.hidden = false;
            if (defaultPagination) {
              defaultPagination.hidden = true;
            }
            resultPages.hidden = page.lastPage <= 1;
            previous.disabled = page.currentPage === 1;
            next.disabled = page.currentPage === page.lastPage;
            resultPage.textContent = `Page ${page.currentPage} of ${page.lastPage}`;
            status.textContent =
              page.total === 0
                ? "No reviews match this search and genre."
                : `Showing ${page.start}–${page.end} of ${page.total} matching reviews.`;
            if (updateUrl) {
              writeState(page.currentPage);
            }
          } catch {
            root.removeAttribute("aria-busy");
            staticList.hidden = false;
            searchList.hidden = true;
            resultPages.hidden = true;
            if (defaultPagination) {
              defaultPagination.hidden = false;
            }
            status.textContent =
              "Search is temporarily unavailable. The paginated archive remains below.";
          }
        };

        const resetResultPageAndRender = () => {
          requestedResultPage = 1;
          void render();
        };

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          resetResultPageAndRender();
        });
        input.addEventListener("input", () => {
          window.clearTimeout(debounceTimer);
          debounceTimer = window.setTimeout(resetResultPageAndRender, 180);
        });
        clear.addEventListener("click", () => {
          input.value = "";
          genreButtons.forEach((button) =>
            button.setAttribute("aria-pressed", String(button.dataset.reviewGenre === ""))
          );
          requestedResultPage = 1;
          restoreArchive();
          input.focus();
        });
        genreButtons.forEach((button) =>
          button.addEventListener("click", () => {
            genreButtons.forEach((candidate) =>
              candidate.setAttribute("aria-pressed", String(candidate === button))
            );
            resetResultPageAndRender();
          })
        );
        previous.addEventListener("click", () => {
          requestedResultPage -= 1;
          void render();
        });
        next.addEventListener("click", () => {
          requestedResultPage += 1;
          void render();
        });
        window.addEventListener("popstate", () => {
          readState();
          void render(false);
        });

        readState();
        controls.hidden = false;
        if (input.value.trim() || selectedGenre()) {
          void render(false);
        }
      });
  };

  initializeReviewSearch();
  document.addEventListener("astro:page-load", initializeReviewSearch);
</script>

<style is:global>
  /* ── Base (0,1,0) ── */
  .review-directory {
    display: grid;
    gap: var(--space-xl);
  }

  .review-directory__controls {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-block: 1px solid var(--line);
  }

  .review-directory__search {
    display: grid;
    gap: var(--space-sm);
  }

  .review-directory__search-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .review-directory__clear {
    min-block-size: var(--control-size);
    padding-inline: 0;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--paper-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    background: transparent;
    border: none;
  }

  .review-directory__result-pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    justify-content: space-between;
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--line);
  }

  .review-directory__filters {
    display: grid;
    gap: var(--space-sm);
  }

  .review-directory__status {
    margin: 0;
    color: var(--quiet-ink);
  }

  .review-directory__list {
    padding: 0;
    margin: 0;
    list-style: none;
    border-block-end: 1px solid var(--line);
  }

  .review-list-item {
    min-inline-size: 0;
    border-block-start: 1px solid var(--line);
  }

  .review-list-item__cover {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--desk-night);
  }

  .review-list-item__typographic {
    display: grid;
    gap: var(--space-2xs);
    align-content: end;
    block-size: 100%;
    padding: var(--space-xs);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--archive-night);
    background: var(--paper-ink);
  }

  .review-list-item__identity {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    min-inline-size: 0;
  }

  .review-list-item__genre {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--signal);
    letter-spacing: 0.04em;
  }

  .review-list-item__date {
    font-size: 0.78rem;
    color: var(--quiet-ink);
  }

  .review-list-item__thesis {
    grid-column: 1 / -1;
    max-inline-size: 62ch;
    font-size: 0.95rem;
    color: var(--quiet-ink);
  }

  .review-list-item__arrow {
    display: none;
    font-size: 1.1rem;
    color: var(--quiet-ink);
  }

  /* ── Compound (0,1,1) ── */
  .review-directory__search label,
  .review-directory__filters > p {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--quiet-ink);
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .review-directory__search input {
    flex: 1 1 18rem;
    min-inline-size: 0;
    min-block-size: var(--control-size);
    padding-inline: var(--space-md);
    font: inherit;
    color: var(--paper-ink);
    background: var(--desk-night);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .review-directory__result-pages button {
    min-block-size: var(--control-size);
    padding-inline: var(--space-md);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--paper-ink);
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .review-directory__filters > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }

  .review-directory__filters button {
    min-block-size: var(--control-size);
    padding-inline: 0.1rem;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--paper-ink);
    cursor: pointer;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
  }

  .review-list-item > a {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: center;
    block-size: 100%;
    padding-block: var(--space-md);
    color: var(--paper-ink);
    text-decoration: none;
  }

  .review-list-item__cover > img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .review-list-item__typographic > span {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    font-size: 0.78rem;
    line-height: 1.15;
    -webkit-box-orient: vertical;
  }

  .review-list-item__typographic small {
    font-family: var(--font-body);
    font-size: 0.62rem;
    line-height: 1.2;
  }

  .review-list-item__identity h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.15;
  }

  .review-list-item__identity > strong {
    font-size: 0.92rem;
    color: var(--quiet-ink);
  }

  /* ── Pseudo/attribute (0,2,0) ── */
  .review-directory__clear:hover,
  .review-directory__clear:focus-visible {
    color: var(--signal-strong);
  }

  .review-directory [hidden] {
    display: none !important;
  }

  /* ── Compound + pseudo (0,2,1) ── */
  .review-directory__result-pages button:hover,
  .review-directory__result-pages button:focus-visible {
    color: var(--archive-night);
    background: var(--signal);
    border-color: var(--signal);
  }

  .review-directory__result-pages button:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .review-directory__filters button:hover,
  .review-directory__filters button:focus-visible {
    color: var(--signal-strong);
  }

  .review-directory__filters button[aria-pressed="true"] {
    border-bottom-color: var(--signal);
  }

  /* ── Deep hover/focus (0,3,2) ── */
  .review-list-item > a:hover .review-list-item__identity h3,
  .review-list-item > a:focus-visible .review-list-item__identity h3,
  .review-list-item > a:hover .review-list-item__arrow,
  .review-list-item > a:focus-visible .review-list-item__arrow {
    color: var(--signal-strong);
  }

  @media (width >= 48rem) {
    .review-list-item__thesis {
      grid-column: auto;
    }

    .review-list-item__arrow {
      display: block;
      justify-self: end;
    }

    .review-list-item > a {
      grid-template-columns: 6.5rem minmax(12rem, 0.65fr) minmax(20rem, 1fr) 2.75rem;
      column-gap: var(--space-lg);
    }
  }

  @media (forced-colors: active) {
    .review-directory__search input {
      border-color: CanvasText;
    }
  }
</style>
