---
interface Props {
  title: string;
  artist: string;
  genres: string[];
  compact?: boolean;
}

const { title, artist, genres, compact = false } = Astro.props;
const seed = [...`${title}${artist}`].reduce((total, character) => {
  return total + (character.codePointAt(0) ?? 0);
}, 0);
---

<div
  class:list={["album-mark", compact && "album-mark--compact"]}
  style={`--album-mark-shift: ${seed % 17}%; --album-mark-turn: ${(seed % 9) - 4}deg;`}
  role="img"
  aria-label={`Typographic representation for ${title} by ${artist}; original cover art is not reproduced`}
>
  <span class="album-mark__field" aria-hidden="true"></span>
  <span class="album-mark__copy">
    <small>{genres[0]}</small>
    <strong>{title}</strong>
    <span>{artist}</span>
  </span>
</div>

<style>
  .album-mark {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    overflow: hidden;
    color: var(--archive-night);
    background: var(--paper-ink);
    isolation: isolate;
  }

  .album-mark__field {
    position: absolute;
    inset: -12%;
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        transparent 0 calc(34% + var(--album-mark-shift)),
        var(--signal) calc(34% + var(--album-mark-shift)) 44%,
        transparent 44%
      ),
      repeating-linear-gradient(
        var(--album-mark-turn),
        transparent 0 1.1rem,
        color-mix(in oklch, var(--archive-night) 18%, transparent) 1.1rem 1.18rem
      );
  }

  .album-mark__copy {
    display: grid;
    gap: var(--space-xs);
    align-content: end;
    padding: clamp(1rem, 5vw, 2.2rem);
  }

  .album-mark small {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
  }

  .album-mark strong {
    max-inline-size: 9ch;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 6vw, 4.2rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  .album-mark--compact strong {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }

  .album-mark__copy > span {
    font-weight: 700;
  }
</style>
