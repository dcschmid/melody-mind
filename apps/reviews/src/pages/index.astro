---
import HomeArchive from "@components/HomeArchive.astro";
import { getPublishedReviews, getReviewMainGenreFilters } from "@utils/archive";
import { getArchivePageSlice } from "@melodymind/archive-utils";

const reviews = await getPublishedReviews();
const page = getArchivePageSlice(reviews, 1);
const mainGenres = getReviewMainGenreFilters(reviews);
---

<HomeArchive reviews={page.data} {mainGenres} {...page} />
