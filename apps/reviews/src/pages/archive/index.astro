---
import { getCollection } from "astro:content";
import ReviewDirectory from "@components/ReviewDirectory.astro";
import Layout from "@layouts/Layout.astro";
const reviews = (await getCollection("reviews", ({ data }) => !data.draft)).toSorted(
  (a, b) => b.data.album.releasedAt.valueOf() - a.data.album.releasedAt.valueOf()
);
---

<Layout
  title="Archive"
  description="Browse MelodyMind Reviews by the original release date of each covered album."
>
  <section class="directory page-shell">
    <header>
      <p class="eyebrow">By album year</p><h1>Archive</h1><p>
        Older records remain part of the argument.
      </p>
    </header>
    <ReviewDirectory {reviews} />
  </section>
</Layout>
<style>
  .directory {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-4xl);
  }

  .directory header {
    display: grid;
    gap: var(--space-md);
  }

  .directory h1 {
    font-size: clamp(3.5rem, 9vw, 7rem);
  }

  .directory header p:last-child {
    color: var(--quiet-ink);
  }
</style>
