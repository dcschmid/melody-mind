---
import { getCollection } from "astro:content";
import ReviewDirectory from "@components/ReviewDirectory.astro";
import Layout from "@layouts/Layout.astro";
const reviews = await getCollection(
  "reviews",
  ({ data }) => !data.draft && data.format === "album-of-the-week"
);
---

<Layout
  title="Album of the Week"
  description="The current MelodyMind Album of the Week, with a compact review, three listening cues, context, sources, and external listening links."
>
  <section class="directory page-shell">
    <header>
      <p class="eyebrow">Weekly close listen</p><h1>Album of the Week</h1><p>
        One current record, three places to listen more closely.
      </p>
    </header>
    <ReviewDirectory {reviews} />
  </section>
</Layout>
<style>
  .directory {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-4xl);
  }

  .directory header {
    display: grid;
    gap: var(--space-md);
    max-inline-size: 55rem;
  }

  .directory h1 {
    font-size: clamp(3.2rem, 8vw, 6.5rem);
  }

  .directory header p:last-child {
    color: var(--quiet-ink);
  }
</style>
