---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Review not found"
  description="This MelodyMind Reviews page does not exist. Return to the latest review and the full archive."
  index={false}
>
  <section class="not-found reading-shell">
    <p class="not-found__code">404</p>
    <h1>This review is not in the catalog.</h1>
    <p>The address may be incomplete, or the review may have moved before publication.</p>
    <a href="/">Return to MelodyMind Reviews <span>→</span></a>
  </section>
</Layout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-lg);
    align-content: center;
    min-block-size: 68svh;
    padding-block: var(--space-4xl);
  }

  .not-found h1 {
    max-inline-size: 12ch;
    font-size: clamp(3rem, 8vw, 6.5rem);
  }

  .not-found > p:not(.not-found__code) {
    max-inline-size: 50ch;
    font-size: 1.2rem;
    color: var(--quiet-ink);
  }

  .not-found__code {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--signal);
    letter-spacing: 0.04em;
  }
</style>
