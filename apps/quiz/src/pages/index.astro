---
import { getCollection } from "astro:content";

import QuizCard from "@components/QuizCard.astro";
import AiDisclosure from "@components/AiDisclosure.astro";
import Layout from "@layouts/Layout.astro";
import { getQuizArtwork, sortQuizIds } from "@utils/quizArtwork";

const quizzes = (await getCollection("quizzes", ({ data }) => !data.draft)).sort(
  (left, right) => sortQuizIds(left.id, right.id)
);
const decades = quizzes.filter((quiz) => quiz.data.category === "decade");
const journeys = quizzes.filter((quiz) => quiz.data.category === "genre-evolution");
const journeyLead = journeys[0];
const journeyPreview = journeys.slice(1, 4);
const moreJourneys = journeys.slice(4);
const artists = quizzes.filter((quiz) => quiz.data.category === "artist");
const albums = quizzes.filter((quiz) => quiz.data.category === "album");
const quizIds = quizzes.map((quiz) => quiz.id);
const canonical = new URL("/", Astro.site).toString();
const countLabel = (count: number, singular: string, plural: string) =>
  `${count} ${count === 1 ? singular : plural}`;
const description = `Choose from ${countLabel(decades.length, "decade quiz", "decade quizzes")}, ${countLabel(journeys.length, "genre journey", "genre journeys")}, ${countLabel(artists.length, "artist spotlight", "artist spotlights")}, and ${countLabel(albums.length, "album story", "album stories")}. Every ten-question round includes sources and runs without accounts or tracking.`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Music history quizzes",
    description,
    url: canonical,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: quizzes.map((quiz, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: quiz.data.title,
        url: new URL(`/${quiz.id}/`, Astro.site).toString(),
      })),
    },
  },
];
---

<Layout
  title="Music History Quizzes | MelodyMind Quiz"
  {description}
  {canonical}
  {structuredData}
>
  <div class="quiz-home page-shell">
    <aside
      class="quiz-resume"
      id="quiz-resume"
      aria-labelledby="quiz-resume-title"
      hidden
    >
      <div id="quiz-resume-content">
        <p class="eyebrow">Continue playing</p>
        <h2 id="quiz-resume-title">Your saved round</h2>
        <p class="quiz-resume__progress" id="quiz-resume-progress"></p>
        <div class="quiz-resume__actions">
          <a class="button button--primary" id="quiz-resume-link" href="/">
            Continue quiz
          </a>
          <button class="button button--secondary" id="quiz-resume-discard" type="button">
            Discard saved round
          </button>
        </div>
      </div>
      <div
        class="quiz-resume__confirmation"
        id="quiz-resume-confirmation"
        aria-labelledby="quiz-resume-confirmation-title"
        hidden
      >
        <h2 id="quiz-resume-confirmation-title">Discard saved progress?</h2>
        <p>This removes the unfinished round from this browser.</p>
        <div class="quiz-resume__actions">
          <button
            class="button button--primary"
            id="quiz-resume-discard-confirm"
            type="button"
          >
            Discard progress
          </button>
          <button
            class="button button--secondary"
            id="quiz-resume-discard-cancel"
            type="button"
          >
            Keep saved round
          </button>
        </div>
      </div>
      <p
        class="quiz-resume__status"
        id="quiz-resume-status"
        role="status"
        tabindex="-1"
        hidden
      >
      </p>
    </aside>
    <header class="quiz-home__hero">
      <h1>Music history, one question at a time.</h1>
      <p class="quiz-home__lead">
        Pick a decade, trace a genre, follow an artist, or go inside a landmark album.
        Each round draws ten questions from a reviewed pool, then gives you the answer,
        its context, and the sources.
      </p>
      <div class="quiz-home__actions">
        <a class="button button--primary" id="quiz-random" href={`/${quizIds[0]}/`}>
          Choose a quiz for me
        </a>
      </div>
      <div class="quiz-home__trust">
        <p class="quiz-home__privacy">
          No account. No timer. No analytics. An unfinished round is saved only in this
          browser.
        </p>
        <AiDisclosure
          label="AI-assisted, human-reviewed quizzes"
          detail="Artwork is AI-generated."
          detailsHref="/about/#ai-transparency"
        />
      </div>
    </header>

    <section class="quiz-library" id="decades" aria-labelledby="decades-title">
      <header class="quiz-library__header">
        <div class="quiz-library__heading-row">
          <h2 id="decades-title">Choose a decade</h2>
          <p class="quiz-library__count">
            {countLabel(decades.length, "era", "eras")}
          </p>
        </div>
        <p>Move from early rock and roll to streaming-era pop culture.</p>
      </header>

      <ol class="quiz-grid quiz-grid--decades">
        {
          decades.map((quiz) => (
            <li>
              <QuizCard
                href={`/${quiz.id}/`}
                image={getQuizArtwork(quiz.id)}
                title={quiz.data.title}
                variant="decade"
              />
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="quiz-library quiz-library--journeys"
      id="genre-journeys"
      aria-labelledby="journeys-title"
    >
      <header class="quiz-library__header">
        <div class="quiz-library__heading-row">
          <h2 id="journeys-title">Follow a genre journey</h2>
          <p class="quiz-library__count">
            {countLabel(journeys.length, "listening path", "listening paths")}
          </p>
        </div>
        <p>Trace how artists, studios, formats, and local scenes changed the music.</p>
      </header>

      <div class="quiz-library__journey-layout">
        {
          journeyLead && (
            <QuizCard
              href={`/${journeyLead.id}/`}
              image={getQuizArtwork(journeyLead.id)}
              title={journeyLead.data.title}
              description={journeyLead.data.description}
              topics={journeyLead.data.featuredTopics}
              variant="lead"
            />
          )
        }
        <ul class="quiz-grid quiz-grid--journey-previews">
          {
            journeyPreview.map((quiz) => (
              <li>
                <QuizCard
                  href={`/${quiz.id}/`}
                  image={getQuizArtwork(quiz.id)}
                  title={quiz.data.title}
                  description={quiz.data.description}
                  topics={quiz.data.featuredTopics}
                  variant="compact"
                />
              </li>
            ))
          }
        </ul>
      </div>
      {
        moreJourneys.length > 0 && (
          <details class="quiz-library__more">
            <summary>
              <span class="quiz-library__more-label">
                Show {moreJourneys.length} more genre journeys
              </span>
              <span class="quiz-library__more-label quiz-library__more-label--open">
                Show fewer genre journeys
              </span>
            </summary>
            <ul class="quiz-grid quiz-grid--journey-more">
              {moreJourneys.map((quiz) => (
                <li>
                  <QuizCard
                    href={`/${quiz.id}/`}
                    image={getQuizArtwork(quiz.id)}
                    title={quiz.data.title}
                    description={quiz.data.description}
                    topics={quiz.data.featuredTopics}
                    variant="compact"
                  />
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </section>

    <section class="quiz-library" id="artists" aria-labelledby="artists-title">
      <header class="quiz-library__header">
        <div class="quiz-library__heading-row">
          <h2 id="artists-title">Follow an artist</h2>
          <p class="quiz-library__count">
            {countLabel(artists.length, "singular career", "singular careers")}
          </p>
        </div>
        <p>
          Connect creative turning points, collaborators, studio methods, and musical
          independence.
        </p>
      </header>

      <ul class="quiz-grid quiz-grid--features">
        {
          artists.map((quiz) => (
            <li>
              <QuizCard
                href={`/${quiz.id}/`}
                image={getQuizArtwork(quiz.id)}
                title={quiz.data.title}
                description={quiz.data.description}
                topics={quiz.data.featuredTopics}
                variant="feature"
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="quiz-library" id="albums" aria-labelledby="albums-title">
      <header class="quiz-library__header">
        <div class="quiz-library__heading-row">
          <h2 id="albums-title">Go inside an album</h2>
          <p class="quiz-library__count">
            {countLabel(albums.length, "landmark record", "landmark records")}
          </p>
        </div>
        <p>
          Hear how songs, performances, production choices, and cultural afterlives fit
          together.
        </p>
      </header>

      <ul class="quiz-grid quiz-grid--features">
        {
          albums.map((quiz) => (
            <li>
              <QuizCard
                href={`/${quiz.id}/`}
                image={getQuizArtwork(quiz.id)}
                title={quiz.data.title}
                description={quiz.data.description}
                topics={quiz.data.featuredTopics}
                variant="feature"
              />
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <script
    is:inline
    id="quiz-catalog-data"
    type="application/json"
    set:html={JSON.stringify(quizIds)}
  />
</Layout>

<script>
  import {
    clearActiveQuiz,
    getBrowserStorage,
    readActiveQuiz,
  } from "@scripts/quizPersistence";

  const resume = document.getElementById("quiz-resume");
  const resumeContent = document.getElementById("quiz-resume-content");
  const confirmation = document.getElementById("quiz-resume-confirmation");
  const discardStatus = document.getElementById("quiz-resume-status");
  const title = document.getElementById("quiz-resume-title");
  const progress = document.getElementById("quiz-resume-progress");
  const link = document.getElementById("quiz-resume-link") as HTMLAnchorElement | null;
  const discard = document.getElementById(
    "quiz-resume-discard"
  ) as HTMLButtonElement | null;
  const confirmDiscard = document.getElementById(
    "quiz-resume-discard-confirm"
  ) as HTMLButtonElement | null;
  const cancelDiscard = document.getElementById(
    "quiz-resume-discard-cancel"
  ) as HTMLButtonElement | null;
  const catalogData = document.getElementById("quiz-catalog-data");
  const catalogIds = JSON.parse(catalogData?.textContent || "[]") as string[];
  const randomQuiz = document.getElementById("quiz-random") as HTMLAnchorElement | null;
  const storage = getBrowserStorage();

  randomQuiz?.addEventListener("click", (event) => {
    if (catalogIds.length === 0) {
      return;
    }

    event.preventDefault();
    const values = new Uint32Array(1);
    crypto.getRandomValues(values);
    const quizId = catalogIds[values[0] % catalogIds.length];
    window.location.assign(`/${quizId}/`);
  });

  if (
    resume &&
    resumeContent &&
    confirmation &&
    discardStatus &&
    title &&
    progress &&
    link &&
    discard &&
    confirmDiscard &&
    cancelDiscard &&
    storage
  ) {
    const stored = readActiveQuiz(storage);
    if (stored.status === "ready" && catalogIds.includes(stored.round.quizId)) {
      const { round } = stored;
      title.textContent = round.title;
      progress.textContent = `Question ${round.snapshot.currentIndex + 1} of ${round.snapshot.questions.length}`;
      link.href = `/${round.quizId}/`;
      resume.hidden = false;

      discard.addEventListener("click", () => {
        resumeContent.hidden = true;
        confirmation.hidden = false;
        confirmDiscard.focus();
      });
      cancelDiscard.addEventListener("click", () => {
        confirmation.hidden = true;
        resumeContent.hidden = false;
        discard.focus();
      });
      confirmDiscard.addEventListener("click", () => {
        clearActiveQuiz(storage);
        confirmation.hidden = true;
        discardStatus.textContent =
          "Saved round discarded. Choose a quiz to begin again.";
        discardStatus.hidden = false;
        resume.setAttribute("aria-labelledby", "quiz-resume-status");
        discardStatus.focus();
      });
    } else if (stored.status === "ready") {
      clearActiveQuiz(storage);
    }
  }
</script>

<style>
  .quiz-home {
    display: grid;
    gap: var(--space-3xl);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .quiz-home__hero {
    display: grid;
    gap: var(--space-md);
    max-inline-size: 52rem;
    padding-block: var(--space-lg);
  }

  .quiz-home__hero h1 {
    max-inline-size: 16ch;
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    letter-spacing: -0.03em;
  }

  .quiz-home__lead {
    max-inline-size: 62ch;
    font-size: 1.25rem;
    color: var(--quiet-ink);
  }

  .quiz-home__privacy {
    font-size: 0.95rem;
    color: var(--quiet-ink);
  }

  .quiz-home__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--line-soft);
  }

  .quiz-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block: var(--space-xs);
  }

  .quiz-library__more {
    margin-block-start: var(--space-lg);
  }

  .quiz-library__more summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-min-size);
    padding-inline: var(--space-md);
    font-weight: 700;
    color: var(--quiet-ink);
    cursor: pointer;
    background: var(--listening-surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-pill);
  }

  .quiz-library__more summary:hover,
  .quiz-library__more summary:focus-visible {
    color: var(--warm-ink);
    border-color: var(--signal-teal);
  }

  .quiz-library__more-label--open {
    display: none;
  }

  .quiz-library__more[open] .quiz-library__more-label {
    display: none;
  }

  .quiz-library__more[open] .quiz-library__more-label--open {
    display: inline;
  }

  .quiz-library__more[open] summary {
    margin-block-end: var(--space-lg);
  }

  .quiz-resume,
  .quiz-resume > div {
    display: grid;
    gap: var(--space-md);
  }

  .quiz-resume {
    max-inline-size: 52rem;
    padding: var(--space-lg);
    background: var(--raised-night);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .quiz-resume__progress,
  .quiz-resume__confirmation p,
  .quiz-resume__status {
    color: var(--quiet-ink);
  }

  .quiz-resume__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xs);
  }

  .quiz-library {
    display: grid;
    gap: var(--space-xl);
    scroll-margin-block-start: var(--space-xl);
  }

  .quiz-library__header {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: 44rem;
  }

  .quiz-library__header h2 {
    font-size: 2rem;
  }

  .quiz-library__header > p:last-child {
    color: var(--quiet-ink);
  }

  .quiz-library__heading-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    align-items: baseline;
  }

  .quiz-library__count {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--quiet-ink);
  }

  .quiz-library__journey-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }

  .quiz-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .quiz-grid--decades {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .quiz-grid--journey-previews,
  .quiz-grid--journey-more {
    gap: var(--space-sm);
  }

  @media (width >= 48rem) {
    .quiz-home {
      padding-block-start: var(--space-3xl);
    }

    .quiz-grid--decades {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .quiz-grid--journey-previews,
    .quiz-grid--journey-more,
    .quiz-grid--features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .quiz-library__journey-layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  @media (width >= 80rem) {
    .quiz-grid--decades {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
</style>
