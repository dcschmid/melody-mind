---
import { getCollection } from "astro:content";

import QuizCard from "@components/QuizCard.astro";
import Layout from "@layouts/Layout.astro";
import { getQuizArtwork, sortQuizIds } from "@utils/quizArtwork";

const quizzes = (await getCollection("quizzes", ({ data }) => !data.draft)).sort(
  (left, right) => sortQuizIds(left.id, right.id)
);
const decades = quizzes.filter((quiz) => quiz.data.category === "decade");
const journeys = quizzes.filter((quiz) => quiz.data.category === "genre-evolution");
const canonical = new URL("/", Astro.site).toString();
const description =
  "Choose a music history quiz on seven decades or ten genre journeys. Every ten-question round includes sources and runs without accounts, tracking, or saved progress.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Music history quizzes",
    description,
    url: canonical,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: quizzes.map((quiz, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: quiz.data.title,
        url: new URL(`/${quiz.id}/`, Astro.site).toString(),
      })),
    },
  },
];
---

<Layout
  title="Music History Quizzes | MelodyMind Quiz"
  {description}
  {canonical}
  {structuredData}
>
  <div class="quiz-home page-shell">
    <header class="quiz-home__hero">
      <p class="eyebrow">Listen closer</p>
      <h1>Music history, one question at a time.</h1>
      <p class="quiz-home__lead">
        Pick a decade or trace one of ten genre histories. Each round draws ten questions
        from a reviewed pool, then gives you the answer, its context, and the sources.
      </p>
      <p class="quiz-home__privacy">
        No account. No timer. No analytics. Your progress is never saved.
      </p>
    </header>

    <section class="quiz-library" id="decades" aria-labelledby="decades-title">
      <header class="quiz-library__header">
        <p class="eyebrow">Seven eras</p>
        <h2 id="decades-title">Choose a decade</h2>
        <p>Move from early rock and roll to streaming-era pop culture.</p>
      </header>

      <ol class="quiz-grid">
        {
          decades.map((quiz) => (
            <li>
              <QuizCard
                href={`/${quiz.id}/`}
                image={getQuizArtwork(quiz.id)}
                eyebrow="Decade quiz"
                title={quiz.data.title}
                description={quiz.data.description}
              />
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="quiz-library quiz-library--journeys"
      id="genre-journeys"
      aria-labelledby="journeys-title"
    >
      <header class="quiz-library__header">
        <p class="eyebrow">Ten listening paths</p>
        <h2 id="journeys-title">Follow a genre journey</h2>
        <p>Trace how artists, studios, formats, and local scenes changed the music.</p>
      </header>

      <ul class="quiz-grid">
        {
          journeys.map((quiz) => (
            <li>
              <QuizCard
                href={`/${quiz.id}/`}
                image={getQuizArtwork(quiz.id)}
                eyebrow="Genre journey"
                title={quiz.data.title}
                description={quiz.data.description}
                topics={quiz.data.featuredTopics}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<style>
  .quiz-home {
    display: grid;
    gap: var(--space-3xl);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .quiz-home__hero {
    display: grid;
    gap: var(--space-lg);
    max-inline-size: 52rem;
    padding-block: var(--space-xl);
  }

  .quiz-home__hero h1 {
    max-inline-size: 16ch;
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    letter-spacing: -0.03em;
  }

  .quiz-home__lead {
    max-inline-size: 62ch;
    font-size: 1.25rem;
    color: var(--quiet-ink);
  }

  .quiz-home__privacy {
    inline-size: fit-content;
    padding: var(--space-sm) var(--space-md);
    font-size: 0.95rem;
    color: var(--warm-ink);
    background: var(--raised-night);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-pill);
  }

  .quiz-library {
    display: grid;
    gap: var(--space-xl);
    scroll-margin-block-start: var(--space-xl);
  }

  .quiz-library__header {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: 44rem;
  }

  .quiz-library__header h2 {
    font-size: 2rem;
  }

  .quiz-library__header > p:last-child {
    color: var(--quiet-ink);
  }

  .quiz-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .quiz-home {
      padding-block-start: var(--space-3xl);
    }

    .quiz-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .quiz-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
