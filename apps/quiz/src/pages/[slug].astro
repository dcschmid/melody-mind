---
import { createHash } from "node:crypto";

import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

import Layout from "@layouts/Layout.astro";
import AiDisclosure from "@components/AiDisclosure.astro";
import { getNextQuizId } from "@scripts/quizEngine";
import type { QuizQuestion } from "@quiz-types/quiz";
import { getQuizArtwork, sortQuizIds } from "@utils/quizArtwork";

interface Props {
  quiz: CollectionEntry<"quizzes">;
  nextQuiz: CollectionEntry<"quizzes">;
}

export async function getStaticPaths() {
  const quizzes = (await getCollection("quizzes", ({ data }) => !data.draft)).sort(
    (left, right) => sortQuizIds(left.id, right.id)
  );
  return quizzes.map((quiz) => {
    const categoryIds = quizzes
      .filter((categoryQuiz) => categoryQuiz.data.category === quiz.data.category)
      .map((categoryQuiz) => categoryQuiz.id);
    const nextQuizId = getNextQuizId(quiz.id, categoryIds);
    const nextQuiz = quizzes.find((candidate) => candidate.id === nextQuizId);
    if (!nextQuiz) {
      throw new Error(`Missing next quiz: ${nextQuizId}`);
    }

    return {
      params: { slug: quiz.id },
      props: { quiz, nextQuiz },
    };
  });
}

const { quiz, nextQuiz } = Astro.props;
const canonical = new URL(`/${quiz.id}/`, Astro.site).toString();
const image = getQuizArtwork(quiz.id);
const nextQuizImage = getQuizArtwork(nextQuiz.id);
/* Generated 1200x630 social card (scripts/generate-social-images.mjs). */
const socialImageUrl = new URL(`/og/${quiz.id}.jpg`, Astro.site).toString();
const title = quiz.data.seoTitle ?? `${quiz.data.title} Music Quiz`;
const description = quiz.data.seoDescription ?? quiz.data.description;
const questions = quiz.data.questions.map((question): QuizQuestion => ({
  ...question,
  sources: question.sources.map((source) => ({
    ...source,
    checkedAt: source.checkedAt.toISOString(),
  })),
}));
const fingerprint = createHash("sha256")
  .update(JSON.stringify(questions))
  .digest("hex")
  .slice(0, 16);
const serializedData = JSON.stringify({
  quizId: quiz.id,
  title: quiz.data.title,
  fingerprint,
  questions,
}).replaceAll("<", "\\u003c");
const categoryLabels = {
  decade: "Decade quiz",
  "genre-evolution": "Genre journey",
  artist: "Artist spotlight",
  album: "Album story",
} as const;
const categoryLabel = categoryLabels[quiz.data.category];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    name: title,
    description,
    url: canonical,
    about: quiz.data.featuredTopics,
    educationalLevel: "Beginner to advanced",
    numberOfQuestions: 10,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Music quizzes",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: quiz.data.title,
        item: canonical,
      },
    ],
  },
];
---

<Layout
  {title}
  {description}
  {canonical}
  image={socialImageUrl}
  imageAlt={`AI-generated music-history illustration for ${quiz.data.title}`}
  {structuredData}
>
  <div class="quiz-route page-shell page-shell--reading">
    <section class="quiz-intro" id="quiz-intro" aria-labelledby="quiz-title">
      <a class="quiz-intro__back" href="/">← All quizzes</a>
      <Image
        class="quiz-intro__art"
        src={image}
        alt=""
        width={320}
        height={320}
        loading="eager"
        sizes="(max-width: 639px) 8rem, 12rem"
      />
      <div class="quiz-intro__copy">
        <p class="eyebrow">{categoryLabel}</p>
        <h1 id="quiz-title">{quiz.data.title}</h1>
      </div>
      <p class="quiz-intro__description">{quiz.data.description}</p>
      <dl class="quiz-intro__facts">
        <div>
          <dt>Round</dt>
          <dd>10 questions from a pool of 40</dd>
        </div>
        <div>
          <dt>Pace</dt>
          <dd>No time limit</dd>
        </div>
        <div>
          <dt>Privacy</dt>
          <dd>Progress stays in this browser</dd>
        </div>
      </dl>
      <div class="quiz-intro__challenge" id="quiz-challenge" hidden>
        <p class="eyebrow">Challenge</p>
        <p class="quiz-intro__challenge-copy" id="quiz-challenge-copy"></p>
      </div>
      <div class="quiz-intro__actions">
        <button class="button button--primary" id="quiz-start" type="button">
          Start quiz
        </button>
        <a class="button button--secondary" id="quiz-continue-other" href="/" hidden>
          Continue saved quiz
        </a>
        <button class="button button--secondary" id="quiz-new-round" type="button" hidden>
          Start a new round
        </button>
      </div>
      <div class="quiz-intro__disclosure">
        <AiDisclosure
          variant="assisted"
          label="AI-assisted, human-reviewed quiz"
          detail="Artwork is AI-generated."
          detailsHref="/about/#ai-transparency"
        />
      </div>
      <div
        class="quiz-intro__confirmation"
        id="quiz-replace-confirmation"
        aria-labelledby="quiz-replace-title"
        hidden
      >
        <h2 id="quiz-replace-title">Replace saved progress?</h2>
        <p class="quiz-intro__confirmation-copy" id="quiz-replace-copy">
          Starting a new round will replace the unfinished round saved in this browser.
        </p>
        <div class="quiz-intro__confirmation-actions">
          <button class="button button--primary" id="quiz-replace-confirm" type="button">
            Replace and start
          </button>
          <button class="button button--secondary" id="quiz-replace-cancel" type="button">
            Keep saved round
          </button>
        </div>
      </div>
      <p class="quiz-intro__status" id="quiz-storage-status" role="status"></p>
      <noscript>
        <p class="quiz-noscript">
          This quiz needs JavaScript to check answers. No data leaves your browser.
        </p>
      </noscript>
    </section>

    <section class="quiz-game" id="quiz-game" aria-label={quiz.data.title} hidden>
      <header class="quiz-game__progress">
        <div class="quiz-game__progress-copy">
          <span id="quiz-progress-text">Question 1 of 10</span>
          <a id="quiz-exit" href="/">Save &amp; exit</a>
        </div>
        <progress id="quiz-progress" value="1" max="10">1 of 10</progress>
      </header>
      <div id="quiz-question"></div>
      <section class="quiz-feedback" id="quiz-feedback" hidden></section>
      <div class="quiz-game__actions">
        <button class="button button--primary" id="quiz-check" type="button" disabled>
          Check answer
        </button>
        <button class="button button--secondary" id="quiz-reveal" type="button">
          Show answer
        </button>
        <button class="button button--primary" id="quiz-next" type="button" hidden>
          Next question
        </button>
      </div>
    </section>

    <section
      class="quiz-result"
      id="quiz-result"
      aria-labelledby="quiz-result-title"
      hidden
    >
      <p class="eyebrow">Round complete</p>
      <h1 id="quiz-result-title" tabindex="-1">Your result</h1>
      <p class="quiz-result__score" id="quiz-score"></p>
      <p class="quiz-result__band" id="quiz-score-band"></p>
      <dl class="quiz-result__breakdown" aria-label="Result breakdown">
        <div class="quiz-result__breakdown-item">
          <dt>Correct</dt>
          <dd id="quiz-result-correct">0</dd>
        </div>
        <div class="quiz-result__breakdown-item">
          <dt>Incorrect</dt>
          <dd id="quiz-result-incorrect">0</dd>
        </div>
        <div class="quiz-result__breakdown-item">
          <dt>Revealed</dt>
          <dd id="quiz-result-revealed">0</dd>
        </div>
      </dl>
      <p class="quiz-result__copy">
        Review the questions that need another listen, then continue through music
        history.
      </p>
      <section
        class="quiz-result__review"
        id="quiz-result-review"
        aria-labelledby="quiz-result-review-title"
        hidden
      >
        <h2 id="quiz-result-review-title">Review this round</h2>
        <div class="quiz-result__review-list" id="quiz-result-review-list"></div>
      </section>
      <p class="quiz-result__perfect" id="quiz-result-perfect" hidden>
        You answered every question correctly. No review needed this time.
      </p>
      <section class="quiz-result__next" aria-labelledby="quiz-result-next-title">
        <Image
          class="quiz-result__next-image"
          src={nextQuizImage}
          alt=""
          width={112}
          height={112}
          loading="lazy"
        />
        <div>
          <p class="eyebrow">Continue exploring</p>
          <h2 id="quiz-result-next-title">{nextQuiz.data.title}</h2>
          <p>{nextQuiz.data.description}</p>
          <a class="button button--primary" href={`/${nextQuiz.id}/`}>
            Start next quiz
          </a>
        </div>
      </section>
      <div class="quiz-result__actions">
        <button class="button button--secondary" id="quiz-replay" type="button">
          Play another round
        </button>
        <a class="button button--secondary" href="/">Choose another quiz</a>
        <button class="button button--secondary" id="quiz-share" type="button">
          Share result
        </button>
      </div>
      <p class="quiz-result__status" id="quiz-share-status" role="status"></p>
    </section>

    <section class="quiz-error" id="quiz-error" hidden>
      <p class="eyebrow">Quiz unavailable</p>
      <h1 tabindex="-1">This round could not start.</h1>
      <p>
        Reload the page to try again. If you already had an unfinished round, it remains
        saved in this browser.
      </p>
      <div class="quiz-error__actions">
        <a class="button button--primary" href={Astro.url.pathname}>Reload quiz</a>
        <a class="button button--secondary" href="/">Choose another quiz</a>
      </div>
    </section>
  </div>

  <script is:inline id="quiz-data" type="application/json" set:html={serializedData} />
</Layout>

<script>
  import { initQuiz } from "@scripts/quizClient";

  initQuiz();
</script>

<style is:global>
  .quiz-route {
    padding-block: var(--space-lg) var(--space-3xl);
  }

  .quiz-intro {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
  }

  .quiz-intro__back {
    grid-column: 1 / -1;
    inline-size: fit-content;
    min-block-size: var(--control-min-size);
    font-weight: 700;
    color: var(--quiet-ink);
    text-decoration: none;
  }

  .quiz-intro__art {
    inline-size: 5.5rem;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 24px 32px -12px rgb(0 0 0 / 46%);
  }

  .quiz-intro__copy {
    display: grid;
    gap: var(--space-sm);
    min-inline-size: 0;
  }

  .quiz-intro__copy h1 {
    font-size: 1.75rem;
  }

  .quiz-intro__description {
    grid-column: 1 / -1;
    color: var(--quiet-ink);
  }

  .quiz-intro__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-column: 1 / -1;
    gap: 1px;
    margin: var(--space-xs) 0 0;
    background: var(--line-soft);
    border-block: 1px solid var(--line-soft);
  }

  .quiz-intro__facts div {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    background: var(--room-night);
  }

  .quiz-intro__facts dt {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--signal-teal);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .quiz-intro__facts dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--quiet-ink);
  }

  .quiz-intro__challenge {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: color-mix(in srgb, var(--signal-teal) 9%, var(--raised-night));
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .quiz-intro__challenge-copy {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .quiz-intro__description,
  .quiz-intro__challenge,
  .quiz-intro__actions,
  .quiz-intro__disclosure,
  .quiz-intro__confirmation,
  .quiz-intro__status,
  .quiz-noscript {
    grid-column: 1 / -1;
  }

  .quiz-intro__actions,
  .quiz-intro__confirmation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .quiz-intro__actions .button {
    flex: 1 1 12rem;
  }

  .quiz-intro__confirmation {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--raised-night);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .quiz-intro__confirmation h2 {
    font-size: 1.25rem;
  }

  .quiz-intro__confirmation-copy,
  .quiz-intro__status {
    color: var(--quiet-ink);
  }

  .quiz-intro__status:empty {
    display: none;
  }

  .quiz-noscript {
    padding: var(--space-md);
    color: var(--quiet-ink);
    background: var(--raised-night);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
  }

  .quiz-game {
    display: grid;
    gap: var(--space-xl);
  }

  .quiz-intro[hidden],
  .quiz-intro__challenge[hidden],
  .quiz-game[hidden],
  .quiz-feedback[hidden],
  .quiz-result[hidden],
  .quiz-error[hidden] {
    display: none;
  }

  .quiz-game__progress {
    display: grid;
    gap: var(--space-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--quiet-ink);
  }

  .quiz-game__progress-copy {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    justify-content: space-between;
  }

  .quiz-game__progress-copy a {
    min-block-size: var(--control-min-size);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .quiz-game__progress progress {
    inline-size: 100%;
    block-size: 0.35rem;
    overflow: hidden;
    color: var(--signal-teal);
    appearance: none;
    background: var(--listening-surface);
    border: 0;
    border-radius: var(--radius-pill);
  }

  .quiz-game__progress progress::-webkit-progress-bar {
    background: var(--listening-surface);
  }

  .quiz-game__progress progress::-webkit-progress-value {
    background: var(--signal-teal);
  }

  .quiz-game__progress progress::-moz-progress-bar {
    background: var(--signal-teal);
  }

  .quiz-question {
    display: grid;
    gap: var(--space-lg);
    min-inline-size: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .quiz-question__legend {
    max-inline-size: 30ch;
    padding: 0;
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .quiz-question__hint {
    color: var(--quiet-ink);
  }

  .quiz-question__shortcut {
    display: none;
    margin-inline-start: var(--space-xs);
    font-size: 0.9rem;
    color: var(--quiet-ink);
  }

  .quiz-question__options {
    display: grid;
    gap: var(--space-sm);
  }

  .quiz-option {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: center;
    min-block-size: 4rem;
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    background: color-mix(in srgb, var(--raised-night) 74%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .quiz-option:has(.quiz-option__control:checked) {
    background: color-mix(in srgb, var(--signal-teal) 10%, var(--raised-night));
    border-color: var(--signal-teal);
  }

  .quiz-option:has(.quiz-option__control:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 0.2rem;
  }

  .quiz-option__control {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .quiz-option__marker {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    font-weight: 700;
    color: var(--quiet-ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }

  .quiz-option__text {
    min-inline-size: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .quiz-option[data-correct="true"] {
    border-color: var(--success);
  }

  .quiz-option[data-correct="true"] .quiz-option__marker {
    color: var(--room-night);
    background: var(--success);
    border-color: var(--success);
  }

  .quiz-option[data-selected="true"][data-correct="false"] {
    border-color: var(--error);
  }

  .quiz-option[data-selected="true"][data-correct="false"] .quiz-option__marker {
    color: var(--room-night);
    background: var(--error);
    border-color: var(--error);
  }

  .quiz-game__actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  .quiz-feedback {
    display: grid;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
    border-block: 1px solid var(--line-soft);
  }

  .quiz-feedback__title {
    font-size: 1.5rem;
  }

  .quiz-feedback--correct .quiz-feedback__title {
    color: var(--success);
  }

  .quiz-feedback--incorrect .quiz-feedback__title {
    color: var(--error);
  }

  .quiz-feedback__answer {
    font-weight: 700;
  }

  .quiz-feedback__explanation {
    color: var(--quiet-ink);
  }

  .quiz-feedback__context-title {
    margin-block-start: var(--space-sm);
    font-size: 1rem;
  }

  .quiz-feedback__context {
    color: var(--quiet-ink);
  }

  .quiz-feedback__source-details {
    margin-block-start: var(--space-sm);
  }

  .quiz-feedback__source-summary {
    inline-size: fit-content;
    min-block-size: var(--control-min-size);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--quiet-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .quiz-feedback__sources {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
    list-style: none;
  }

  .quiz-feedback__source-details[open] .quiz-feedback__sources {
    margin-block-start: var(--space-xs);
  }

  .quiz-feedback__sources a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-min-size);
  }

  .quiz-result,
  .quiz-error {
    display: grid;
    gap: var(--space-lg);
    max-inline-size: 44rem;
    padding-block: var(--space-xl);
  }

  .quiz-result h1,
  .quiz-error h1 {
    font-size: 2.5rem;
  }

  .quiz-result__score {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .quiz-result__band {
    inline-size: fit-content;
    padding: var(--space-xs) var(--space-sm);
    font-weight: 700;
    color: var(--room-night);
    background: var(--signal-teal);
    border-radius: var(--radius-pill);
  }

  .quiz-result__breakdown {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 0;
    margin: 0;
    overflow: hidden;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
  }

  .quiz-result__breakdown-item {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    text-align: center;
    background: var(--raised-night);
  }

  .quiz-result__breakdown dt {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--quiet-ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .quiz-result__breakdown dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .quiz-result__copy,
  .quiz-result__perfect,
  .quiz-error > p:not(.eyebrow) {
    color: var(--quiet-ink);
  }

  .quiz-result__review {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .quiz-result__review h2,
  .quiz-result__next h2 {
    font-size: 1.5rem;
  }

  .quiz-result__review-list {
    display: grid;
    gap: var(--space-sm);
  }

  .quiz-review-item {
    background: var(--raised-night);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
  }

  .quiz-review-item__summary {
    display: grid;
    gap: var(--space-xs);
    min-block-size: var(--control-min-size);
    padding: var(--space-md);
    cursor: pointer;
  }

  .quiz-review-item__status {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--error);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .quiz-review-item__question {
    font-weight: 700;
  }

  .quiz-review-item__body {
    display: grid;
    gap: var(--space-sm);
    padding: 0 var(--space-md) var(--space-md);
  }

  .quiz-review-item__answer,
  .quiz-review-item__context-title {
    font-weight: 700;
  }

  .quiz-review-item__explanation,
  .quiz-review-item__context {
    color: var(--quiet-ink);
  }

  .quiz-review-item__context-title {
    margin-block-start: var(--space-xs);
    font-size: 1rem;
  }

  .quiz-review-item__sources {
    display: grid;
    gap: var(--space-xs);
    padding-inline-start: var(--space-lg);
    margin: var(--space-xs) 0 0;
  }

  .quiz-review-item__sources a {
