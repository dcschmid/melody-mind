---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  href: string;
  image: ImageMetadata;
  title: string;
  description?: string;
  topics?: string[];
  variant: "decade" | "lead" | "compact" | "feature";
}

const { href, image, title, description, topics = [], variant } = Astro.props;
const compactImage = variant === "decade" || variant === "compact";
const sizes = compactImage
  ? "(max-width: 47.99rem) 4rem, 5.5rem"
  : variant === "lead"
    ? "(max-width: 63.99rem) calc(100vw - 2rem), 48rem"
    : "(max-width: 47.99rem) calc(100vw - 2rem), 40rem";
const showAction = variant === "lead" || variant === "feature";
---

<a class:list={["quiz-card", `quiz-card--${variant}`]} {href}>
  <Image
    class="quiz-card__image"
    src={image}
    alt=""
    width={640}
    height={640}
    loading="lazy"
    {sizes}
  />
  <span class="quiz-card__body">
    <strong class="quiz-card__title">{title}</strong>
    {description && <span class="quiz-card__description">{description}</span>}
    {
      topics.length > 0 && (
        <span class="quiz-card__topics">{topics.slice(0, 3).join(" · ")}</span>
      )
    }
    {
      showAction && (
        <span class="quiz-card__action" aria-hidden="true">
          Start quiz <span>→</span>
        </span>
      )
    }
  </span>
</a>

<style>
  .quiz-card {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: center;
    block-size: 100%;
    min-block-size: var(--control-min-size);
    color: var(--warm-ink);
    text-decoration: none;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      background-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .quiz-card__image {
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .quiz-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-inline-size: 0;
    padding: var(--space-xs) var(--space-sm);
  }

  .quiz-card__title {
    font-size: 1rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .quiz-card__description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--quiet-ink);
  }

  .quiz-card__topics {
    font-size: 0.875rem;
    color: var(--quiet-ink);
  }

  .quiz-card__action {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    padding-block-start: var(--space-xs);
    margin-block-start: auto;
    font-weight: 700;
    color: var(--signal-teal);
  }

  .quiz-card--lead,
  .quiz-card--feature {
    grid-template-rows: auto 1fr;
    grid-template-columns: minmax(0, 1fr);
  }

  .quiz-card--lead .quiz-card__image,
  .quiz-card--feature .quiz-card__image {
    block-size: auto;
    aspect-ratio: 16 / 9;
    border-radius: 0;
  }

  .quiz-card--lead .quiz-card__body,
  .quiz-card--feature .quiz-card__body {
    padding: var(--space-md);
  }

  .quiz-card--lead .quiz-card__title {
    font-size: 1.5rem;
  }

  .quiz-card--feature .quiz-card__title {
    font-size: 1.25rem;
  }

  @media (hover: hover) {
    .quiz-card:hover,
    .quiz-card:focus-visible {
      background: var(--listening-surface);
      border-color: var(--signal-teal);
    }

    .quiz-card:hover .quiz-card__action,
    .quiz-card:focus-visible .quiz-card__action {
      color: var(--warm-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz-card {
      transition: none;
    }
  }
</style>
