---
interface Props {
  detailsHref: string;
  detail?: string;
  label: string;
}

const { detailsHref, detail, label } = Astro.props;
---

<a
  class="ai-disclosure"
  href={detailsHref}
  aria-label={`${label}. Read AI transparency details.`}
>
  <img src="/ai-eu.svg" width="34" height="34" alt="" aria-hidden="true" />
  <span class="ai-disclosure__copy">
    <strong>{label}</strong>
    {detail && <span>{detail}</span>}
  </span>
</a>

<style>
  .ai-disclosure {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    inline-size: fit-content;
    max-inline-size: 100%;
    min-block-size: var(--control-min-size);
    padding: 0.25rem 0;
    color: var(--warm-ink);
    text-decoration: none;
  }

  .ai-disclosure:hover,
  .ai-disclosure:focus-visible {
    color: var(--strong-teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .ai-disclosure img {
    flex: 0 0 auto;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    outline: 0;
  }

  .ai-disclosure__copy {
    display: grid;
    gap: 0.1rem;
    min-inline-size: 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .ai-disclosure__copy strong {
    font-size: inherit;
    font-weight: 700;
  }

  .ai-disclosure__copy span {
    color: var(--quiet-ink);
  }

  @media (forced-colors: active) {
    .ai-disclosure {
      color: LinkText;
    }
  }
</style>
