{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"],
      "outputs": ["dist/**", ".astro/**"],
      "passThroughEnv": ["NODE_OPTIONS"],
      "env": ["GOOGLE_SITE_VERIFICATION", "PUBLIC_EMBED_ORIGIN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputLogs": "new-only"
    },
    "check": {
      "outputLogs": "new-only"
    },
    "lint": {
      "cache": false,
      "outputLogs": "new-only"
    },
    "lint:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs", "$TURBO_ROOT$/stylelint.config.cjs"],
      "outputLogs": "new-only"
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/prettier.config.cjs"],
      "outputLogs": "new-only"
    },
    "clean": {
      "cache": false,
      "outputs": [".turbo/**", "dist/**", ".astro/**"]
    }
  }
}
