{
  "name": "melody-mind",
  "private": true,
  "version": "1.0.0",
  "description": "MelodyMind Music, Quiz, Stories, and Reviews apps",
  "pnpm": {
    "overrides": {
      "@emnapi/core": "^1.11.3",
      "@emnapi/runtime": "^1.11.3",
      "sharp": "^0.35.3",
      "yaml": ">=2.8.3"
    }
  },
  "scripts": {
    "build": "pnpm build:music",
    "build:all": "turbo run build",
    "build:music": "turbo run build --filter=music",
    "build:embed": "pnpm --filter music build:embed",
    "build:quiz": "turbo run build --filter=quiz",
    "build:stories": "turbo run build --filter=stories",
    "build:reviews": "turbo run build --filter=reviews",
    "generate:webp-assets": "node apps/music/scripts/generate-webp-assets.mjs",
    "dev": "turbo run dev",
    "dev:music": "cd apps/music && pnpm dev",
    "dev:music:background": "cd apps/music && pnpm dev:background",
    "dev:music:logs": "cd apps/music && pnpm dev:logs",
    "dev:music:status": "cd apps/music && pnpm dev:status",
    "dev:music:stop": "cd apps/music && pnpm dev:stop",
    "dev:quiz": "cd apps/quiz && pnpm dev",
    "dev:stories": "cd apps/stories && pnpm dev",
    "dev:reviews": "cd apps/reviews && pnpm dev",
    "preview": "turbo run preview --filter=music",
    "preview:quiz": "turbo run preview --filter=quiz",
    "preview:stories": "turbo run preview --filter=stories",
    "preview:reviews": "turbo run preview --filter=reviews",
    "test": "turbo run test",
    "test:browser:all": "pnpm --filter music test:browser && pnpm --filter quiz test:browser && pnpm --filter stories test:browser && pnpm --filter reviews test:browser",
    "test:browser:all:built": "pnpm --filter music exec playwright test && pnpm --filter quiz exec playwright test && pnpm --filter stories exec playwright test && pnpm --filter reviews exec playwright test",
    "check": "turbo run check",
    "lint": "turbo run lint --filter=music",
    "lint:all": "turbo run lint",
    "lint:check": "turbo run lint:check --filter=music",
    "lint:check:all": "turbo run lint:check",
    "lint:check:quiz": "turbo run lint:check --filter=quiz",
    "lint:check:stories": "turbo run lint:check --filter=stories",
    "lint:check:reviews": "turbo run lint:check --filter=reviews",
    "format": "turbo run format --filter=music",
    "format:all": "turbo run format",
    "format:check": "turbo run format:check --filter=music",
    "format:check:all": "turbo run format:check",
    "format:check:quiz": "turbo run format:check --filter=quiz",
    "format:check:stories": "turbo run format:check --filter=stories",
    "format:check:reviews": "turbo run format:check --filter=reviews",
    "indexnow:submit": "pnpm --filter music indexnow:submit",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@double-great/stylelint-a11y": "^3.5.4",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
